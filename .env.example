# 이 파일을 .env.local로 복사해서 값을 채워 주세요. (.env.local은 git에 올라가지 않아요)

# ── AI 코치 · AI 문제 생성 (Step 5) ──────────────────────────
# 없으면 AI 기능이 꺼지고 화면에 안내가 나와요.
ANTHROPIC_API_KEY=
# 모델 ID (기본값 claude-opus-5)
AI_COACH_MODEL=claude-opus-5
AI_GENERATOR_MODEL=claude-opus-5
# 개발용 모의 AI: 1이면 API 키 없이 코치·생성 흐름을 흉내 내요 (프로덕션에서는 무시)
AI_MOCK=
