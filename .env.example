# 이 파일을 .env.local로 복사해서 값을 채워 주세요. (.env.local은 git에 올라가지 않아요)

# ── AI 코치 · AI 문제 생성 (Step 5) ──────────────────────────
# 없으면 AI 기능이 꺼지고 화면에 안내가 나와요.
ANTHROPIC_API_KEY=
# 모델 ID (기본값 claude-opus-5)
AI_COACH_MODEL=claude-opus-5
AI_GENERATOR_MODEL=claude-opus-5
# 개발용 모의 AI: 1이면 API 키 없이 코치·생성 흐름을 흉내 내요 (프로덕션에서는 무시)
AI_MOCK=

# ── 로그인 · 진도 저장 (Step 6, Supabase) ──────────────────────
# 없으면 게스트 모드(이 브라우저에만 저장)로만 동작해요.
NEXT_PUBLIC_SUPABASE_URL=
# 공개 키 (publishable key, 예전 이름 anon key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용 비밀 키 (service role / secret key). 진도 기록 RPC와 AI 생성 문제 저장에 써요. 절대 공개하지 마세요.
SUPABASE_SERVICE_ROLE_KEY=
# 로그인 화면에 보여 줄 소셜 로그인 (Supabase 대시보드에서 켠 것만): google,github,kakao
NEXT_PUBLIC_AUTH_PROVIDERS=
