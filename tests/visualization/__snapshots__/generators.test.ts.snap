exports[`프리셋 two-pointers-unique-stamps-ex1 > 스텝 흐름 스냅샷 1`] = `
"#0 init L1 첫 칸은 그대로 두고, 읽는 손가락으로 훑으며 새 값만 앞쪽에 써요.
    a (앞쪽 초록 = 중복 없는 결과)=|1✓ 1 2 3 3 3 5| 쓰기@1 | vars{"결과 길이 w":1,"결과":"1"}
#1 skip L5 같은 값(1) → 건너뛰기
    a (앞쪽 초록 = 중복 없는 결과)=|1✓ 1✗ 2 3 3 3 5| 쓰기·읽기@1 | vars{"결과 길이 w":1,"결과":"1"}
#2 pick L4 새 값 2 → 1번 칸에 쓰기
    a (앞쪽 초록 = 중복 없는 결과)=|1✓ 2*✓ 2 3 3 3 5| 쓰기·읽기@2 | vars{"결과 길이 w":2,"결과":"1, 2"}
#3 pick L4 새 값 3 → 2번 칸에 쓰기
    a (앞쪽 초록 = 중복 없는 결과)=|1✓ 2✓ 3*✓ 3 3 3 5| 쓰기·읽기@3 | vars{"결과 길이 w":3,"결과":"1, 2, 3"}
#4 skip L5 같은 값(3) → 건너뛰기
    a (앞쪽 초록 = 중복 없는 결과)=|1✓ 2✓ 3✓ 3 3✗ 3 5| 쓰기@3,읽기@4 | vars{"결과 길이 w":3,"결과":"1, 2, 3"}
#5 skip L5 같은 값(3) → 건너뛰기
    a (앞쪽 초록 = 중복 없는 결과)=|1✓ 2✓ 3✓ 3 3 3✗ 5| 쓰기@3,읽기@5 | vars{"결과 길이 w":3,"결과":"1, 2, 3"}
#6 pick L4 새 값 5 → 3번 칸에 쓰기
    a (앞쪽 초록 = 중복 없는 결과)=|1✓ 2✓ 3✓ 5*✓ 3 3 5| 쓰기@4,읽기@6 | vars{"결과 길이 w":4,"결과":"1, 2, 3, 5"}
#7 done L6 중복 없는 결과: [1, 2, 3, 5] — 새 배열 없이 한 번 훑어서 끝냈어요.
    a (앞쪽 초록 = 중복 없는 결과)=|1✓ 2✓ 3✓ 5✓ 3 3 5| 쓰기@4 | vars{"결과 길이 w":4,"결과":"1, 2, 3, 5"}"
`;

exports[`프리셋 vault-bad > 스텝 흐름 스냅샷 1`] = `
"#0 init L1 "([)]"의 괄호를 왼쪽부터 한 글자씩 봐요. 여는 괄호는 스택에 쌓아 둬요.
    s=<( [ ) ]> cur=- done=0 | stack=[] | vars{"i":0}
#1 push L3 '('는 여는 괄호 → push. 짝을 만날 때까지 기다려요.
    s=<(* [ ) ]> cur=0 done=0 | stack=[(*] | vars{"i":0,"ch":"("}
#2 push L3 '['는 여는 괄호 → push. 짝을 만날 때까지 기다려요.
    s=<( [* ) ]> cur=1 done=1 | stack=[(,[*] | vars{"i":1,"ch":"["}
#3 compare L5 ')'의 짝은 '('인데 맨 위는 '[' → 짝이 안 맞아요!
    s=<( [ )*✗ ]> cur=2 done=2 | stack=[(,[✗] | vars{"i":2,"ch":")","결과":false}
#4 done L5 "([)]" → 올바르지 않은 괄호예요 (False)
    s=<( [ )✗ ]> cur=- done=2 | stack=[(,[] | vars{"결과":false}"
`;

exports[`프리셋 vault-ok > 스텝 흐름 스냅샷 1`] = `
"#0 init L1 "([]){}"의 괄호를 왼쪽부터 한 글자씩 봐요. 여는 괄호는 스택에 쌓아 둬요.
    s=<( [ ] ) { }> cur=- done=0 | stack=[] | vars{"i":0}
#1 push L3 '('는 여는 괄호 → push. 짝을 만날 때까지 기다려요.
    s=<(* [ ] ) { }> cur=0 done=0 | stack=[(*] | vars{"i":0,"ch":"("}
#2 push L3 '['는 여는 괄호 → push. 짝을 만날 때까지 기다려요.
    s=<( [* ] ) { }> cur=1 done=1 | stack=[(,[*] | vars{"i":1,"ch":"["}
#3 compare L5 ']'와 맨 위 '['의 짝이 맞아요
    s=<( [ ]* ) { }> cur=2 done=2 | stack=[(,[!] | vars{"i":2,"ch":"]"}
#4 pop L6 짝을 찾은 '['를 스택에서 꺼내요
    s=<( [ ]* ) { }> cur=2 done=3 | stack=[(] | vars{"i":2,"ch":"]"}
#5 compare L5 ')'와 맨 위 '('의 짝이 맞아요
    s=<( [ ] )* { }> cur=3 done=3 | stack=[(!] | vars{"i":3,"ch":")"}
#6 pop L6 짝을 찾은 '('를 스택에서 꺼내요
    s=<( [ ] )* { }> cur=3 done=4 | stack=[] | vars{"i":3,"ch":")"}
#7 push L3 '{'는 여는 괄호 → push. 짝을 만날 때까지 기다려요.
    s=<( [ ] ) {* }> cur=4 done=4 | stack=[{*] | vars{"i":4,"ch":"{"}
#8 compare L5 '}'와 맨 위 '{'의 짝이 맞아요
    s=<( [ ] ) { }*> cur=5 done=5 | stack=[{!] | vars{"i":5,"ch":"}"}
#9 pop L6 짝을 찾은 '{'를 스택에서 꺼내요
    s=<( [ ] ) { }*> cur=5 done=6 | stack=[] | vars{"i":5,"ch":"}"}
#10 done L7 문자열 끝! 스택이 비었으니 모든 괄호의 짝이 맞아요 → True
    s=<( [ ] ) { }> cur=- done=6 | stack=[] | vars{"결과":true}"
`;
