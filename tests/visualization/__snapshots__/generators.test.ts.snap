exports[`프리셋 maze-ex1 > 스텝 흐름 스냅샷 1`] = `
"#0 init L1 출발점 (0, 0)의 거리는 0. 큐에 넣고 출발해요.
    queue=[(0, 0)] | grid zone=100/000/000 cur=0,0 dist=0,-,-/-,-,-/-,-,- | vars{"큐 길이":1}
#1 dequeue L3 큐 맨 앞의 (0, 0) 칸을 꺼내요 (거리 0)
    queue=[] | grid zone=100/000/000 cur=0,0 dist=0,-,-/-,-,-/-,-,- | vars{"큐 길이":0}
#2 discover L8 아래 (1, 0) 칸을 처음 발견! 거리 1, 큐 뒤에 넣어요
    queue=[(1, 0)] | grid zone=100/100/000 cur=0,0 chk=1,0:go dist=0,-,-/1,-,-/-,-,- | vars{"큐 길이":1}
#3 discover L8 오른쪽 (0, 1) 칸을 처음 발견! 거리 1, 큐 뒤에 넣어요
    queue=[(1, 0),(0, 1)] | grid zone=110/100/000 cur=0,0 chk=0,1:go dist=0,1,-/1,-,-/-,-,- | vars{"큐 길이":2}
#4 dequeue L3 큐 맨 앞의 (1, 0) 칸을 꺼내요 (거리 1)
    queue=[(0, 1)] | grid zone=110/100/000 cur=1,0 dist=0,1,-/1,-,-/-,-,- | vars{"큐 길이":1}
#5 check L6 위 (0, 0) 칸은 이미 발견했어요 → 건너뛰기
    queue=[(0, 1)] | grid zone=110/100/000 cur=1,0 chk=0,0:visited dist=0,1,-/1,-,-/-,-,- | vars{"큐 길이":1}
#6 check L6 아래 (2, 0) 칸은 벽 → 건너뛰기
    queue=[(0, 1)] | grid zone=110/100/000 cur=1,0 chk=2,0:blocked dist=0,1,-/1,-,-/-,-,- | vars{"큐 길이":1}
#7 discover L8 오른쪽 (1, 1) 칸을 처음 발견! 거리 2, 큐 뒤에 넣어요
    queue=[(0, 1),(1, 1)] | grid zone=110/110/000 cur=1,0 chk=1,1:go dist=0,1,-/1,2,-/-,-,- | vars{"큐 길이":2}
#8 dequeue L3 큐 맨 앞의 (0, 1) 칸을 꺼내요 (거리 1)
    queue=[(1, 1)] | grid zone=110/110/000 cur=0,1 dist=0,1,-/1,2,-/-,-,- | vars{"큐 길이":1}
#9 check L6 아래 (1, 1) 칸은 이미 발견했어요 → 건너뛰기
    queue=[(1, 1)] | grid zone=110/110/000 cur=0,1 chk=1,1:visited dist=0,1,-/1,2,-/-,-,- | vars{"큐 길이":1}
#10 check L6 왼쪽 (0, 0) 칸은 이미 발견했어요 → 건너뛰기
    queue=[(1, 1)] | grid zone=110/110/000 cur=0,1 chk=0,0:visited dist=0,1,-/1,2,-/-,-,- | vars{"큐 길이":1}
#11 check L6 오른쪽 (0, 2) 칸은 벽 → 건너뛰기
    queue=[(1, 1)] | grid zone=110/110/000 cur=0,1 chk=0,2:blocked dist=0,1,-/1,2,-/-,-,- | vars{"큐 길이":1}
#12 dequeue L3 큐 맨 앞의 (1, 1) 칸을 꺼내요 (거리 2)
    queue=[] | grid zone=110/110/000 cur=1,1 dist=0,1,-/1,2,-/-,-,- | vars{"큐 길이":0}
#13 check L6 위 (0, 1) 칸은 이미 발견했어요 → 건너뛰기
    queue=[] | grid zone=110/110/000 cur=1,1 chk=0,1:visited dist=0,1,-/1,2,-/-,-,- | vars{"큐 길이":0}
#14 discover L8 아래 (2, 1) 칸을 처음 발견! 거리 3, 큐 뒤에 넣어요
    queue=[(2, 1)] | grid zone=110/110/010 cur=1,1 chk=2,1:go dist=0,1,-/1,2,-/-,3,- | vars{"큐 길이":1}
#15 check L6 왼쪽 (1, 0) 칸은 이미 발견했어요 → 건너뛰기
    queue=[(2, 1)] | grid zone=110/110/010 cur=1,1 chk=1,0:visited dist=0,1,-/1,2,-/-,3,- | vars{"큐 길이":1}
#16 check L6 오른쪽 (1, 2) 칸은 벽 → 건너뛰기
    queue=[(2, 1)] | grid zone=110/110/010 cur=1,1 chk=1,2:blocked dist=0,1,-/1,2,-/-,3,- | vars{"큐 길이":1}
#17 dequeue L3 큐 맨 앞의 (2, 1) 칸을 꺼내요 (거리 3)
    queue=[] | grid zone=110/110/010 cur=2,1 dist=0,1,-/1,2,-/-,3,- | vars{"큐 길이":0}
#18 check L6 위 (1, 1) 칸은 이미 발견했어요 → 건너뛰기
    queue=[] | grid zone=110/110/010 cur=2,1 chk=1,1:visited dist=0,1,-/1,2,-/-,3,- | vars{"큐 길이":0}
#19 check L6 왼쪽 (2, 0) 칸은 벽 → 건너뛰기
    queue=[] | grid zone=110/110/010 cur=2,1 chk=2,0:blocked dist=0,1,-/1,2,-/-,3,- | vars{"큐 길이":0}
#20 discover L8 오른쪽 (2, 2) 칸을 처음 발견! 거리 4, 큐 뒤에 넣어요
    queue=[(2, 2)] | grid zone=110/110/011 cur=2,1 chk=2,2:go dist=0,1,-/1,2,-/-,3,4 | vars{"큐 길이":1}
#21 dequeue L3 큐 맨 앞의 (2, 2) 칸을 꺼내요 (거리 4)
    queue=[] | grid zone=110/110/011 cur=2,2 dist=0,1,-/1,2,-/-,3,4 | vars{"큐 길이":0}
#22 done L4 도착! 최단 거리는 4칸이에요. 가까운 칸부터 퍼졌으니 처음 닿은 순간이 가장 짧은 길이에요.
    queue=[] | grid zone=210/220/022 cur=2,2 dist=0,1,-/1,2,-/-,3,4 | vars{"큐 길이":0}"
`;

exports[`프리셋 maze-ex2 > 스텝 흐름 스냅샷 1`] = `
