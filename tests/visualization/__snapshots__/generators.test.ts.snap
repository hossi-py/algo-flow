#13 check L4 길이 19씩 자르면 80÷19=4, 43÷19=2, 57÷19=3, 39÷19=2 → 11도막 (11개 이상, 가능!)
    확인한 길이=<40:X✗ 20:X✗ 10:O✓ 15:O✓ 17:O✓ 18:O✓ 19:O✓> cur=6 done=0 | cables (줄 길이)=|80* 43* 57* 39*| | vars{"k":11,"lo":19,"hi":19,"mid":19,"answer":18,"pieces":11}
#14 narrow L5 길이 19 가능! answer = 19 적어 두고, 더 긴 길이를 찾아봐요 (lo = 20)
    확인한 길이=<40:X✗ 20:X✗ 10:O✓ 15:O✓ 17:O✓ 18:O✓ 19:O✓> cur=6 done=0 | cables (줄 길이)=|80 43 57 39| | vars{"k":11,"lo":20,"hi":19,"answer":19}
#15 done L7 가장 긴 길이: 19. 길이를 하나씩 다 해 보지 않고 7번만 확인했어요.
    확인한 길이=<40:X✗ 20:X✗ 10:O✓ 15:O✓ 17:O✓ 18:O✓ 19:O✓> cur=6 done=0 | cables (줄 길이)=|80 43 57 39| | vars{"k":11,"lo":20,"hi":19,"answer":19}"
`;

exports[`프리셋 binary-search-cutoff-count-ex1 > 스텝 흐름 스냅샷 1`] = `
"#0 init L1 70 이상인 첫 위치를 찾아요. 없으면 끝(5)이 답이에요.
    a (정렬됨)=|60 70 70 85 95| range=0..4 lo@0,hi@4 | vars{"target":70,"lo":0,"hi":"5 (끝)"}
#1 compare L3 mid = 2, a[2] = 70 → 70 이상이에요
    a (정렬됨)=|60 70 70! 85 95| range=0..4 lo@0,mid@2,hi@4 | vars{"target":70,"lo":0,"hi":"5 (끝)","mid":2}
#2 narrow L4 2번도 답일 수 있으니 남기고, 그 뒤는 버려요 (hi = 2)
    a (정렬됨)=|60 70 70 85 95| range=0..1 lo@0,hi@1 | vars{"target":70,"lo":0,"hi":2}
#3 compare L3 mid = 1, a[1] = 70 → 70 이상이에요
    a (정렬됨)=|60 70! 70 85 95| range=0..1 lo@0,mid·hi@1 | vars{"target":70,"lo":0,"hi":2,"mid":1}
#4 narrow L4 1번도 답일 수 있으니 남기고, 그 뒤는 버려요 (hi = 1)
    a (정렬됨)=|60 70 70 85 95| range=0..0 lo·hi@0 | vars{"target":70,"lo":0,"hi":1}
#5 compare L3 mid = 0, a[0] = 60 → 70보다 작아요
    a (정렬됨)=|60✗ 70 70 85 95| range=0..0 lo·mid·hi@0 | vars{"target":70,"lo":0,"hi":1,"mid":0}
#6 narrow L5 0번까지는 모두 작아요. 버려요 (lo = 1)
    a (정렬됨)=|60 70 70 85 95| range=1..1 lo·hi@1 | vars{"target":70,"lo":1,"hi":1}
#7 done L6 lo = hi = 1. 70 이상인 첫 위치는 1번(70)이에요. 그 앞에는 70보다 작은 수가 1개 있어요.
    a (정렬됨)=|60 70! 70 85 95| | vars{"target":70,"답":1}"
`;

exports[`프리셋 binary-search-page-finder-ex1 > 스텝 흐름 스냅샷 1`] = `
"#0 init L1 정렬된 7칸에서 target = 21 찾기. 처음엔 전체가 후보예요.
    a (정렬됨)=|3 8 15 21 27 34 42| range=0..6 lo@0,hi@6 | vars{"target":21,"lo":0,"hi":6,"확인 횟수":0}
#1 compare L3 가운데 mid = (0 + 6) // 2 = 3, a[3] = 21
    a (정렬됨)=|3 8 15 21* 27 34 42| range=0..6 lo@0,mid@3,hi@6 | vars{"target":21,"lo":0,"hi":6,"mid":3,"확인 횟수":1}
#2 found L4 찾았어요! a[3] = 21. 1번만 확인했어요.
    a (정렬됨)=|3 8 15 21! 27 34 42| range=0..6 lo@0,mid@3,hi@6 | vars{"target":21,"lo":0,"hi":6,"mid":3,"확인 횟수":1}
#3 done L- 7칸을 하나씩 보면 최대 7번이지만, 반씩 버리면 1번이면 돼요.
    a (정렬됨)=|3 8 15 21! 27 34 42| | vars{"target":21,"lo":0,"hi":6,"mid":3,"확인 횟수":1}"
`;

exports[`프리셋 bracket-partner-tricky > 스텝 흐름 스냅샷 1`] = `
"#0 init L1 "(()())"의 괄호를 왼쪽부터 한 글자씩 봐요. 여는 괄호는 스택에 쌓아 둬요.
    s=<( ( ) ( ) )> cur=- done=0 | stack=[] | vars{"i":0}
#1 push L3 '('는 여는 괄호 → push. 짝을 만날 때까지 기다려요.
    s=<(* ( ) ( ) )> cur=0 done=0 | stack=[(*] | vars{"i":0,"ch":"("}
#2 push L3 '('는 여는 괄호 → push. 짝을 만날 때까지 기다려요.
    s=<( (* ) ( ) )> cur=1 done=1 | stack=[(,(*] | vars{"i":1,"ch":"("}
#3 compare L5 ')'와 맨 위 '('의 짝이 맞아요
    s=<( ( )* ( ) )> cur=2 done=2 | stack=[(,(!] | vars{"i":2,"ch":")"}
#4 pop L6 짝을 찾은 '('를 스택에서 꺼내요
    s=<( ( )* ( ) )> cur=2 done=3 | stack=[(] | vars{"i":2,"ch":")"}
#5 push L3 '('는 여는 괄호 → push. 짝을 만날 때까지 기다려요.
    s=<( ( ) (* ) )> cur=3 done=3 | stack=[(,(*] | vars{"i":3,"ch":"("}
#6 compare L5 ')'와 맨 위 '('의 짝이 맞아요
    s=<( ( ) ( )* )> cur=4 done=4 | stack=[(,(!] | vars{"i":4,"ch":")"}
#7 pop L6 짝을 찾은 '('를 스택에서 꺼내요
    s=<( ( ) ( )* )> cur=4 done=5 | stack=[(] | vars{"i":4,"ch":")"}
#8 compare L5 ')'와 맨 위 '('의 짝이 맞아요
    s=<( ( ) ( ) )*> cur=5 done=5 | stack=[(!] | vars{"i":5,"ch":")"}
#9 pop L6 짝을 찾은 '('를 스택에서 꺼내요
    s=<( ( ) ( ) )*> cur=5 done=6 | stack=[] | vars{"i":5,"ch":")"}
#10 done L7 문자열 끝! 스택이 비었으니 모든 괄호의 짝이 맞아요 → True
    s=<( ( ) ( ) )> cur=- done=6 | stack=[] | vars{"결과":true}"
`;

