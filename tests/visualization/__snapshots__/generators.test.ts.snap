    a=|2 3 1! 2! 4! 3| range=2..4 L@2,R@4 | vars{"S":7,"창의 합":7,"가장짧은길이":3}
#11 move-left L6 더 짧게 만들어 봐요 → 왼쪽의 1 빼기 → 창의 합 6
    a=|2 3 1 2 4 3| range=3..4 L@3,R@4 | vars{"S":7,"창의 합":6,"가장짧은길이":3}
#12 move-right L3 오른쪽을 늘려 3 넣기 → 창의 합 9
    a=|2 3 1 2 4 3*| range=3..5 L@3,R@5 | vars{"S":7,"창의 합":9,"가장짧은길이":3}
#13 record L5 합 9 ≥ 7 → 길이 3 (지금까지 가장 짧아요)
    a=|2 3 1 2! 4! 3!| range=3..5 L@3,R@5 | vars{"S":7,"창의 합":9,"가장짧은길이":3}
#14 move-left L6 더 짧게 만들어 봐요 → 왼쪽의 2 빼기 → 창의 합 7
    a=|2 3 1 2 4 3| range=4..5 L@4,R@5 | vars{"S":7,"창의 합":7,"가장짧은길이":3}
#15 record L5 합 7 ≥ 7 → 길이 2 (지금까지 가장 짧아요)
    a=|2 3 1 2 4! 3!| range=4..5 L@4,R@5 | vars{"S":7,"창의 합":7,"가장짧은길이":2}
#16 move-left L6 더 짧게 만들어 봐요 → 왼쪽의 4 빼기 → 창의 합 3
    a=|2 3 1 2 4 3| range=5..5 L·R@5 | vars{"S":7,"창의 합":3,"가장짧은길이":2}
#17 done L7 가장 짧은 구간: [4..5], 길이 2. 칸마다 한 번 넣고 한 번 뺐을 뿐이에요.
    a=|2 3 1 2 4! 3!| | vars{"S":7,"가장짧은길이":2}"
`;

exports[`프리셋 two-pointers-sorted-pair-ex2 > 스텝 흐름 스냅샷 1`] = `
"#0 init L1 양 끝에 손가락을 하나씩 둬요. 합 = 20인 두 수를 찾아요.
    a (정렬됨)=|1 2 4 6 9 11 14 17| range=0..7 L@0,R@7 | vars{"target":20,"L":0,"R":7}
#1 compare L3 1 + 17 = 18
    a (정렬됨)=|1* 2 4 6 9 11 14 17*| range=0..7 L@0,R@7 | vars{"target":20,"L":0,"R":7,"a[L] + a[R]":18}
#2 move-left L5 합이 작아요 → 왼쪽 손가락을 오른쪽으로 (더 큰 수로)
    a (정렬됨)=|1 2 4 6 9 11 14 17| range=1..7 L@1,R@7 | vars{"target":20,"L":1,"R":7}
#3 compare L3 2 + 17 = 19
    a (정렬됨)=|1 2* 4 6 9 11 14 17*| range=1..7 L@1,R@7 | vars{"target":20,"L":1,"R":7,"a[L] + a[R]":19}
#4 move-left L5 합이 작아요 → 왼쪽 손가락을 오른쪽으로 (더 큰 수로)
    a (정렬됨)=|1 2 4 6 9 11 14 17| range=2..7 L@2,R@7 | vars{"target":20,"L":2,"R":7}
#5 compare L3 4 + 17 = 21
    a (정렬됨)=|1 2 4* 6 9 11 14 17*| range=2..7 L@2,R@7 | vars{"target":20,"L":2,"R":7,"a[L] + a[R]":21}
#6 move-right L6 합이 커요 → 오른쪽 손가락을 왼쪽으로 (더 작은 수로)
    a (정렬됨)=|1 2 4 6 9 11 14 17| range=2..6 L@2,R@6 | vars{"target":20,"L":2,"R":6}
#7 compare L3 4 + 14 = 18
    a (정렬됨)=|1 2 4* 6 9 11 14* 17| range=2..6 L@2,R@6 | vars{"target":20,"L":2,"R":6,"a[L] + a[R]":18}
#8 move-left L5 합이 작아요 → 왼쪽 손가락을 오른쪽으로 (더 큰 수로)
    a (정렬됨)=|1 2 4 6 9 11 14 17| range=3..6 L@3,R@6 | vars{"target":20,"L":3,"R":6}
#9 compare L3 6 + 14 = 20
    a (정렬됨)=|1 2 4 6* 9 11 14* 17| range=3..6 L@3,R@6 | vars{"target":20,"L":3,"R":6,"a[L] + a[R]":20}
#10 found L4 합이 딱 맞아요! 위치 [3, 6]
    a (정렬됨)=|1 2 4 6! 9 11 14! 17| range=3..6 L@3,R@6 | vars{"target":20,"L":3,"R":6,"a[L] + a[R]":20}
#11 done L- 모든 쌍을 비교하지 않고 5번만 비교했어요.
    a (정렬됨)=|1 2 4 6 9 11 14 17| range=3..6 L@3,R@6 | vars{"target":20,"L":3,"R":6,"a[L] + a[R]":20}"
