    queue=[(4, 2),(1, 3)] | grid zone=11000/11010/01110/00100/00100 cur=2,3 chk=1,3:go dist=0,1,-,-,-/1,2,-,6,-/-,3,4,5,-/-,-,5,-,-/-,-,6,-,- | vars{"큐 길이":2}
#34 check L6 아래 (3, 3) 칸은 벽 → 건너뛰기
    queue=[(4, 2),(1, 3)] | grid zone=11000/11010/01110/00100/00100 cur=2,3 chk=3,3:blocked dist=0,1,-,-,-/1,2,-,6,-/-,3,4,5,-/-,-,5,-,-/-,-,6,-,- | vars{"큐 길이":2}
#35 check L6 왼쪽 (2, 2) 칸은 이미 발견했어요 → 건너뛰기
    queue=[(4, 2),(1, 3)] | grid zone=11000/11010/01110/00100/00100 cur=2,3 chk=2,2:visited dist=0,1,-,-,-/1,2,-,6,-/-,3,4,5,-/-,-,5,-,-/-,-,6,-,- | vars{"큐 길이":2}
#36 check L6 오른쪽 (2, 4) 칸은 벽 → 건너뛰기
    queue=[(4, 2),(1, 3)] | grid zone=11000/11010/01110/00100/00100 cur=2,3 chk=2,4:blocked dist=0,1,-,-,-/1,2,-,6,-/-,3,4,5,-/-,-,5,-,-/-,-,6,-,- | vars{"큐 길이":2}
#37 dequeue L3 큐 맨 앞의 (4, 2) 칸을 꺼내요 (거리 6)
    queue=[(1, 3)] | grid zone=11000/11010/01110/00100/00100 cur=4,2 dist=0,1,-,-,-/1,2,-,6,-/-,3,4,5,-/-,-,5,-,-/-,-,6,-,- | vars{"큐 길이":1}
#38 check L6 위 (3, 2) 칸은 이미 발견했어요 → 건너뛰기
    queue=[(1, 3)] | grid zone=11000/11010/01110/00100/00100 cur=4,2 chk=3,2:visited dist=0,1,-,-,-/1,2,-,6,-/-,3,4,5,-/-,-,5,-,-/-,-,6,-,- | vars{"큐 길이":1}
#39 discover L8 왼쪽 (4, 1) 칸을 처음 발견! 거리 7, 큐 뒤에 넣어요
    queue=[(1, 3),(4, 1)] | grid zone=11000/11010/01110/00100/01100 cur=4,2 chk=4,1:go dist=0,1,-,-,-/1,2,-,6,-/-,3,4,5,-/-,-,5,-,-/-,7,6,-,- | vars{"큐 길이":2}
#40 discover L8 오른쪽 (4, 3) 칸을 처음 발견! 거리 7, 큐 뒤에 넣어요
    queue=[(1, 3),(4, 1),(4, 3)] | grid zone=11000/11010/01110/00100/01110 cur=4,2 chk=4,3:go dist=0,1,-,-,-/1,2,-,6,-/-,3,4,5,-/-,-,5,-,-/-,7,6,7,- | vars{"큐 길이":3}
#41 dequeue L3 큐 맨 앞의 (1, 3) 칸을 꺼내요 (거리 6)
    queue=[(4, 1),(4, 3)] | grid zone=11000/11010/01110/00100/01110 cur=1,3 dist=0,1,-,-,-/1,2,-,6,-/-,3,4,5,-/-,-,5,-,-/-,7,6,7,- | vars{"큐 길이":2}
#42 discover L8 위 (0, 3) 칸을 처음 발견! 거리 7, 큐 뒤에 넣어요
    queue=[(4, 1),(4, 3),(0, 3)] | grid zone=11010/11010/01110/00100/01110 cur=1,3 chk=0,3:go dist=0,1,-,7,-/1,2,-,6,-/-,3,4,5,-/-,-,5,-,-/-,7,6,7,- | vars{"큐 길이":3}
#43 check L6 아래 (2, 3) 칸은 이미 발견했어요 → 건너뛰기
    queue=[(4, 1),(4, 3),(0, 3)] | grid zone=11010/11010/01110/00100/01110 cur=1,3 chk=2,3:visited dist=0,1,-,7,-/1,2,-,6,-/-,3,4,5,-/-,-,5,-,-/-,7,6,7,- | vars{"큐 길이":3}
#44 check L6 왼쪽 (1, 2) 칸은 벽 → 건너뛰기
    queue=[(4, 1),(4, 3),(0, 3)] | grid zone=11010/11010/01110/00100/01110 cur=1,3 chk=1,2:blocked dist=0,1,-,7,-/1,2,-,6,-/-,3,4,5,-/-,-,5,-,-/-,7,6,7,- | vars{"큐 길이":3}
#45 check L6 오른쪽 (1, 4) 칸은 벽 → 건너뛰기
    queue=[(4, 1),(4, 3),(0, 3)] | grid zone=11010/11010/01110/00100/01110 cur=1,3 chk=1,4:blocked dist=0,1,-,7,-/1,2,-,6,-/-,3,4,5,-/-,-,5,-,-/-,7,6,7,- | vars{"큐 길이":3}
#46 dequeue L3 큐 맨 앞의 (4, 1) 칸을 꺼내요 (거리 7)
    queue=[(4, 3),(0, 3)] | grid zone=11010/11010/01110/00100/01110 cur=4,1 dist=0,1,-,7,-/1,2,-,6,-/-,3,4,5,-/-,-,5,-,-/-,7,6,7,- | vars{"큐 길이":2}
#47 check L6 위 (3, 1) 칸은 벽 → 건너뛰기
    queue=[(4, 3),(0, 3)] | grid zone=11010/11010/01110/00100/01110 cur=4,1 chk=3,1:blocked dist=0,1,-,7,-/1,2,-,6,-/-,3,4,5,-/-,-,5,-,-/-,7,6,7,- | vars{"큐 길이":2}
#48 discover L8 왼쪽 (4, 0) 칸을 처음 발견! 거리 8, 큐 뒤에 넣어요
    queue=[(4, 3),(0, 3),(4, 0)] | grid zone=11010/11010/01110/00100/11110 cur=4,1 chk=4,0:go dist=0,1,-,7,-/1,2,-,6,-/-,3,4,5,-/-,-,5,-,-/8,7,6,7,- | vars{"큐 길이":3}
#49 check L6 오른쪽 (4, 2) 칸은 이미 발견했어요 → 건너뛰기
    queue=[(4, 3),(0, 3),(4, 0)] | grid zone=11010/11010/01110/00100/11110 cur=4,1 chk=4,2:visited dist=0,1,-,7,-/1,2,-,6,-/-,3,4,5,-/-,-,5,-,-/8,7,6,7,- | vars{"큐 길이":3}
#50 dequeue L3 큐 맨 앞의 (4, 3) 칸을 꺼내요 (거리 7)
    queue=[(0, 3),(4, 0)] | grid zone=11010/11010/01110/00100/11110 cur=4,3 dist=0,1,-,7,-/1,2,-,6,-/-,3,4,5,-/-,-,5,-,-/8,7,6,7,- | vars{"큐 길이":2}
#51 done L4 도착! 최단 거리는 7칸이에요. 가까운 칸부터 퍼졌으니 처음 닿은 순간이 가장 짧은 길이에요.
    queue=[(0, 3),(4, 0)] | grid zone=21010/22010/02210/00200/11220 cur=4,3 dist=0,1,-,7,-/1,2,-,6,-/-,3,4,5,-/-,-,5,-,-/8,7,6,7,- | vars{"큐 길이":2}"
`;

exports[`프리셋 grid-dfs-mini > 스텝 흐름 스냅샷 1`] = `
"#0 zone-start L3 (0, 0) 칸에서 방문 안 한 꽃 발견! 1번 구역 탐색 시작
    grid zone=000/000/000 cur=0,0 | calls[] | vars{"sizes":[]}
#1 visit L6 (0, 0) 칸에 방문 표시, size = 1로 시작해요.
    grid zone=100/000/000 cur=0,0 | calls[dfs(0, 0)*{"size":1}] | vars{"sizes":[]}
#2 check L8 아래 (1, 0) 칸은 빈 땅 → 건너뛰기
    grid zone=100/000/000 cur=0,0 chk=1,0:blocked | calls[dfs(0, 0)*{"size":1}] | vars{"sizes":[]}
#3 check L9 오른쪽 (0, 1) 칸은 방문하지 않은 꽃! → dfs(0, 1) 호출
    grid zone=100/000/000 cur=0,0 chk=0,1:go | calls[dfs(0, 0)*{"size":1}] | vars{"sizes":[]}
#4 visit L6 (0, 1) 칸에 방문 표시, size = 1로 시작해요.
    grid zone=110/000/000 cur=0,1 | calls[dfs(0, 0){"size":1} > dfs(0, 1)*{"size":1}] | vars{"sizes":[]}
#5 check L9 아래 (1, 1) 칸은 방문하지 않은 꽃! → dfs(1, 1) 호출
    grid zone=110/000/000 cur=0,1 chk=1,1:go | calls[dfs(0, 0){"size":1} > dfs(0, 1)*{"size":1}] | vars{"sizes":[]}
#6 visit L6 (1, 1) 칸에 방문 표시, size = 1로 시작해요.
    grid zone=110/010/000 cur=1,1 | calls[dfs(0, 0){"size":1} > dfs(0, 1){"size":1} > dfs(1, 1)*{"size":1}] | vars{"sizes":[]}
#7 check L8 위 (0, 1) 칸은 이미 방문 → 건너뛰기
    grid zone=110/010/000 cur=1,1 chk=0,1:visited | calls[dfs(0, 0){"size":1} > dfs(0, 1){"size":1} > dfs(1, 1)*{"size":1}] | vars{"sizes":[]}
#8 check L8 아래 (2, 1) 칸은 빈 땅 → 건너뛰기
    grid zone=110/010/000 cur=1,1 chk=2,1:blocked | calls[dfs(0, 0){"size":1} > dfs(0, 1){"size":1} > dfs(1, 1)*{"size":1}] | vars{"sizes":[]}
#9 check L8 왼쪽 (1, 0) 칸은 빈 땅 → 건너뛰기
    grid zone=110/010/000 cur=1,1 chk=1,0:blocked | calls[dfs(0, 0){"size":1} > dfs(0, 1){"size":1} > dfs(1, 1)*{"size":1}] | vars{"sizes":[]}
#10 check L8 오른쪽 (1, 2) 칸은 빈 땅 → 건너뛰기
    grid zone=110/010/000 cur=1,1 chk=1,2:blocked | calls[dfs(0, 0){"size":1} > dfs(0, 1){"size":1} > dfs(1, 1)*{"size":1}] | vars{"sizes":[]}
#11 return L10 더 갈 곳이 없어요. dfs(1, 1)의 결과는 1
    grid zone=110/010/000 cur=1,1 | calls[dfs(0, 0){"size":1} > dfs(0, 1){"size":1} > dfs(1, 1)*{"size":1}] | vars{"sizes":[]}
#12 return-to L9 dfs(1, 1)의 결과 1 → size = 2
    grid zone=110/010/000 cur=0,1 | calls[dfs(0, 0){"size":1} > dfs(0, 1)*{"size":2}] | vars{"sizes":[]}
#13 check L8 왼쪽 (0, 0) 칸은 이미 방문 → 건너뛰기
    grid zone=110/010/000 cur=0,1 chk=0,0:visited | calls[dfs(0, 0){"size":1} > dfs(0, 1)*{"size":2}] | vars{"sizes":[]}
#14 check L8 오른쪽 (0, 2) 칸은 빈 땅 → 건너뛰기
    grid zone=110/010/000 cur=0,1 chk=0,2:blocked | calls[dfs(0, 0){"size":1} > dfs(0, 1)*{"size":2}] | vars{"sizes":[]}
#15 return L10 더 갈 곳이 없어요. dfs(0, 1)의 결과는 2
    grid zone=110/010/000 cur=0,1 | calls[dfs(0, 0){"size":1} > dfs(0, 1)*{"size":2}] | vars{"sizes":[]}
#16 return-to L9 dfs(0, 1)의 결과 2 → size = 3
    grid zone=110/010/000 cur=0,0 | calls[dfs(0, 0)*{"size":3}] | vars{"sizes":[]}
#17 return L10 더 갈 곳이 없어요. dfs(0, 0)의 결과는 3
    grid zone=110/010/000 cur=0,0 | calls[dfs(0, 0)*{"size":3}] | vars{"sizes":[]}
#18 zone-complete L4 1번 구역 완성! 크기 3 → sizes = [3]
    grid zone=110/010/000 cur=0,0 | calls[] | vars{"sizes":[3]}
#19 scan L2 (0, 1) 칸은 이미 1번 구역 → 다음 칸으로
    grid zone=110/010/000 cur=0,1 | calls[] | vars{"sizes":[3]}
#20 scan L2 (0, 2) 칸은 빈 땅 → 다음 칸으로
    grid zone=110/010/000 cur=0,2 | calls[] | vars{"sizes":[3]}
#21 scan L2 (1, 0) 칸은 빈 땅 → 다음 칸으로
    grid zone=110/010/000 cur=1,0 | calls[] | vars{"sizes":[3]}
#22 scan L2 (1, 1) 칸은 이미 1번 구역 → 다음 칸으로
    grid zone=110/010/000 cur=1,1 | calls[] | vars{"sizes":[3]}
#23 scan L2 (1, 2) 칸은 빈 땅 → 다음 칸으로
    grid zone=110/010/000 cur=1,2 | calls[] | vars{"sizes":[3]}
#24 scan L2 (2, 0) 칸은 빈 땅 → 다음 칸으로
    grid zone=110/010/000 cur=2,0 | calls[] | vars{"sizes":[3]}
#25 scan L2 (2, 1) 칸은 빈 땅 → 다음 칸으로
    grid zone=110/010/000 cur=2,1 | calls[] | vars{"sizes":[3]}
#26 zone-start L3 (2, 2) 칸에서 방문 안 한 꽃 발견! 2번 구역 탐색 시작
    grid zone=110/010/000 cur=2,2 | calls[] | vars{"sizes":[3]}
#27 visit L6 (2, 2) 칸에 방문 표시, size = 1로 시작해요.
    grid zone=110/010/002 cur=2,2 | calls[dfs(2, 2)*{"size":1}] | vars{"sizes":[3]}
#28 check L8 위 (1, 2) 칸은 빈 땅 → 건너뛰기
    grid zone=110/010/002 cur=2,2 chk=1,2:blocked | calls[dfs(2, 2)*{"size":1}] | vars{"sizes":[3]}
#29 check L8 왼쪽 (2, 1) 칸은 빈 땅 → 건너뛰기
    grid zone=110/010/002 cur=2,2 chk=2,1:blocked | calls[dfs(2, 2)*{"size":1}] | vars{"sizes":[3]}
#30 return L10 더 갈 곳이 없어요. dfs(2, 2)의 결과는 1
    grid zone=110/010/002 cur=2,2 | calls[dfs(2, 2)*{"size":1}] | vars{"sizes":[3]}
#31 zone-complete L4 2번 구역 완성! 크기 1 → sizes = [3, 1]
    grid zone=110/010/002 cur=2,2 | calls[] | vars{"sizes":[3,1]}
#32 done L11 모든 칸 확인 완료! 정렬한 [1, 3]이 정답이에요.
    grid zone=110/010/002 | calls[] | vars{"sizes":[1,3]}"
`;

exports[`프리셋 hallway-tiles-repeat > 스텝 흐름 스냅샷 1`] = `
"#0 call L1 fib(5) 호출
    graph{5*(fib(5))} @t0 | calls[fib(5)*{"n":5}] | vars{"총 호출":1,"같은 계산 반복":0}
#1 call L3 fib(5)의 첫 번째 재귀 호출: fib(4)
    graph{5*(fib(5))} @t0 | calls[fib(5)*{"n":5}] | vars{"총 호출":1,"같은 계산 반복":0}
#2 call L1 fib(4) 호출
    graph{5?(fib(5)) 4*(fib(4))} edges{t0-t1~} @t1 | calls[fib(5){"n":5} > fib(4)*{"n":4}] | vars{"총 호출":2,"같은 계산 반복":0}
#3 call L3 fib(4)의 첫 번째 재귀 호출: fib(3)
    graph{5?(fib(5)) 4*(fib(4))} edges{t0-t1~} @t1 | calls[fib(5){"n":5} > fib(4)*{"n":4}] | vars{"총 호출":2,"같은 계산 반복":0}
#4 call L1 fib(3) 호출
    graph{5?(fib(5)) 4?(fib(4)) 3*(fib(3))} edges{t0-t1~ t1-t2~} @t2 | calls[fib(5){"n":5} > fib(4){"n":4} > fib(3)*{"n":3}] | vars{"총 호출":3,"같은 계산 반복":0}
#5 call L3 fib(3)의 첫 번째 재귀 호출: fib(2)
    graph{5?(fib(5)) 4?(fib(4)) 3*(fib(3))} edges{t0-t1~ t1-t2~} @t2 | calls[fib(5){"n":5} > fib(4){"n":4} > fib(3)*{"n":3}] | vars{"총 호출":3,"같은 계산 반복":0}
#6 call L1 fib(2) 호출
    graph{5?(fib(5)) 4?(fib(4)) 3?(fib(3)) 2*(fib(2))} edges{t0-t1~ t1-t2~ t2-t3~} @t3 | calls[fib(5){"n":5} > fib(4){"n":4} > fib(3){"n":3} > fib(2)*{"n":2}] | vars{"총 호출":4,"같은 계산 반복":0}
#7 call L3 fib(2)의 첫 번째 재귀 호출: fib(1)
    graph{5?(fib(5)) 4?(fib(4)) 3?(fib(3)) 2*(fib(2))} edges{t0-t1~ t1-t2~ t2-t3~} @t3 | calls[fib(5){"n":5} > fib(4){"n":4} > fib(3){"n":3} > fib(2)*{"n":2}] | vars{"총 호출":4,"같은 계산 반복":0}
#8 call L1 fib(1) 호출
    graph{5?(fib(5)) 4?(fib(4)) 3?(fib(3)) 2?(fib(2)) 1*(fib(1))} edges{t0-t1~ t1-t2~ t2-t3~ t3-t4~} @t4 | calls[fib(5){"n":5} > fib(4){"n":4} > fib(3){"n":3} > fib(2){"n":2} > fib(1)*{"n":1}] | vars{"총 호출":5,"같은 계산 반복":0}
#9 return L2 n = 1 → 종료 조건! 바로 1 반환
    graph{5?(fib(5)) 4?(fib(4)) 3?(fib(3)) 2*(fib(2)) 1✓(fib(1)=1)} edges{t0-t1~ t1-t2~ t2-t3~ t3-t4=} @t3 | calls[fib(5){"n":5} > fib(4){"n":4} > fib(3){"n":3} > fib(2)*{"n":2}] | vars{"총 호출":5,"같은 계산 반복":0}
#10 return-to L3 fib(1) = 1 값이 돌아왔어요 (지금까지 합 1)
    graph{5?(fib(5)) 4?(fib(4)) 3?(fib(3)) 2*(fib(2)) 1✓(fib(1)=1)} edges{t0-t1~ t1-t2~ t2-t3~ t3-t4=} @t3 | calls[fib(5){"n":5} > fib(4){"n":4} > fib(3){"n":3} > fib(2)*{"n":2,"지금까지":1}] | vars{"총 호출":5,"같은 계산 반복":0}
#11 call L3 fib(2)의 두 번째 재귀 호출: fib(0)
    graph{5?(fib(5)) 4?(fib(4)) 3?(fib(3)) 2*(fib(2)) 1✓(fib(1)=1)} edges{t0-t1~ t1-t2~ t2-t3~ t3-t4=} @t3 | calls[fib(5){"n":5} > fib(4){"n":4} > fib(3){"n":3} > fib(2)*{"n":2,"지금까지":1}] | vars{"총 호출":5,"같은 계산 반복":0}
#12 call L1 fib(0) 호출
    graph{5?(fib(5)) 4?(fib(4)) 3?(fib(3)) 2?(fib(2)) 1✓(fib(1)=1) 0*(fib(0))} edges{t0-t1~ t1-t2~ t2-t3~ t3-t4= t3-t5~} @t5 | calls[fib(5){"n":5} > fib(4){"n":4} > fib(3){"n":3} > fib(2){"n":2,"지금까지":1} > fib(0)*{"n":0}] | vars{"총 호출":6,"같은 계산 반복":0}
#13 return L2 n = 0 → 종료 조건! 바로 0 반환
    graph{5?(fib(5)) 4?(fib(4)) 3?(fib(3)) 2*(fib(2)) 1✓(fib(1)=1) 0✓(fib(0)=0)} edges{t0-t1~ t1-t2~ t2-t3~ t3-t4= t3-t5=} @t3 | calls[fib(5){"n":5} > fib(4){"n":4} > fib(3){"n":3} > fib(2)*{"n":2,"지금까지":1}] | vars{"총 호출":6,"같은 계산 반복":0}
#14 return-to L3 fib(0) = 0 값이 돌아왔어요 (지금까지 합 1)
    graph{5?(fib(5)) 4?(fib(4)) 3?(fib(3)) 2*(fib(2)) 1✓(fib(1)=1) 0✓(fib(0)=0)} edges{t0-t1~ t1-t2~ t2-t3~ t3-t4= t3-t5=} @t3 | calls[fib(5){"n":5} > fib(4){"n":4} > fib(3){"n":3} > fib(2)*{"n":2,"지금까지":1}] | vars{"총 호출":6,"같은 계산 반복":0}
#15 return L3 fib(2) = 1 반환
