    items=<1✓ 2✓ 3✓> cur=- done=0 | path=[1,3,2] | calls[backtrack([]){"깊이":0} > backtrack([1]){"깊이":1} > backtrack([1, 3]){"깊이":2} > backtrack([1, 3, 2])*{"깊이":3}] | vars{"찾은 순열":["[1, 2, 3]","[1, 3, 2]"],"개수":2}
