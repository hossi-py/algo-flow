"#0 init L1 5칸 계단을 1칸 또는 2칸씩 오르는 방법을 세요. i칸까지 오는 방법 수를 표에 적어 가요.
    ways (i칸까지 오는 방법 수)[. . . . . .] | vars{"n":5}
#1 fill L2 시작점(0칸)에 서 있는 방법, 1칸까지 가는 방법은 하나씩이에요.
    ways (i칸까지 오는 방법 수)[1! 1! . . . .] | vars{"n":5}
#2 reuse L4 2칸에 오려면 마지막에 1칸(1칸에서) 또는 2칸(0칸에서) 올라와요. 표에 적어 둔 두 값(1, 1)을 꺼내요.
    ways (i칸까지 오는 방법 수)[1? 1? .* . . .] | vars{"n":5,"i":2}
#3 fill L4 ways[2] = 1 + 1 = 2
    ways (i칸까지 오는 방법 수)[1 1 2! . . .] | vars{"n":5,"i":2}
#4 reuse L4 3칸에 오려면 마지막에 1칸(2칸에서) 또는 2칸(1칸에서) 올라와요. 표에 적어 둔 두 값(2, 1)을 꺼내요.
    ways (i칸까지 오는 방법 수)[1 1? 2? .* . .] | vars{"n":5,"i":3}
#5 fill L4 ways[3] = 2 + 1 = 3
    ways (i칸까지 오는 방법 수)[1 1 2 3! . .] | vars{"n":5,"i":3}
#6 reuse L4 4칸에 오려면 마지막에 1칸(3칸에서) 또는 2칸(2칸에서) 올라와요. 표에 적어 둔 두 값(3, 2)을 꺼내요.
    ways (i칸까지 오는 방법 수)[1 1 2? 3? .* .] | vars{"n":5,"i":4}
#7 fill L4 ways[4] = 3 + 2 = 5
    ways (i칸까지 오는 방법 수)[1 1 2 3 5! .] | vars{"n":5,"i":4}
#8 reuse L4 5칸에 오려면 마지막에 1칸(4칸에서) 또는 2칸(3칸에서) 올라와요. 표에 적어 둔 두 값(5, 3)을 꺼내요.
    ways (i칸까지 오는 방법 수)[1 1 2 3? 5? .*] | vars{"n":5,"i":5}
#9 fill L4 ways[5] = 5 + 3 = 8
    ways (i칸까지 오는 방법 수)[1 1 2 3 5 8!] | vars{"n":5,"i":5}
#10 done L5 답은 8가지. 칸마다 한 번씩 6번만 계산했어요. 표 없이 재귀로 풀면 15번 호출해요.
    ways (i칸까지 오는 방법 수)[1 1 2 3 5 8!] | vars{"n":5}"
`;

exports[`프리셋 dp-stairs-6 > 스텝 흐름 스냅샷 1`] = `
"#0 init L1 6칸 계단을 1칸 또는 2칸씩 오르는 방법을 세요. i칸까지 오는 방법 수를 표에 적어 가요.
    ways (i칸까지 오는 방법 수)[. . . . . . .] | vars{"n":6}
#1 fill L2 시작점(0칸)에 서 있는 방법, 1칸까지 가는 방법은 하나씩이에요.
    ways (i칸까지 오는 방법 수)[1! 1! . . . . .] | vars{"n":6}
#2 reuse L4 2칸에 오려면 마지막에 1칸(1칸에서) 또는 2칸(0칸에서) 올라와요. 표에 적어 둔 두 값(1, 1)을 꺼내요.
    ways (i칸까지 오는 방법 수)[1? 1? .* . . . .] | vars{"n":6,"i":2}
#3 fill L4 ways[2] = 1 + 1 = 2
    ways (i칸까지 오는 방법 수)[1 1 2! . . . .] | vars{"n":6,"i":2}
#4 reuse L4 3칸에 오려면 마지막에 1칸(2칸에서) 또는 2칸(1칸에서) 올라와요. 표에 적어 둔 두 값(2, 1)을 꺼내요.
    ways (i칸까지 오는 방법 수)[1 1? 2? .* . . .] | vars{"n":6,"i":3}
#5 fill L4 ways[3] = 2 + 1 = 3
    ways (i칸까지 오는 방법 수)[1 1 2 3! . . .] | vars{"n":6,"i":3}
#6 reuse L4 4칸에 오려면 마지막에 1칸(3칸에서) 또는 2칸(2칸에서) 올라와요. 표에 적어 둔 두 값(3, 2)을 꺼내요.
    ways (i칸까지 오는 방법 수)[1 1 2? 3? .* . .] | vars{"n":6,"i":4}
#7 fill L4 ways[4] = 3 + 2 = 5
    ways (i칸까지 오는 방법 수)[1 1 2 3 5! . .] | vars{"n":6,"i":4}
#8 reuse L4 5칸에 오려면 마지막에 1칸(4칸에서) 또는 2칸(3칸에서) 올라와요. 표에 적어 둔 두 값(5, 3)을 꺼내요.
    ways (i칸까지 오는 방법 수)[1 1 2 3? 5? .* .] | vars{"n":6,"i":5}
#9 fill L4 ways[5] = 5 + 3 = 8
    ways (i칸까지 오는 방법 수)[1 1 2 3 5 8! .] | vars{"n":6,"i":5}
#10 reuse L4 6칸에 오려면 마지막에 1칸(5칸에서) 또는 2칸(4칸에서) 올라와요. 표에 적어 둔 두 값(8, 5)을 꺼내요.
    ways (i칸까지 오는 방법 수)[1 1 2 3 5? 8? .*] | vars{"n":6,"i":6}
#11 fill L4 ways[6] = 8 + 5 = 13
    ways (i칸까지 오는 방법 수)[1 1 2 3 5 8 13!] | vars{"n":6,"i":6}
#12 done L5 답은 13가지. 칸마다 한 번씩 7번만 계산했어요. 표 없이 재귀로 풀면 25번 호출해요.
    ways (i칸까지 오는 방법 수)[1 1 2 3 5 8 13!] | vars{"n":6}"
`;

exports[`프리셋 echo-valley-stack > 스텝 흐름 스냅샷 1`] = `
"#0 call L1 factorial(4) 호출 — 호출 스택에 새 칸이 쌓여요
    calls[factorial(4)*{"n":4}] | vars{"호출 깊이":1}
#1 call L3 4 × factorial(3) 계산에는 먼저 factorial(3) 값이 필요해요 → 재귀 호출
    calls[factorial(4)*{"n":4}] | vars{"호출 깊이":1}
#2 call L1 factorial(3) 호출 — 호출 스택에 새 칸이 쌓여요
    calls[factorial(4){"n":4} > factorial(3)*{"n":3}] | vars{"호출 깊이":2}
#3 call L3 3 × factorial(2) 계산에는 먼저 factorial(2) 값이 필요해요 → 재귀 호출
    calls[factorial(4){"n":4} > factorial(3)*{"n":3}] | vars{"호출 깊이":2}
#4 call L1 factorial(2) 호출 — 호출 스택에 새 칸이 쌓여요
    calls[factorial(4){"n":4} > factorial(3){"n":3} > factorial(2)*{"n":2}] | vars{"호출 깊이":3}
#5 call L3 2 × factorial(1) 계산에는 먼저 factorial(1) 값이 필요해요 → 재귀 호출
    calls[factorial(4){"n":4} > factorial(3){"n":3} > factorial(2)*{"n":2}] | vars{"호출 깊이":3}
#6 call L1 factorial(1) 호출 — 호출 스택에 새 칸이 쌓여요
    calls[factorial(4){"n":4} > factorial(3){"n":3} > factorial(2){"n":2} > factorial(1)*{"n":1}] | vars{"호출 깊이":4}
#7 return L2 n = 1 → 종료 조건! 더 부르지 않고 1을 돌려줘요
    calls[factorial(4){"n":4} > factorial(3){"n":3} > factorial(2){"n":2} > factorial(1)*{"n":1,"결과":1}] | vars{"호출 깊이":4}
#8 return-to L3 factorial(1) = 1 값이 돌아왔어요 → 2 × 1 = 2
    calls[factorial(4){"n":4} > factorial(3){"n":3} > factorial(2)*{"n":2,"결과":2}] | vars{"호출 깊이":3}
#9 return L3 factorial(2)의 계산이 끝났어요. 결과 2 반환, 칸이 사라져요
    calls[factorial(4){"n":4} > factorial(3){"n":3} > factorial(2)*{"n":2,"결과":2}] | vars{"호출 깊이":3}
#10 return-to L3 factorial(2) = 2 값이 돌아왔어요 → 3 × 2 = 6
    calls[factorial(4){"n":4} > factorial(3)*{"n":3,"결과":6}] | vars{"호출 깊이":2}
#11 return L3 factorial(3)의 계산이 끝났어요. 결과 6 반환, 칸이 사라져요
    calls[factorial(4){"n":4} > factorial(3)*{"n":3,"결과":6}] | vars{"호출 깊이":2}
#12 return-to L3 factorial(3) = 6 값이 돌아왔어요 → 4 × 6 = 24
    calls[factorial(4)*{"n":4,"결과":24}] | vars{"호출 깊이":1}
#13 return L3 factorial(4)의 계산이 끝났어요. 결과 24 반환, 칸이 사라져요
    calls[factorial(4)*{"n":4,"결과":24}] | vars{"호출 깊이":1}
#14 done L- factorial(4) = 24. 호출은 4칸까지 쌓였다가 거꾸로 풀렸어요.
    calls[] | vars{"결과":24}"
`;

exports[`프리셋 factorial-4 > 스텝 흐름 스냅샷 1`] = `
"#0 call L1 factorial(4) 호출 — 호출 스택에 새 칸이 쌓여요
    calls[factorial(4)*{"n":4}] | vars{"호출 깊이":1}
#1 call L3 4 × factorial(3) 계산에는 먼저 factorial(3) 값이 필요해요 → 재귀 호출
    calls[factorial(4)*{"n":4}] | vars{"호출 깊이":1}
#2 call L1 factorial(3) 호출 — 호출 스택에 새 칸이 쌓여요
    calls[factorial(4){"n":4} > factorial(3)*{"n":3}] | vars{"호출 깊이":2}
#3 call L3 3 × factorial(2) 계산에는 먼저 factorial(2) 값이 필요해요 → 재귀 호출
    calls[factorial(4){"n":4} > factorial(3)*{"n":3}] | vars{"호출 깊이":2}
#4 call L1 factorial(2) 호출 — 호출 스택에 새 칸이 쌓여요
    calls[factorial(4){"n":4} > factorial(3){"n":3} > factorial(2)*{"n":2}] | vars{"호출 깊이":3}
#5 call L3 2 × factorial(1) 계산에는 먼저 factorial(1) 값이 필요해요 → 재귀 호출
    calls[factorial(4){"n":4} > factorial(3){"n":3} > factorial(2)*{"n":2}] | vars{"호출 깊이":3}
#6 call L1 factorial(1) 호출 — 호출 스택에 새 칸이 쌓여요
    calls[factorial(4){"n":4} > factorial(3){"n":3} > factorial(2){"n":2} > factorial(1)*{"n":1}] | vars{"호출 깊이":4}
#7 return L2 n = 1 → 종료 조건! 더 부르지 않고 1을 돌려줘요
    calls[factorial(4){"n":4} > factorial(3){"n":3} > factorial(2){"n":2} > factorial(1)*{"n":1,"결과":1}] | vars{"호출 깊이":4}
#8 return-to L3 factorial(1) = 1 값이 돌아왔어요 → 2 × 1 = 2
    calls[factorial(4){"n":4} > factorial(3){"n":3} > factorial(2)*{"n":2,"결과":2}] | vars{"호출 깊이":3}
#9 return L3 factorial(2)의 계산이 끝났어요. 결과 2 반환, 칸이 사라져요
    calls[factorial(4){"n":4} > factorial(3){"n":3} > factorial(2)*{"n":2,"결과":2}] | vars{"호출 깊이":3}
#10 return-to L3 factorial(2) = 2 값이 돌아왔어요 → 3 × 2 = 6
    calls[factorial(4){"n":4} > factorial(3)*{"n":3,"결과":6}] | vars{"호출 깊이":2}
#11 return L3 factorial(3)의 계산이 끝났어요. 결과 6 반환, 칸이 사라져요
    calls[factorial(4){"n":4} > factorial(3)*{"n":3,"결과":6}] | vars{"호출 깊이":2}
#12 return-to L3 factorial(3) = 6 값이 돌아왔어요 → 4 × 6 = 24
    calls[factorial(4)*{"n":4,"결과":24}] | vars{"호출 깊이":1}
#13 return L3 factorial(4)의 계산이 끝났어요. 결과 24 반환, 칸이 사라져요
    calls[factorial(4)*{"n":4,"결과":24}] | vars{"호출 깊이":1}
#14 done L- factorial(4) = 24. 호출은 4칸까지 쌓였다가 거꾸로 풀렸어요.
    calls[] | vars{"결과":24}"
`;

exports[`프리셋 fibonacci-4 > 스텝 흐름 스냅샷 1`] = `
"#0 call L1 fib(4) 호출
    graph{4*(fib(4))} @t0 | calls[fib(4)*{"n":4}] | vars{"총 호출":1,"같은 계산 반복":0}
#1 call L3 fib(4)의 첫 번째 재귀 호출: fib(3)
    graph{4*(fib(4))} @t0 | calls[fib(4)*{"n":4}] | vars{"총 호출":1,"같은 계산 반복":0}
#2 call L1 fib(3) 호출
    graph{4?(fib(4)) 3*(fib(3))} edges{t0-t1~} @t1 | calls[fib(4){"n":4} > fib(3)*{"n":3}] | vars{"총 호출":2,"같은 계산 반복":0}
#3 call L3 fib(3)의 첫 번째 재귀 호출: fib(2)
    graph{4?(fib(4)) 3*(fib(3))} edges{t0-t1~} @t1 | calls[fib(4){"n":4} > fib(3)*{"n":3}] | vars{"총 호출":2,"같은 계산 반복":0}
#4 call L1 fib(2) 호출
    graph{4?(fib(4)) 3?(fib(3)) 2*(fib(2))} edges{t0-t1~ t1-t2~} @t2 | calls[fib(4){"n":4} > fib(3){"n":3} > fib(2)*{"n":2}] | vars{"총 호출":3,"같은 계산 반복":0}
#5 call L3 fib(2)의 첫 번째 재귀 호출: fib(1)
    graph{4?(fib(4)) 3?(fib(3)) 2*(fib(2))} edges{t0-t1~ t1-t2~} @t2 | calls[fib(4){"n":4} > fib(3){"n":3} > fib(2)*{"n":2}] | vars{"총 호출":3,"같은 계산 반복":0}
#6 call L1 fib(1) 호출
    graph{4?(fib(4)) 3?(fib(3)) 2?(fib(2)) 1*(fib(1))} edges{t0-t1~ t1-t2~ t2-t3~} @t3 | calls[fib(4){"n":4} > fib(3){"n":3} > fib(2){"n":2} > fib(1)*{"n":1}] | vars{"총 호출":4,"같은 계산 반복":0}
#7 return L2 n = 1 → 종료 조건! 바로 1 반환
    graph{4?(fib(4)) 3?(fib(3)) 2*(fib(2)) 1✓(fib(1)=1)} edges{t0-t1~ t1-t2~ t2-t3=} @t2 | calls[fib(4){"n":4} > fib(3){"n":3} > fib(2)*{"n":2}] | vars{"총 호출":4,"같은 계산 반복":0}
#8 return-to L3 fib(1) = 1 값이 돌아왔어요 (지금까지 합 1)
    graph{4?(fib(4)) 3?(fib(3)) 2*(fib(2)) 1✓(fib(1)=1)} edges{t0-t1~ t1-t2~ t2-t3=} @t2 | calls[fib(4){"n":4} > fib(3){"n":3} > fib(2)*{"n":2,"지금까지":1}] | vars{"총 호출":4,"같은 계산 반복":0}
#9 call L3 fib(2)의 두 번째 재귀 호출: fib(0)
    graph{4?(fib(4)) 3?(fib(3)) 2*(fib(2)) 1✓(fib(1)=1)} edges{t0-t1~ t1-t2~ t2-t3=} @t2 | calls[fib(4){"n":4} > fib(3){"n":3} > fib(2)*{"n":2,"지금까지":1}] | vars{"총 호출":4,"같은 계산 반복":0}
#10 call L1 fib(0) 호출
    graph{4?(fib(4)) 3?(fib(3)) 2?(fib(2)) 1✓(fib(1)=1) 0*(fib(0))} edges{t0-t1~ t1-t2~ t2-t3= t2-t4~} @t4 | calls[fib(4){"n":4} > fib(3){"n":3} > fib(2){"n":2,"지금까지":1} > fib(0)*{"n":0}] | vars{"총 호출":5,"같은 계산 반복":0}
#11 return L2 n = 0 → 종료 조건! 바로 0 반환
    graph{4?(fib(4)) 3?(fib(3)) 2*(fib(2)) 1✓(fib(1)=1) 0✓(fib(0)=0)} edges{t0-t1~ t1-t2~ t2-t3= t2-t4=} @t2 | calls[fib(4){"n":4} > fib(3){"n":3} > fib(2)*{"n":2,"지금까지":1}] | vars{"총 호출":5,"같은 계산 반복":0}
#12 return-to L3 fib(0) = 0 값이 돌아왔어요 (지금까지 합 1)
    graph{4?(fib(4)) 3?(fib(3)) 2*(fib(2)) 1✓(fib(1)=1) 0✓(fib(0)=0)} edges{t0-t1~ t1-t2~ t2-t3= t2-t4=} @t2 | calls[fib(4){"n":4} > fib(3){"n":3} > fib(2)*{"n":2,"지금까지":1}] | vars{"총 호출":5,"같은 계산 반복":0}
#13 return L3 fib(2) = 1 반환
    graph{4?(fib(4)) 3*(fib(3)) 2✓(fib(2)=1) 1✓(fib(1)=1) 0✓(fib(0)=0)} edges{t0-t1~ t1-t2= t2-t3= t2-t4=} @t1 | calls[fib(4){"n":4} > fib(3)*{"n":3}] | vars{"총 호출":5,"같은 계산 반복":0}
#14 return-to L3 fib(2) = 1 값이 돌아왔어요 (지금까지 합 1)
    graph{4?(fib(4)) 3*(fib(3)) 2✓(fib(2)=1) 1✓(fib(1)=1) 0✓(fib(0)=0)} edges{t0-t1~ t1-t2= t2-t3= t2-t4=} @t1 | calls[fib(4){"n":4} > fib(3)*{"n":3,"지금까지":1}] | vars{"총 호출":5,"같은 계산 반복":0}
#15 call L3 fib(3)의 두 번째 재귀 호출: fib(1)
    graph{4?(fib(4)) 3*(fib(3)) 2✓(fib(2)=1) 1✓(fib(1)=1) 0✓(fib(0)=0)} edges{t0-t1~ t1-t2= t2-t3= t2-t4=} @t1 | calls[fib(4){"n":4} > fib(3)*{"n":3,"지금까지":1}] | vars{"총 호출":5,"같은 계산 반복":0}
#16 call L1 fib(1) 호출 — 앞에서 이미 계산한 적 있는 값이에요! 같은 일을 또 하고 있어요
    graph{4?(fib(4)) 3?(fib(3)) 2✓(fib(2)=1) 1✓(fib(1)=1) 0✓(fib(0)=0) 1*(fib(1))} edges{t0-t1~ t1-t2= t2-t3= t2-t4= t1-t5~} @t5 | calls[fib(4){"n":4} > fib(3){"n":3,"지금까지":1} > fib(1)*{"n":1}] | vars{"총 호출":6,"같은 계산 반복":1}
#17 return L2 n = 1 → 종료 조건! 바로 1 반환
    graph{4?(fib(4)) 3*(fib(3)) 2✓(fib(2)=1) 1✓(fib(1)=1) 0✓(fib(0)=0) 1✓(fib(1)=1)} edges{t0-t1~ t1-t2= t2-t3= t2-t4= t1-t5=} @t1 | calls[fib(4){"n":4} > fib(3)*{"n":3,"지금까지":1}] | vars{"총 호출":6,"같은 계산 반복":1}
