#9 visit L3 dfs(2): 2번 노드에 방문 표시 (방문 순서 4)
    graph{0?#1 1?#2 2*#4 3?#3 4. 5.} edges{0-1= 1-3= 2-3=} @2 | calls[dfs(0){"v":0} > dfs(1){"v":1} > dfs(3){"v":3} > dfs(2)*{"v":2}] | vars{"방문 순서":[0,1,3,2]}
#10 check L5 이웃 0번은 이미 방문했어요 → 건너뛰기
    graph{0?#1 1?#2 2*#4 3?#3 4. 5.} edges{0-1= 0-2~ 1-3= 2-3=} @2 | calls[dfs(0){"v":0} > dfs(1){"v":1} > dfs(3){"v":3} > dfs(2)*{"v":2}] | vars{"방문 순서":[0,1,3,2]}
#11 check L5 이웃 3번은 이미 방문했어요 → 건너뛰기
    graph{0?#1 1?#2 2*#4 3?#3 4. 5.} edges{0-1= 0-2x 1-3= 2-3~} @2 | calls[dfs(0){"v":0} > dfs(1){"v":1} > dfs(3){"v":3} > dfs(2)*{"v":2}] | vars{"방문 순서":[0,1,3,2]}
