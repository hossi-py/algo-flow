"#0 init L1 빈 큐에서 시작해요. 들어가는 곳(rear)과 나가는 곳(front)이 달라요.
    명령=<enqueue 1 enqueue 2 enqueue 3 dequeue enqueue 4 peek dequeue dequeue> cur=- done=0 | queue=[] | vars{"크기":0}
#1 enqueue L3 enqueue(1): 줄의 맨 뒤에 섰어요. 지금 1명 대기 중
    명령=<enqueue 1* enqueue 2 enqueue 3 dequeue enqueue 4 peek dequeue dequeue> cur=0 done=0 | queue=[1*] | vars{"크기":1}
#2 enqueue L3 enqueue(2): 줄의 맨 뒤에 섰어요. 지금 2명 대기 중
    명령=<enqueue 1 enqueue 2* enqueue 3 dequeue enqueue 4 peek dequeue dequeue> cur=1 done=1 | queue=[1,2*] | vars{"크기":2}
#3 enqueue L3 enqueue(3): 줄의 맨 뒤에 섰어요. 지금 3명 대기 중
    명령=<enqueue 1 enqueue 2 enqueue 3* dequeue enqueue 4 peek dequeue dequeue> cur=2 done=2 | queue=[1,2,3*] | vars{"크기":3}
#4 dequeue L4 dequeue(): 맨 앞 값 1 꺼내기 — 먼저 온 값이 먼저 나가요
    명령=<enqueue 1 enqueue 2 enqueue 3 dequeue* enqueue 4 peek dequeue dequeue> cur=3 done=3 | queue=[2,3] | vars{"크기":2,"꺼낸 값":1}
#5 enqueue L3 enqueue(4): 줄의 맨 뒤에 섰어요. 지금 3명 대기 중
    명령=<enqueue 1 enqueue 2 enqueue 3 dequeue enqueue 4* peek dequeue dequeue> cur=4 done=4 | queue=[2,3,4*] | vars{"크기":3}
#6 peek L5 peek(): 맨 앞 값은 2
    명령=<enqueue 1 enqueue 2 enqueue 3 dequeue enqueue 4 peek* dequeue dequeue> cur=5 done=5 | queue=[2!,3,4] | vars{"크기":3,"맨 앞":2}
#7 dequeue L4 dequeue(): 맨 앞 값 2 꺼내기 — 먼저 온 값이 먼저 나가요
    명령=<enqueue 1 enqueue 2 enqueue 3 dequeue enqueue 4 peek dequeue* dequeue> cur=6 done=6 | queue=[3,4] | vars{"크기":2,"꺼낸 값":2}
#8 dequeue L4 dequeue(): 맨 앞 값 3 꺼내기 — 먼저 온 값이 먼저 나가요
    명령=<enqueue 1 enqueue 2 enqueue 3 dequeue enqueue 4 peek dequeue dequeue*> cur=7 done=7 | queue=[4] | vars{"크기":1,"꺼낸 값":3}
#9 done L- 명령을 모두 처리했어요. 남은 줄 (앞 → 뒤): [4]
    명령=<enqueue 1 enqueue 2 enqueue 3 dequeue enqueue 4 peek dequeue dequeue> cur=- done=8 | queue=[4] | vars{"크기":1}"
`;

