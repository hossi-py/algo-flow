exports[`프리셋 plate-tower-ex1 > 스텝 흐름 스냅샷 1`] = `
"#0 init L1 빈 스택에서 시작해요. 넣고 빼는 곳은 맨 위(top) 한 곳뿐이에요.
    명령=<push 1 push 2 pop push 3> cur=- done=0 | stack=[] | vars{"크기":0}
#1 push L3 push(1): 맨 위에 올렸어요. 지금 크기 1
    명령=<push 1* push 2 pop push 3> cur=0 done=0 | stack=[1*] | vars{"크기":1}
#2 push L3 push(2): 맨 위에 올렸어요. 지금 크기 2
    명령=<push 1 push 2* pop push 3> cur=1 done=1 | stack=[1,2*] | vars{"크기":2}
#3 pop L4 pop(): 맨 위 값 2 꺼내기 — 가장 나중에 넣은 값이 먼저 나와요
    명령=<push 1 push 2 pop* push 3> cur=2 done=2 | stack=[1] | vars{"크기":1,"꺼낸 값":2}
#4 push L3 push(3): 맨 위에 올렸어요. 지금 크기 2
    명령=<push 1 push 2 pop push 3*> cur=3 done=3 | stack=[1,3*] | vars{"크기":2}
#5 done L- 명령을 모두 처리했어요. 남은 값 (아래 → 위): [1, 3]
    명령=<push 1 push 2 pop push 3> cur=- done=4 | stack=[1,3] | vars{"크기":2}"
`;

