    graph{4✓(fib(4)=3) 3✓(fib(3)=2) 2✓(fib(2)=1) 1✓(fib(1)=1) 0✓(fib(0)=0) 1✓(fib(1)=1) 2✓(fib(2)=1) 1✓(fib(1)=1) 0✓(fib(0)=0)} edges{t0-t1= t1-t2= t2-t3= t2-t4= t1-t5= t0-t6= t6-t7= t6-t8=} | calls[] | vars{"총 호출":9,"같은 계산 반복":4}"
`;

exports[`프리셋 ripple-rings-ex1 > 스텝 흐름 스냅샷 1`] = `
"#0 init L1 시작 0번 노드의 거리는 0. 나머지는 아직 모르니 -1이에요.
    queue=[] | graph{0.d0 1. 2. 3. 4. 5.} | vars{"dist":[0,-1,-1,-1,-1,-1]}
#1 enqueue L2 0번 노드를 큐에 넣고 출발!
    queue=[0] | graph{0?d0 1. 2. 3. 4. 5.} | vars{"dist":[0,-1,-1,-1,-1,-1]}
#2 dequeue L4 큐 맨 앞의 0번 노드를 꺼내요 (거리 0)
    queue=[] | graph{0*#1d0 1. 2. 3. 4. 5.} @0 | vars{"dist":[0,-1,-1,-1,-1,-1]}
#3 discover L7 이웃 1번을 처음 발견! 거리 0 + 1 = 1, 큐 뒤에 넣어요
    queue=[1] | graph{0*#1d0 1?d1 2. 3. 4. 5.} edges{0-1=} @0 | vars{"dist":[0,1,-1,-1,-1,-1]}
#4 discover L7 이웃 2번을 처음 발견! 거리 0 + 1 = 1, 큐 뒤에 넣어요
    queue=[1,2] | graph{0*#1d0 1?d1 2?d1 3. 4. 5.} edges{0-1= 0-2=} @0 | vars{"dist":[0,1,1,-1,-1,-1]}
#5 dequeue L4 큐 맨 앞의 1번 노드를 꺼내요 (거리 1)
    queue=[2] | graph{0✓#1d0 1*#2d1 2?d1 3. 4. 5.} edges{0-1= 0-2=} @1 | vars{"dist":[0,1,1,-1,-1,-1]}
#6 check L6 이웃 0번은 이미 발견했어요 (거리 0) → 건너뛰기
    queue=[2] | graph{0✓#1d0 1*#2d1 2?d1 3. 4. 5.} edges{0-1~ 0-2=} @1 | vars{"dist":[0,1,1,-1,-1,-1]}
#7 discover L7 이웃 3번을 처음 발견! 거리 1 + 1 = 2, 큐 뒤에 넣어요
    queue=[2,3] | graph{0✓#1d0 1*#2d1 2?d1 3?d2 4. 5.} edges{0-1= 0-2= 1-3=} @1 | vars{"dist":[0,1,1,2,-1,-1]}
#8 dequeue L4 큐 맨 앞의 2번 노드를 꺼내요 (거리 1)
    queue=[3] | graph{0✓#1d0 1✓#2d1 2*#3d1 3?d2 4. 5.} edges{0-1= 0-2= 1-3=} @2 | vars{"dist":[0,1,1,2,-1,-1]}
#9 check L6 이웃 0번은 이미 발견했어요 (거리 0) → 건너뛰기
    queue=[3] | graph{0✓#1d0 1✓#2d1 2*#3d1 3?d2 4. 5.} edges{0-1= 0-2~ 1-3=} @2 | vars{"dist":[0,1,1,2,-1,-1]}
#10 check L6 이웃 3번은 이미 발견했어요 (거리 2) → 건너뛰기
    queue=[3] | graph{0✓#1d0 1✓#2d1 2*#3d1 3?d2 4. 5.} edges{0-1= 0-2= 1-3= 2-3~} @2 | vars{"dist":[0,1,1,2,-1,-1]}
#11 dequeue L4 큐 맨 앞의 3번 노드를 꺼내요 (거리 2)
    queue=[] | graph{0✓#1d0 1✓#2d1 2✓#3d1 3*#4d2 4. 5.} edges{0-1= 0-2= 1-3= 2-3x} @3 | vars{"dist":[0,1,1,2,-1,-1]}
#12 check L6 이웃 1번은 이미 발견했어요 (거리 1) → 건너뛰기
    queue=[] | graph{0✓#1d0 1✓#2d1 2✓#3d1 3*#4d2 4. 5.} edges{0-1= 0-2= 1-3~ 2-3x} @3 | vars{"dist":[0,1,1,2,-1,-1]}
#13 check L6 이웃 2번은 이미 발견했어요 (거리 1) → 건너뛰기
    queue=[] | graph{0✓#1d0 1✓#2d1 2✓#3d1 3*#4d2 4. 5.} edges{0-1= 0-2= 1-3= 2-3~} @3 | vars{"dist":[0,1,1,2,-1,-1]}
#14 discover L7 이웃 4번을 처음 발견! 거리 2 + 1 = 3, 큐 뒤에 넣어요
    queue=[4] | graph{0✓#1d0 1✓#2d1 2✓#3d1 3*#4d2 4?d3 5.} edges{0-1= 0-2= 1-3= 2-3x 3-4=} @3 | vars{"dist":[0,1,1,2,3,-1]}
#15 dequeue L4 큐 맨 앞의 4번 노드를 꺼내요 (거리 3)
    queue=[] | graph{0✓#1d0 1✓#2d1 2✓#3d1 3✓#4d2 4*#5d3 5.} edges{0-1= 0-2= 1-3= 2-3x 3-4=} @4 | vars{"dist":[0,1,1,2,3,-1]}
#16 check L6 이웃 3번은 이미 발견했어요 (거리 2) → 건너뛰기
    queue=[] | graph{0✓#1d0 1✓#2d1 2✓#3d1 3✓#4d2 4*#5d3 5.} edges{0-1= 0-2= 1-3= 2-3x 3-4~} @4 | vars{"dist":[0,1,1,2,3,-1]}
#17 done L8 큐가 비었어요. 시작점에서의 최단 거리: 0번=0, 1번=1, 2번=1, 3번=2, 4번=3, 5번=-1
    queue=[] | graph{0✓#1d0 1✓#2d1 2✓#3d1 3✓#4d2 4✓#5d3 5.} edges{0-1= 0-2= 1-3= 2-3x 3-4=} | vars{"dist":[0,1,1,2,3,-1]}"
`;

exports[`프리셋 seat-tree > 스텝 흐름 스냅샷 1`] = `
"#0 init L1 [1, 2, 3]로 만들 수 있는 모든 순서를 찾아요. 빈 path에서 시작!
    items=<1 2 3> cur=- done=0 | path=[] | calls[backtrack([])*{"깊이":0}] | vars{"찾은 순열":[],"개수":0}
#1 choose L5 아직 안 쓴 1 고르기 → path = [1]
    items=<1* 2 3> cur=0 done=0 | path=[1*] | calls[backtrack([]){"깊이":0} > backtrack([1])*{"깊이":1}] | vars{"찾은 순열":[],"개수":0}
#2 choose L5 아직 안 쓴 2 고르기 → path = [1, 2]
    items=<1✓ 2* 3> cur=1 done=0 | path=[1,2*] | calls[backtrack([]){"깊이":0} > backtrack([1]){"깊이":1} > backtrack([1, 2])*{"깊이":2}] | vars{"찾은 순열":[],"개수":0}
#3 choose L5 아직 안 쓴 3 고르기 → path = [1, 2, 3]
    items=<1✓ 2✓ 3*> cur=2 done=0 | path=[1,2,3*] | calls[backtrack([]){"깊이":0} > backtrack([1]){"깊이":1} > backtrack([1, 2]){"깊이":2} > backtrack([1, 2, 3])*{"깊이":3}] | vars{"찾은 순열":[],"개수":0}
#4 record L2 path가 3개로 꽉 찼어요 → 순열 [1, 2, 3] 기록
    items=<1✓ 2✓ 3✓> cur=- done=0 | path=[1,2,3] | calls[backtrack([]){"깊이":0} > backtrack([1]){"깊이":1} > backtrack([1, 2]){"깊이":2} > backtrack([1, 2, 3])*{"깊이":3}] | vars{"찾은 순열":["[1, 2, 3]"],"개수":1}
#5 unchoose L7 되돌리기: path에서 3 빼고 다음 선택지를 봐요 → path = [1, 2]
    items=<1✓ 2✓ 3*> cur=2 done=0 | path=[1,2] | calls[backtrack([]){"깊이":0} > backtrack([1]){"깊이":1} > backtrack([1, 2])*{"깊이":2}] | vars{"찾은 순열":["[1, 2, 3]"],"개수":1}
#6 unchoose L7 되돌리기: path에서 2 빼고 다음 선택지를 봐요 → path = [1]
    items=<1✓ 2* 3> cur=1 done=0 | path=[1] | calls[backtrack([]){"깊이":0} > backtrack([1])*{"깊이":1}] | vars{"찾은 순열":["[1, 2, 3]"],"개수":1}
#7 choose L5 아직 안 쓴 3 고르기 → path = [1, 3]
    items=<1✓ 2 3*> cur=2 done=0 | path=[1,3*] | calls[backtrack([]){"깊이":0} > backtrack([1]){"깊이":1} > backtrack([1, 3])*{"깊이":2}] | vars{"찾은 순열":["[1, 2, 3]"],"개수":1}
#8 choose L5 아직 안 쓴 2 고르기 → path = [1, 3, 2]
    items=<1✓ 2* 3✓> cur=1 done=0 | path=[1,3,2*] | calls[backtrack([]){"깊이":0} > backtrack([1]){"깊이":1} > backtrack([1, 3]){"깊이":2} > backtrack([1, 3, 2])*{"깊이":3}] | vars{"찾은 순열":["[1, 2, 3]"],"개수":1}
