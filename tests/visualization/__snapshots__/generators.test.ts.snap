    path=[] | graph{시작? +1✓ +2✓ +3✓({1,2,3}) −3✓({1,2}) −2✓ +3✓({1,3}) −3✓({1}) −1? +2✓ +3✓({2,3}) −3✓({2}) −2*} edges{root-I= I-II= II-III= II-IIO= I-IO= IO-IOI= IO-IOO= root-O~ O-OI= OI-OII= OI-OIO= O-OO~} @OO | calls[backtrack(0){"i":0} > backtrack(1){"i":1} > backtrack(2)*{"i":2}] | vars{"찾은 부분집합":["[1, 2, 3]","[1, 2]","[1, 3]","[1]","[2, 3]","[2]"],"개수":6}
#25 choose L3 3 값을 넣는 쪽으로 가요 → path = [3]
    path=[3] | graph{시작? +1✓ +2✓ +3✓({1,2,3}) −3✓({1,2}) −2✓ +3✓({1,3}) −3✓({1}) −1? +2✓ +3✓({2,3}) −3✓({2}) −2? +3*} edges{root-I= I-II= II-III= II-IIO= I-IO= IO-IOI= IO-IOO= root-O~ O-OI= OI-OII= OI-OIO= O-OO~ OO-OOI~} @OOI | calls[backtrack(0){"i":0} > backtrack(1){"i":1} > backtrack(2){"i":2} > backtrack(3)*{"i":3}] | vars{"찾은 부분집합":["[1, 2, 3]","[1, 2]","[1, 3]","[1]","[2, 3]","[2]"],"개수":6}
#26 record L2 모든 원소를 정했어요 → 부분집합 {3} 기록
    path=[3] | graph{시작? +1✓ +2✓ +3✓({1,2,3}) −3✓({1,2}) −2✓ +3✓({1,3}) −3✓({1}) −1? +2✓ +3✓({2,3}) −3✓({2}) −2? +3*({3})} edges{root-I= I-II= II-III= II-IIO= I-IO= IO-IOI= IO-IOO= root-O~ O-OI= OI-OII= OI-OIO= O-OO~ OO-OOI=} @OOI | calls[backtrack(0){"i":0} > backtrack(1){"i":1} > backtrack(2){"i":2} > backtrack(3)*{"i":3}] | vars{"찾은 부분집합":["[1, 2, 3]","[1, 2]","[1, 3]","[1]","[2, 3]","[2]","[3]"],"개수":7}
#27 unchoose L5 되돌리기: path에서 3 빼기 → path = []
    path=[] | graph{시작? +1✓ +2✓ +3✓({1,2,3}) −3✓({1,2}) −2✓ +3✓({1,3}) −3✓({1}) −1? +2✓ +3✓({2,3}) −3✓({2}) −2* +3✓({3})} edges{root-I= I-II= II-III= II-IIO= I-IO= IO-IOI= IO-IOO= root-O~ O-OI= OI-OII= OI-OIO= O-OO~ OO-OOI=} @OO | calls[backtrack(0){"i":0} > backtrack(1){"i":1} > backtrack(2)*{"i":2}] | vars{"찾은 부분집합":["[1, 2, 3]","[1, 2]","[1, 3]","[1]","[2, 3]","[2]","[3]"],"개수":7}
#28 choose L6 이번엔 3 값을 넣지 않는 쪽으로 가요
    path=[] | graph{시작? +1✓ +2✓ +3✓({1,2,3}) −3✓({1,2}) −2✓ +3✓({1,3}) −3✓({1}) −1? +2✓ +3✓({2,3}) −3✓({2}) −2? +3✓({3}) −3*} edges{root-I= I-II= II-III= II-IIO= I-IO= IO-IOI= IO-IOO= root-O~ O-OI= OI-OII= OI-OIO= O-OO~ OO-OOI= OO-OOO~} @OOO | calls[backtrack(0){"i":0} > backtrack(1){"i":1} > backtrack(2){"i":2} > backtrack(3)*{"i":3}] | vars{"찾은 부분집합":["[1, 2, 3]","[1, 2]","[1, 3]","[1]","[2, 3]","[2]","[3]"],"개수":7}
#29 record L2 모든 원소를 정했어요 → 부분집합 {} 기록
    path=[] | graph{시작? +1✓ +2✓ +3✓({1,2,3}) −3✓({1,2}) −2✓ +3✓({1,3}) −3✓({1}) −1? +2✓ +3✓({2,3}) −3✓({2}) −2? +3✓({3}) −3*({})} edges{root-I= I-II= II-III= II-IIO= I-IO= IO-IOI= IO-IOO= root-O~ O-OI= OI-OII= OI-OIO= O-OO~ OO-OOI= OO-OOO=} @OOO | calls[backtrack(0){"i":0} > backtrack(1){"i":1} > backtrack(2){"i":2} > backtrack(3)*{"i":3}] | vars{"찾은 부분집합":["[1, 2, 3]","[1, 2]","[1, 3]","[1]","[2, 3]","[2]","[3]","[]"],"개수":8}
#30 done L- 부분집합은 모두 8개 (2^3 = 8). 트리의 잎 하나가 부분집합 하나예요.
    path=[] | graph{시작✓ +1✓ +2✓ +3✓({1,2,3}) −3✓({1,2}) −2✓ +3✓({1,3}) −3✓({1}) −1✓ +2✓ +3✓({2,3}) −3✓({2}) −2✓ +3✓({3}) −3✓({})} edges{root-I= I-II= II-III= II-IIO= I-IO= IO-IOI= IO-IOO= root-O= O-OI= OI-OII= OI-OIO= O-OO= OO-OOI= OO-OOO=} | calls[] | vars{"찾은 부분집합":["[1, 2, 3]","[1, 2]","[1, 3]","[1]","[2, 3]","[2]","[3]","[]"],"개수":8}"
`;

exports[`프리셋 tp-dedupe-9 > 스텝 흐름 스냅샷 1`] = `
"#0 init L1 첫 칸은 그대로 두고, 읽는 손가락으로 훑으며 새 값만 앞쪽에 써요.
    a (앞쪽 초록 = 중복 없는 결과)=|1✓ 1 2 3 3 3 5 8 8| 쓰기@1 | vars{"결과 길이 w":1,"결과":"1"}
#1 skip L5 같은 값(1) → 건너뛰기
    a (앞쪽 초록 = 중복 없는 결과)=|1✓ 1✗ 2 3 3 3 5 8 8| 쓰기·읽기@1 | vars{"결과 길이 w":1,"결과":"1"}
#2 pick L4 새 값 2 → 1번 칸에 쓰기
    a (앞쪽 초록 = 중복 없는 결과)=|1✓ 2*✓ 2 3 3 3 5 8 8| 쓰기·읽기@2 | vars{"결과 길이 w":2,"결과":"1, 2"}
#3 pick L4 새 값 3 → 2번 칸에 쓰기
    a (앞쪽 초록 = 중복 없는 결과)=|1✓ 2✓ 3*✓ 3 3 3 5 8 8| 쓰기·읽기@3 | vars{"결과 길이 w":3,"결과":"1, 2, 3"}
#4 skip L5 같은 값(3) → 건너뛰기
    a (앞쪽 초록 = 중복 없는 결과)=|1✓ 2✓ 3✓ 3 3✗ 3 5 8 8| 쓰기@3,읽기@4 | vars{"결과 길이 w":3,"결과":"1, 2, 3"}
#5 skip L5 같은 값(3) → 건너뛰기
    a (앞쪽 초록 = 중복 없는 결과)=|1✓ 2✓ 3✓ 3 3 3✗ 5 8 8| 쓰기@3,읽기@5 | vars{"결과 길이 w":3,"결과":"1, 2, 3"}
#6 pick L4 새 값 5 → 3번 칸에 쓰기
    a (앞쪽 초록 = 중복 없는 결과)=|1✓ 2✓ 3✓ 5*✓ 3 3 5 8 8| 쓰기@4,읽기@6 | vars{"결과 길이 w":4,"결과":"1, 2, 3, 5"}
#7 pick L4 새 값 8 → 4번 칸에 쓰기
    a (앞쪽 초록 = 중복 없는 결과)=|1✓ 2✓ 3✓ 5✓ 8*✓ 3 5 8 8| 쓰기@5,읽기@7 | vars{"결과 길이 w":5,"결과":"1, 2, 3, 5, 8"}
#8 skip L5 같은 값(8) → 건너뛰기
    a (앞쪽 초록 = 중복 없는 결과)=|1✓ 2✓ 3✓ 5✓ 8✓ 3 5 8 8✗| 쓰기@5,읽기@8 | vars{"결과 길이 w":5,"결과":"1, 2, 3, 5, 8"}
#9 done L6 중복 없는 결과: [1, 2, 3, 5, 8] — 새 배열 없이 한 번 훑어서 끝냈어요.
    a (앞쪽 초록 = 중복 없는 결과)=|1✓ 2✓ 3✓ 5✓ 8✓ 3 5 8 8| 쓰기@5 | vars{"결과 길이 w":5,"결과":"1, 2, 3, 5, 8"}"
`;

exports[`프리셋 tp-min-window-7 > 스텝 흐름 스냅샷 1`] = `
"#0 init L1 합 ≥ 7인 연속 구간 중 가장 짧은 것을 찾아요. 창을 오른쪽으로 늘려요.
    a=|2 3 1 2 4 3| L@0 | vars{"S":7,"창의 합":0,"가장짧은길이":"(아직 없음)"}
#1 move-right L3 오른쪽을 늘려 2 넣기 → 창의 합 2
    a=|2* 3 1 2 4 3| range=0..0 L·R@0 | vars{"S":7,"창의 합":2,"가장짧은길이":"(아직 없음)"}
#2 move-right L3 오른쪽을 늘려 3 넣기 → 창의 합 5
    a=|2 3* 1 2 4 3| range=0..1 L@0,R@1 | vars{"S":7,"창의 합":5,"가장짧은길이":"(아직 없음)"}
#3 move-right L3 오른쪽을 늘려 1 넣기 → 창의 합 6
    a=|2 3 1* 2 4 3| range=0..2 L@0,R@2 | vars{"S":7,"창의 합":6,"가장짧은길이":"(아직 없음)"}
#4 move-right L3 오른쪽을 늘려 2 넣기 → 창의 합 8
    a=|2 3 1 2* 4 3| range=0..3 L@0,R@3 | vars{"S":7,"창의 합":8,"가장짧은길이":"(아직 없음)"}
#5 record L5 합 8 ≥ 7 → 길이 4 (지금까지 가장 짧아요)
    a=|2! 3! 1! 2! 4 3| range=0..3 L@0,R@3 | vars{"S":7,"창의 합":8,"가장짧은길이":4}
#6 move-left L6 더 짧게 만들어 봐요 → 왼쪽의 2 빼기 → 창의 합 6
    a=|2 3 1 2 4 3| range=1..3 L@1,R@3 | vars{"S":7,"창의 합":6,"가장짧은길이":4}
#7 move-right L3 오른쪽을 늘려 4 넣기 → 창의 합 10
    a=|2 3 1 2 4* 3| range=1..4 L@1,R@4 | vars{"S":7,"창의 합":10,"가장짧은길이":4}
#8 record L5 합 10 ≥ 7 → 길이 4 (지금까지 가장 짧아요)
    a=|2 3! 1! 2! 4! 3| range=1..4 L@1,R@4 | vars{"S":7,"창의 합":10,"가장짧은길이":4}
#9 move-left L6 더 짧게 만들어 봐요 → 왼쪽의 3 빼기 → 창의 합 7
    a=|2 3 1 2 4 3| range=2..4 L@2,R@4 | vars{"S":7,"창의 합":7,"가장짧은길이":4}
#10 record L5 합 7 ≥ 7 → 길이 3 (지금까지 가장 짧아요)
    a=|2 3 1! 2! 4! 3| range=2..4 L@2,R@4 | vars{"S":7,"창의 합":7,"가장짧은길이":3}
#11 move-left L6 더 짧게 만들어 봐요 → 왼쪽의 1 빼기 → 창의 합 6
    a=|2 3 1 2 4 3| range=3..4 L@3,R@4 | vars{"S":7,"창의 합":6,"가장짧은길이":3}
#12 move-right L3 오른쪽을 늘려 3 넣기 → 창의 합 9
    a=|2 3 1 2 4 3*| range=3..5 L@3,R@5 | vars{"S":7,"창의 합":9,"가장짧은길이":3}
#13 record L5 합 9 ≥ 7 → 길이 3 (지금까지 가장 짧아요)
    a=|2 3 1 2! 4! 3!| range=3..5 L@3,R@5 | vars{"S":7,"창의 합":9,"가장짧은길이":3}
#14 move-left L6 더 짧게 만들어 봐요 → 왼쪽의 2 빼기 → 창의 합 7
    a=|2 3 1 2 4 3| range=4..5 L@4,R@5 | vars{"S":7,"창의 합":7,"가장짧은길이":3}
#15 record L5 합 7 ≥ 7 → 길이 2 (지금까지 가장 짧아요)
    a=|2 3 1 2 4! 3!| range=4..5 L@4,R@5 | vars{"S":7,"창의 합":7,"가장짧은길이":2}
#16 move-left L6 더 짧게 만들어 봐요 → 왼쪽의 4 빼기 → 창의 합 3
    a=|2 3 1 2 4 3| range=5..5 L·R@5 | vars{"S":7,"창의 합":3,"가장짧은길이":2}
#17 done L7 가장 짧은 구간: [4..5], 길이 2. 칸마다 한 번 넣고 한 번 뺐을 뿐이에요.
    a=|2 3 1 2 4! 3!| | vars{"S":7,"가장짧은길이":2}"
`;

exports[`프리셋 tp-pair-sum-20 > 스텝 흐름 스냅샷 1`] = `
"#0 init L1 양 끝에 손가락을 하나씩 둬요. 합 = 20인 두 수를 찾아요.
    a (정렬됨)=|1 2 4 6 9 11 14 17| range=0..7 L@0,R@7 | vars{"target":20,"L":0,"R":7}
#1 compare L3 1 + 17 = 18
    a (정렬됨)=|1* 2 4 6 9 11 14 17*| range=0..7 L@0,R@7 | vars{"target":20,"L":0,"R":7,"a[L] + a[R]":18}
#2 move-left L5 합이 작아요 → 왼쪽 손가락을 오른쪽으로 (더 큰 수로)
    a (정렬됨)=|1 2 4 6 9 11 14 17| range=1..7 L@1,R@7 | vars{"target":20,"L":1,"R":7}
#3 compare L3 2 + 17 = 19
    a (정렬됨)=|1 2* 4 6 9 11 14 17*| range=1..7 L@1,R@7 | vars{"target":20,"L":1,"R":7,"a[L] + a[R]":19}
#4 move-left L5 합이 작아요 → 왼쪽 손가락을 오른쪽으로 (더 큰 수로)
    a (정렬됨)=|1 2 4 6 9 11 14 17| range=2..7 L@2,R@7 | vars{"target":20,"L":2,"R":7}
#5 compare L3 4 + 17 = 21
    a (정렬됨)=|1 2 4* 6 9 11 14 17*| range=2..7 L@2,R@7 | vars{"target":20,"L":2,"R":7,"a[L] + a[R]":21}
#6 move-right L6 합이 커요 → 오른쪽 손가락을 왼쪽으로 (더 작은 수로)
    a (정렬됨)=|1 2 4 6 9 11 14 17| range=2..6 L@2,R@6 | vars{"target":20,"L":2,"R":6}
#7 compare L3 4 + 14 = 18
    a (정렬됨)=|1 2 4* 6 9 11 14* 17| range=2..6 L@2,R@6 | vars{"target":20,"L":2,"R":6,"a[L] + a[R]":18}
#8 move-left L5 합이 작아요 → 왼쪽 손가락을 오른쪽으로 (더 큰 수로)
    a (정렬됨)=|1 2 4 6 9 11 14 17| range=3..6 L@3,R@6 | vars{"target":20,"L":3,"R":6}
#9 compare L3 6 + 14 = 20
    a (정렬됨)=|1 2 4 6* 9 11 14* 17| range=3..6 L@3,R@6 | vars{"target":20,"L":3,"R":6,"a[L] + a[R]":20}
#10 found L4 합이 딱 맞아요! 위치 [3, 6]
    a (정렬됨)=|1 2 4 6! 9 11 14! 17| range=3..6 L@3,R@6 | vars{"target":20,"L":3,"R":6,"a[L] + a[R]":20}
#11 done L- 모든 쌍을 비교하지 않고 5번만 비교했어요.
    a (정렬됨)=|1 2 4 6 9 11 14 17| range=3..6 L@3,R@6 | vars{"target":20,"L":3,"R":6,"a[L] + a[R]":20}"
`;

exports[`프리셋 two-door-ex1 > 스텝 흐름 스냅샷 1`] = `
"#0 init L1 빈 덱에서 시작해요. 앞과 뒤 양쪽에서 모두 넣고 뺄 수 있어요.
    명령=<push_back 1 push_back 2 push_front 3 pop_back> cur=- done=0 | deque=[] | vars{"크기":0}
#1 push-back L3 push_back(1): 맨 뒤에 넣었어요
    명령=<push_back 1* push_back 2 push_front 3 pop_back> cur=0 done=0 | deque=[1*] | vars{"크기":1}
#2 push-back L3 push_back(2): 맨 뒤에 넣었어요
    명령=<push_back 1 push_back 2* push_front 3 pop_back> cur=1 done=1 | deque=[1,2*] | vars{"크기":2}
#3 push-front L3 push_front(3): 맨 앞에 넣었어요
    명령=<push_back 1 push_back 2 push_front 3* pop_back> cur=2 done=2 | deque=[3*,1,2] | vars{"크기":3}
#4 pop-back L4 pop_back(): 맨 뒤 값 2 꺼내기
    명령=<push_back 1 push_back 2 push_front 3 pop_back*> cur=3 done=3 | deque=[3,1] | vars{"크기":2,"꺼낸 값":2}
#5 done L- 명령을 모두 처리했어요. 남은 값 (앞 → 뒤): [3, 1]
    명령=<push_back 1 push_back 2 push_front 3 pop_back> cur=- done=4 | deque=[3,1] | vars{"크기":2}"
`;

exports[`프리셋 two-pointers-shortest-enough-ex1 > 스텝 흐름 스냅샷 1`] = `
