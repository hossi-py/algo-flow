    queue=[(2, 0)] | grid zone=1100/1000/1000 cur=0,1 chk=1,1:blocked dist=0,1,-,-/1,-,-,-/2,-,-,- | vars{"큐 길이":1}
#10 check L6 왼쪽 (0, 0) 칸은 이미 발견했어요 → 건너뛰기
    queue=[(2, 0)] | grid zone=1100/1000/1000 cur=0,1 chk=0,0:visited dist=0,1,-,-/1,-,-,-/2,-,-,- | vars{"큐 길이":1}
