    queue=[(3, 2)] | grid zone=11000/11000/01100/00100/00000 cur=2,2 chk=3,2:go dist=0,1,-,-,-/1,2,-,-,-/-,3,4,-,-/-,-,5,-,-/-,-,-,-,- | vars{"큐 길이":1}
#25 check L6 왼쪽 (2, 1) 칸은 이미 발견했어요 → 건너뛰기
    queue=[(3, 2)] | grid zone=11000/11000/01100/00100/00000 cur=2,2 chk=2,1:visited dist=0,1,-,-,-/1,2,-,-,-/-,3,4,-,-/-,-,5,-,-/-,-,-,-,- | vars{"큐 길이":1}
#26 discover L8 오른쪽 (2, 3) 칸을 처음 발견! 거리 5, 큐 뒤에 넣어요
    queue=[(3, 2),(2, 3)] | grid zone=11000/11000/01110/00100/00000 cur=2,2 chk=2,3:go dist=0,1,-,-,-/1,2,-,-,-/-,3,4,5,-/-,-,5,-,-/-,-,-,-,- | vars{"큐 길이":2}
#27 dequeue L3 큐 맨 앞의 (3, 2) 칸을 꺼내요 (거리 5)
    queue=[(2, 3)] | grid zone=11000/11000/01110/00100/00000 cur=3,2 dist=0,1,-,-,-/1,2,-,-,-/-,3,4,5,-/-,-,5,-,-/-,-,-,-,- | vars{"큐 길이":1}
#28 check L6 위 (2, 2) 칸은 이미 발견했어요 → 건너뛰기
    queue=[(2, 3)] | grid zone=11000/11000/01110/00100/00000 cur=3,2 chk=2,2:visited dist=0,1,-,-,-/1,2,-,-,-/-,3,4,5,-/-,-,5,-,-/-,-,-,-,- | vars{"큐 길이":1}
#29 discover L8 아래 (4, 2) 칸을 처음 발견! 거리 6, 큐 뒤에 넣어요
    queue=[(2, 3),(4, 2)] | grid zone=11000/11000/01110/00100/00100 cur=3,2 chk=4,2:go dist=0,1,-,-,-/1,2,-,-,-/-,3,4,5,-/-,-,5,-,-/-,-,6,-,- | vars{"큐 길이":2}
#30 check L6 왼쪽 (3, 1) 칸은 벽 → 건너뛰기
    queue=[(2, 3),(4, 2)] | grid zone=11000/11000/01110/00100/00100 cur=3,2 chk=3,1:blocked dist=0,1,-,-,-/1,2,-,-,-/-,3,4,5,-/-,-,5,-,-/-,-,6,-,- | vars{"큐 길이":2}
#31 check L6 오른쪽 (3, 3) 칸은 벽 → 건너뛰기
    queue=[(2, 3),(4, 2)] | grid zone=11000/11000/01110/00100/00100 cur=3,2 chk=3,3:blocked dist=0,1,-,-,-/1,2,-,-,-/-,3,4,5,-/-,-,5,-,-/-,-,6,-,- | vars{"큐 길이":2}
#32 dequeue L3 큐 맨 앞의 (2, 3) 칸을 꺼내요 (거리 5)
    queue=[(4, 2)] | grid zone=11000/11000/01110/00100/00100 cur=2,3 dist=0,1,-,-,-/1,2,-,-,-/-,3,4,5,-/-,-,5,-,-/-,-,6,-,- | vars{"큐 길이":1}
#33 discover L8 위 (1, 3) 칸을 처음 발견! 거리 6, 큐 뒤에 넣어요
    queue=[(4, 2),(1, 3)] | grid zone=11000/11010/01110/00100/00100 cur=2,3 chk=1,3:go dist=0,1,-,-,-/1,2,-,6,-/-,3,4,5,-/-,-,5,-,-/-,-,6,-,- | vars{"큐 길이":2}
#34 check L6 아래 (3, 3) 칸은 벽 → 건너뛰기
    queue=[(4, 2),(1, 3)] | grid zone=11000/11010/01110/00100/00100 cur=2,3 chk=3,3:blocked dist=0,1,-,-,-/1,2,-,6,-/-,3,4,5,-/-,-,5,-,-/-,-,6,-,- | vars{"큐 길이":2}
#35 check L6 왼쪽 (2, 2) 칸은 이미 발견했어요 → 건너뛰기
    queue=[(4, 2),(1, 3)] | grid zone=11000/11010/01110/00100/00100 cur=2,3 chk=2,2:visited dist=0,1,-,-,-/1,2,-,6,-/-,3,4,5,-/-,-,5,-,-/-,-,6,-,- | vars{"큐 길이":2}
