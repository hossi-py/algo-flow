exports[`프리셋 sushi-rail-rotate > 스텝 흐름 스냅샷 1`] = `
"#0 init L1 빈 덱에서 시작해요. 앞과 뒤 양쪽에서 모두 넣고 뺄 수 있어요.
    명령=<push_back 1 push_back 2 push_back 3 push_back 4 pop_back push_front 4 pop_front> cur=- done=0 | deque=[] | vars{"크기":0}
#1 push-back L3 push_back(1): 맨 뒤에 넣었어요
    명령=<push_back 1* push_back 2 push_back 3 push_back 4 pop_back push_front 4 pop_front> cur=0 done=0 | deque=[1*] | vars{"크기":1}
#2 push-back L3 push_back(2): 맨 뒤에 넣었어요
    명령=<push_back 1 push_back 2* push_back 3 push_back 4 pop_back push_front 4 pop_front> cur=1 done=1 | deque=[1,2*] | vars{"크기":2}
#3 push-back L3 push_back(3): 맨 뒤에 넣었어요
