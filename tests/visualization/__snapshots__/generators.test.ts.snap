`;

exports[`프리셋 sushi-rail-rotate > 스텝 흐름 스냅샷 1`] = `
"#0 init L1 빈 덱에서 시작해요. 앞과 뒤 양쪽에서 모두 넣고 뺄 수 있어요.
    명령=<push_back 1 push_back 2 push_back 3 push_back 4 pop_back push_front 4 pop_front> cur=- done=0 | deque=[] | vars{"크기":0}
#1 push-back L3 push_back(1): 맨 뒤에 넣었어요
    명령=<push_back 1* push_back 2 push_back 3 push_back 4 pop_back push_front 4 pop_front> cur=0 done=0 | deque=[1*] | vars{"크기":1}
#2 push-back L3 push_back(2): 맨 뒤에 넣었어요
    명령=<push_back 1 push_back 2* push_back 3 push_back 4 pop_back push_front 4 pop_front> cur=1 done=1 | deque=[1,2*] | vars{"크기":2}
#3 push-back L3 push_back(3): 맨 뒤에 넣었어요
    명령=<push_back 1 push_back 2 push_back 3* push_back 4 pop_back push_front 4 pop_front> cur=2 done=2 | deque=[1,2,3*] | vars{"크기":3}
#4 push-back L3 push_back(4): 맨 뒤에 넣었어요
    명령=<push_back 1 push_back 2 push_back 3 push_back 4* pop_back push_front 4 pop_front> cur=3 done=3 | deque=[1,2,3,4*] | vars{"크기":4}
#5 pop-back L4 pop_back(): 맨 뒤 값 4 꺼내기
    명령=<push_back 1 push_back 2 push_back 3 push_back 4 pop_back* push_front 4 pop_front> cur=4 done=4 | deque=[1,2,3] | vars{"크기":3,"꺼낸 값":4}
#6 push-front L3 push_front(4): 맨 앞에 넣었어요
    명령=<push_back 1 push_back 2 push_back 3 push_back 4 pop_back push_front 4* pop_front> cur=5 done=5 | deque=[4*,1,2,3] | vars{"크기":4}
#7 pop-front L4 pop_front(): 맨 앞 값 4 꺼내기
    명령=<push_back 1 push_back 2 push_back 3 push_back 4 pop_back push_front 4 pop_front*> cur=6 done=6 | deque=[1,2,3] | vars{"크기":3,"꺼낸 값":4}
#8 done L- 명령을 모두 처리했어요. 남은 값 (앞 → 뒤): [1, 2, 3]
    명령=<push_back 1 push_back 2 push_back 3 push_back 4 pop_back push_front 4 pop_front> cur=- done=7 | deque=[1,2,3] | vars{"크기":3}"
`;

