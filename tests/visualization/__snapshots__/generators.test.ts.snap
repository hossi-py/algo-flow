#16 check L5 이웃 3번은 이미 방문했어요 → 건너뛰기
    graph{0?#1 1?#2 2✓#4 3?#3 4*#5 5.} edges{0-1= 0-2x 1-3= 2-3= 3-4~} @4 | calls[dfs(0){"v":0} > dfs(1){"v":1} > dfs(3){"v":3} > dfs(4)*{"v":4}] | vars{"방문 순서":[0,1,3,2,4]}
#17 check L6 이웃 5번은 아직 방문하지 않았어요 → dfs(5) 호출
    graph{0?#1 1?#2 2✓#4 3?#3 4*#5 5.} edges{0-1= 0-2x 1-3= 2-3= 3-4= 4-5~} @4 | calls[dfs(0){"v":0} > dfs(1){"v":1} > dfs(3){"v":3} > dfs(4)*{"v":4}] | vars{"방문 순서":[0,1,3,2,4]}
#18 visit L3 dfs(5): 5번 노드에 방문 표시 (방문 순서 6)
    graph{0?#1 1?#2 2✓#4 3?#3 4?#5 5*#6} edges{0-1= 0-2x 1-3= 2-3= 3-4= 4-5=} @5 | calls[dfs(0){"v":0} > dfs(1){"v":1} > dfs(3){"v":3} > dfs(4){"v":4} > dfs(5)*{"v":5}] | vars{"방문 순서":[0,1,3,2,4,5]}
#19 check L5 이웃 4번은 이미 방문했어요 → 건너뛰기
