exports[`프리셋 snack-subset-tree > 스텝 흐름 스냅샷 1`] = `
"#0 init L1 [1, 2, 3]의 원소마다 "넣는다 / 안 넣는다"를 정하며 내려가요.
    path=[] | graph{시작*} @root | calls[backtrack(0)*{"i":0}] | vars{"찾은 부분집합":[],"개수":0}
#1 choose L3 1 값을 넣는 쪽으로 가요 → path = [1]
    path=[1] | graph{시작? +1*} edges{root-I~} @I | calls[backtrack(0){"i":0} > backtrack(1)*{"i":1}] | vars{"찾은 부분집합":[],"개수":0}
#2 choose L3 2 값을 넣는 쪽으로 가요 → path = [1, 2]
    path=[1,2] | graph{시작? +1? +2*} edges{root-I~ I-II~} @II | calls[backtrack(0){"i":0} > backtrack(1){"i":1} > backtrack(2)*{"i":2}] | vars{"찾은 부분집합":[],"개수":0}
#3 choose L3 3 값을 넣는 쪽으로 가요 → path = [1, 2, 3]
    path=[1,2,3] | graph{시작? +1? +2? +3*} edges{root-I~ I-II~ II-III~} @III | calls[backtrack(0){"i":0} > backtrack(1){"i":1} > backtrack(2){"i":2} > backtrack(3)*{"i":3}] | vars{"찾은 부분집합":[],"개수":0}
#4 record L2 모든 원소를 정했어요 → 부분집합 {1, 2, 3} 기록
    path=[1,2,3] | graph{시작? +1? +2? +3*({1,2,3})} edges{root-I~ I-II~ II-III=} @III | calls[backtrack(0){"i":0} > backtrack(1){"i":1} > backtrack(2){"i":2} > backtrack(3)*{"i":3}] | vars{"찾은 부분집합":["[1, 2, 3]"],"개수":1}
#5 unchoose L5 되돌리기: path에서 3 빼기 → path = [1, 2]
    path=[1,2] | graph{시작? +1? +2* +3✓({1,2,3})} edges{root-I~ I-II~ II-III=} @II | calls[backtrack(0){"i":0} > backtrack(1){"i":1} > backtrack(2)*{"i":2}] | vars{"찾은 부분집합":["[1, 2, 3]"],"개수":1}
#6 choose L6 이번엔 3 값을 넣지 않는 쪽으로 가요
    path=[1,2] | graph{시작? +1? +2? +3✓({1,2,3}) −3*} edges{root-I~ I-II~ II-III= II-IIO~} @IIO | calls[backtrack(0){"i":0} > backtrack(1){"i":1} > backtrack(2){"i":2} > backtrack(3)*{"i":3}] | vars{"찾은 부분집합":["[1, 2, 3]"],"개수":1}
#7 record L2 모든 원소를 정했어요 → 부분집합 {1, 2} 기록
    path=[1,2] | graph{시작? +1? +2? +3✓({1,2,3}) −3*({1,2})} edges{root-I~ I-II~ II-III= II-IIO=} @IIO | calls[backtrack(0){"i":0} > backtrack(1){"i":1} > backtrack(2){"i":2} > backtrack(3)*{"i":3}] | vars{"찾은 부분집합":["[1, 2, 3]","[1, 2]"],"개수":2}
#8 unchoose L5 되돌리기: path에서 2 빼기 → path = [1]
    path=[1] | graph{시작? +1* +2✓ +3✓({1,2,3}) −3✓({1,2})} edges{root-I~ I-II= II-III= II-IIO=} @I | calls[backtrack(0){"i":0} > backtrack(1)*{"i":1}] | vars{"찾은 부분집합":["[1, 2, 3]","[1, 2]"],"개수":2}
#9 choose L6 이번엔 2 값을 넣지 않는 쪽으로 가요
    path=[1] | graph{시작? +1? +2✓ +3✓({1,2,3}) −3✓({1,2}) −2*} edges{root-I~ I-II= II-III= II-IIO= I-IO~} @IO | calls[backtrack(0){"i":0} > backtrack(1){"i":1} > backtrack(2)*{"i":2}] | vars{"찾은 부분집합":["[1, 2, 3]","[1, 2]"],"개수":2}
#10 choose L3 3 값을 넣는 쪽으로 가요 → path = [1, 3]
    path=[1,3] | graph{시작? +1? +2✓ +3✓({1,2,3}) −3✓({1,2}) −2? +3*} edges{root-I~ I-II= II-III= II-IIO= I-IO~ IO-IOI~} @IOI | calls[backtrack(0){"i":0} > backtrack(1){"i":1} > backtrack(2){"i":2} > backtrack(3)*{"i":3}] | vars{"찾은 부분집합":["[1, 2, 3]","[1, 2]"],"개수":2}
#11 record L2 모든 원소를 정했어요 → 부분집합 {1, 3} 기록
    path=[1,3] | graph{시작? +1? +2✓ +3✓({1,2,3}) −3✓({1,2}) −2? +3*({1,3})} edges{root-I~ I-II= II-III= II-IIO= I-IO~ IO-IOI=} @IOI | calls[backtrack(0){"i":0} > backtrack(1){"i":1} > backtrack(2){"i":2} > backtrack(3)*{"i":3}] | vars{"찾은 부분집합":["[1, 2, 3]","[1, 2]","[1, 3]"],"개수":3}
#12 unchoose L5 되돌리기: path에서 3 빼기 → path = [1]
    path=[1] | graph{시작? +1? +2✓ +3✓({1,2,3}) −3✓({1,2}) −2* +3✓({1,3})} edges{root-I~ I-II= II-III= II-IIO= I-IO~ IO-IOI=} @IO | calls[backtrack(0){"i":0} > backtrack(1){"i":1} > backtrack(2)*{"i":2}] | vars{"찾은 부분집합":["[1, 2, 3]","[1, 2]","[1, 3]"],"개수":3}
#13 choose L6 이번엔 3 값을 넣지 않는 쪽으로 가요
    path=[1] | graph{시작? +1? +2✓ +3✓({1,2,3}) −3✓({1,2}) −2? +3✓({1,3}) −3*} edges{root-I~ I-II= II-III= II-IIO= I-IO~ IO-IOI= IO-IOO~} @IOO | calls[backtrack(0){"i":0} > backtrack(1){"i":1} > backtrack(2){"i":2} > backtrack(3)*{"i":3}] | vars{"찾은 부분집합":["[1, 2, 3]","[1, 2]","[1, 3]"],"개수":3}
#14 record L2 모든 원소를 정했어요 → 부분집합 {1} 기록
    path=[1] | graph{시작? +1? +2✓ +3✓({1,2,3}) −3✓({1,2}) −2? +3✓({1,3}) −3*({1})} edges{root-I~ I-II= II-III= II-IIO= I-IO~ IO-IOI= IO-IOO=} @IOO | calls[backtrack(0){"i":0} > backtrack(1){"i":1} > backtrack(2){"i":2} > backtrack(3)*{"i":3}] | vars{"찾은 부분집합":["[1, 2, 3]","[1, 2]","[1, 3]","[1]"],"개수":4}
#15 unchoose L5 되돌리기: path에서 1 빼기 → path = []
    path=[] | graph{시작* +1✓ +2✓ +3✓({1,2,3}) −3✓({1,2}) −2✓ +3✓({1,3}) −3✓({1})} edges{root-I= I-II= II-III= II-IIO= I-IO= IO-IOI= IO-IOO=} @root | calls[backtrack(0)*{"i":0}] | vars{"찾은 부분집합":["[1, 2, 3]","[1, 2]","[1, 3]","[1]"],"개수":4}
#16 choose L6 이번엔 1 값을 넣지 않는 쪽으로 가요
    path=[] | graph{시작? +1✓ +2✓ +3✓({1,2,3}) −3✓({1,2}) −2✓ +3✓({1,3}) −3✓({1}) −1*} edges{root-I= I-II= II-III= II-IIO= I-IO= IO-IOI= IO-IOO= root-O~} @O | calls[backtrack(0){"i":0} > backtrack(1)*{"i":1}] | vars{"찾은 부분집합":["[1, 2, 3]","[1, 2]","[1, 3]","[1]"],"개수":4}
#17 choose L3 2 값을 넣는 쪽으로 가요 → path = [2]
    path=[2] | graph{시작? +1✓ +2✓ +3✓({1,2,3}) −3✓({1,2}) −2✓ +3✓({1,3}) −3✓({1}) −1? +2*} edges{root-I= I-II= II-III= II-IIO= I-IO= IO-IOI= IO-IOO= root-O~ O-OI~} @OI | calls[backtrack(0){"i":0} > backtrack(1){"i":1} > backtrack(2)*{"i":2}] | vars{"찾은 부분집합":["[1, 2, 3]","[1, 2]","[1, 3]","[1]"],"개수":4}
#18 choose L3 3 값을 넣는 쪽으로 가요 → path = [2, 3]
    path=[2,3] | graph{시작? +1✓ +2✓ +3✓({1,2,3}) −3✓({1,2}) −2✓ +3✓({1,3}) −3✓({1}) −1? +2? +3*} edges{root-I= I-II= II-III= II-IIO= I-IO= IO-IOI= IO-IOO= root-O~ O-OI~ OI-OII~} @OII | calls[backtrack(0){"i":0} > backtrack(1){"i":1} > backtrack(2){"i":2} > backtrack(3)*{"i":3}] | vars{"찾은 부분집합":["[1, 2, 3]","[1, 2]","[1, 3]","[1]"],"개수":4}
#19 record L2 모든 원소를 정했어요 → 부분집합 {2, 3} 기록
    path=[2,3] | graph{시작? +1✓ +2✓ +3✓({1,2,3}) −3✓({1,2}) −2✓ +3✓({1,3}) −3✓({1}) −1? +2? +3*({2,3})} edges{root-I= I-II= II-III= II-IIO= I-IO= IO-IOI= IO-IOO= root-O~ O-OI~ OI-OII=} @OII | calls[backtrack(0){"i":0} > backtrack(1){"i":1} > backtrack(2){"i":2} > backtrack(3)*{"i":3}] | vars{"찾은 부분집합":["[1, 2, 3]","[1, 2]","[1, 3]","[1]","[2, 3]"],"개수":5}
#20 unchoose L5 되돌리기: path에서 3 빼기 → path = [2]
    path=[2] | graph{시작? +1✓ +2✓ +3✓({1,2,3}) −3✓({1,2}) −2✓ +3✓({1,3}) −3✓({1}) −1? +2* +3✓({2,3})} edges{root-I= I-II= II-III= II-IIO= I-IO= IO-IOI= IO-IOO= root-O~ O-OI~ OI-OII=} @OI | calls[backtrack(0){"i":0} > backtrack(1){"i":1} > backtrack(2)*{"i":2}] | vars{"찾은 부분집합":["[1, 2, 3]","[1, 2]","[1, 3]","[1]","[2, 3]"],"개수":5}
#21 choose L6 이번엔 3 값을 넣지 않는 쪽으로 가요
    path=[2] | graph{시작? +1✓ +2✓ +3✓({1,2,3}) −3✓({1,2}) −2✓ +3✓({1,3}) −3✓({1}) −1? +2? +3✓({2,3}) −3*} edges{root-I= I-II= II-III= II-IIO= I-IO= IO-IOI= IO-IOO= root-O~ O-OI~ OI-OII= OI-OIO~} @OIO | calls[backtrack(0){"i":0} > backtrack(1){"i":1} > backtrack(2){"i":2} > backtrack(3)*{"i":3}] | vars{"찾은 부분집합":["[1, 2, 3]","[1, 2]","[1, 3]","[1]","[2, 3]"],"개수":5}
#22 record L2 모든 원소를 정했어요 → 부분집합 {2} 기록
    path=[2] | graph{시작? +1✓ +2✓ +3✓({1,2,3}) −3✓({1,2}) −2✓ +3✓({1,3}) −3✓({1}) −1? +2? +3✓({2,3}) −3*({2})} edges{root-I= I-II= II-III= II-IIO= I-IO= IO-IOI= IO-IOO= root-O~ O-OI~ OI-OII= OI-OIO=} @OIO | calls[backtrack(0){"i":0} > backtrack(1){"i":1} > backtrack(2){"i":2} > backtrack(3)*{"i":3}] | vars{"찾은 부분집합":["[1, 2, 3]","[1, 2]","[1, 3]","[1]","[2, 3]","[2]"],"개수":6}
#23 unchoose L5 되돌리기: path에서 2 빼기 → path = []
    path=[] | graph{시작? +1✓ +2✓ +3✓({1,2,3}) −3✓({1,2}) −2✓ +3✓({1,3}) −3✓({1}) −1* +2✓ +3✓({2,3}) −3✓({2})} edges{root-I= I-II= II-III= II-IIO= I-IO= IO-IOI= IO-IOO= root-O~ O-OI= OI-OII= OI-OIO=} @O | calls[backtrack(0){"i":0} > backtrack(1)*{"i":1}] | vars{"찾은 부분집합":["[1, 2, 3]","[1, 2]","[1, 3]","[1]","[2, 3]","[2]"],"개수":6}
#24 choose L6 이번엔 2 값을 넣지 않는 쪽으로 가요
    path=[] | graph{시작? +1✓ +2✓ +3✓({1,2,3}) −3✓({1,2}) −2✓ +3✓({1,3}) −3✓({1}) −1? +2✓ +3✓({2,3}) −3✓({2}) −2*} edges{root-I= I-II= II-III= II-IIO= I-IO= IO-IOI= IO-IOO= root-O~ O-OI= OI-OII= OI-OIO= O-OO~} @OO | calls[backtrack(0){"i":0} > backtrack(1){"i":1} > backtrack(2)*{"i":2}] | vars{"찾은 부분집합":["[1, 2, 3]","[1, 2]","[1, 3]","[1]","[2, 3]","[2]"],"개수":6}
#25 choose L3 3 값을 넣는 쪽으로 가요 → path = [3]
    path=[3] | graph{시작? +1✓ +2✓ +3✓({1,2,3}) −3✓({1,2}) −2✓ +3✓({1,3}) −3✓({1}) −1? +2✓ +3✓({2,3}) −3✓({2}) −2? +3*} edges{root-I= I-II= II-III= II-IIO= I-IO= IO-IOI= IO-IOO= root-O~ O-OI= OI-OII= OI-OIO= O-OO~ OO-OOI~} @OOI | calls[backtrack(0){"i":0} > backtrack(1){"i":1} > backtrack(2){"i":2} > backtrack(3)*{"i":3}] | vars{"찾은 부분집합":["[1, 2, 3]","[1, 2]","[1, 3]","[1]","[2, 3]","[2]"],"개수":6}
#26 record L2 모든 원소를 정했어요 → 부분집합 {3} 기록
    path=[3] | graph{시작? +1✓ +2✓ +3✓({1,2,3}) −3✓({1,2}) −2✓ +3✓({1,3}) −3✓({1}) −1? +2✓ +3✓({2,3}) −3✓({2}) −2? +3*({3})} edges{root-I= I-II= II-III= II-IIO= I-IO= IO-IOI= IO-IOO= root-O~ O-OI= OI-OII= OI-OIO= O-OO~ OO-OOI=} @OOI | calls[backtrack(0){"i":0} > backtrack(1){"i":1} > backtrack(2){"i":2} > backtrack(3)*{"i":3}] | vars{"찾은 부분집합":["[1, 2, 3]","[1, 2]","[1, 3]","[1]","[2, 3]","[2]","[3]"],"개수":7}
#27 unchoose L5 되돌리기: path에서 3 빼기 → path = []
    path=[] | graph{시작? +1✓ +2✓ +3✓({1,2,3}) −3✓({1,2}) −2✓ +3✓({1,3}) −3✓({1}) −1? +2✓ +3✓({2,3}) −3✓({2}) −2* +3✓({3})} edges{root-I= I-II= II-III= II-IIO= I-IO= IO-IOI= IO-IOO= root-O~ O-OI= OI-OII= OI-OIO= O-OO~ OO-OOI=} @OO | calls[backtrack(0){"i":0} > backtrack(1){"i":1} > backtrack(2)*{"i":2}] | vars{"찾은 부분집합":["[1, 2, 3]","[1, 2]","[1, 3]","[1]","[2, 3]","[2]","[3]"],"개수":7}
#28 choose L6 이번엔 3 값을 넣지 않는 쪽으로 가요
    path=[] | graph{시작? +1✓ +2✓ +3✓({1,2,3}) −3✓({1,2}) −2✓ +3✓({1,3}) −3✓({1}) −1? +2✓ +3✓({2,3}) −3✓({2}) −2? +3✓({3}) −3*} edges{root-I= I-II= II-III= II-IIO= I-IO= IO-IOI= IO-IOO= root-O~ O-OI= OI-OII= OI-OIO= O-OO~ OO-OOI= OO-OOO~} @OOO | calls[backtrack(0){"i":0} > backtrack(1){"i":1} > backtrack(2){"i":2} > backtrack(3)*{"i":3}] | vars{"찾은 부분집합":["[1, 2, 3]","[1, 2]","[1, 3]","[1]","[2, 3]","[2]","[3]"],"개수":7}
#29 record L2 모든 원소를 정했어요 → 부분집합 {} 기록
    path=[] | graph{시작? +1✓ +2✓ +3✓({1,2,3}) −3✓({1,2}) −2✓ +3✓({1,3}) −3✓({1}) −1? +2✓ +3✓({2,3}) −3✓({2}) −2? +3✓({3}) −3*({})} edges{root-I= I-II= II-III= II-IIO= I-IO= IO-IOI= IO-IOO= root-O~ O-OI= OI-OII= OI-OIO= O-OO~ OO-OOI= OO-OOO=} @OOO | calls[backtrack(0){"i":0} > backtrack(1){"i":1} > backtrack(2){"i":2} > backtrack(3)*{"i":3}] | vars{"찾은 부분집합":["[1, 2, 3]","[1, 2]","[1, 3]","[1]","[2, 3]","[2]","[3]","[]"],"개수":8}
#30 done L- 부분집합은 모두 8개 (2^3 = 8). 트리의 잎 하나가 부분집합 하나예요.
    path=[] | graph{시작✓ +1✓ +2✓ +3✓({1,2,3}) −3✓({1,2}) −2✓ +3✓({1,3}) −3✓({1}) −1✓ +2✓ +3✓({2,3}) −3✓({2}) −2✓ +3✓({3}) −3✓({})} edges{root-I= I-II= II-III= II-IIO= I-IO= IO-IOI= IO-IOO= root-O= O-OI= OI-OII= OI-OIO= O-OO= OO-OOI= OO-OOO=} | calls[] | vars{"찾은 부분집합":["[1, 2, 3]","[1, 2]","[1, 3]","[1]","[2, 3]","[2]","[3]","[]"],"개수":8}"
`;

exports[`프리셋 stack-basic-intro > 스텝 흐름 스냅샷 1`] = `
"#0 init L1 빈 스택에서 시작해요. 넣고 빼는 곳은 맨 위(top) 한 곳뿐이에요.
    명령=<push 3 push 5 push 7 peek pop pop push 2 pop pop pop> cur=- done=0 | stack=[] | vars{"크기":0}
#1 push L3 push(3): 맨 위에 올렸어요. 지금 크기 1
    명령=<push 3* push 5 push 7 peek pop pop push 2 pop pop pop> cur=0 done=0 | stack=[3*] | vars{"크기":1}
#2 push L3 push(5): 맨 위에 올렸어요. 지금 크기 2
    명령=<push 3 push 5* push 7 peek pop pop push 2 pop pop pop> cur=1 done=1 | stack=[3,5*] | vars{"크기":2}
#3 push L3 push(7): 맨 위에 올렸어요. 지금 크기 3
    명령=<push 3 push 5 push 7* peek pop pop push 2 pop pop pop> cur=2 done=2 | stack=[3,5,7*] | vars{"크기":3}
#4 peek L5 peek(): 맨 위 값은 7 (꺼내지는 않아요)
    명령=<push 3 push 5 push 7 peek* pop pop push 2 pop pop pop> cur=3 done=3 | stack=[3,5,7!] | vars{"크기":3,"맨 위":7}
#5 pop L4 pop(): 맨 위 값 7 꺼내기 — 가장 나중에 넣은 값이 먼저 나와요
    명령=<push 3 push 5 push 7 peek pop* pop push 2 pop pop pop> cur=4 done=4 | stack=[3,5] | vars{"크기":2,"꺼낸 값":7}
#6 pop L4 pop(): 맨 위 값 5 꺼내기 — 가장 나중에 넣은 값이 먼저 나와요
    명령=<push 3 push 5 push 7 peek pop pop* push 2 pop pop pop> cur=5 done=5 | stack=[3] | vars{"크기":1,"꺼낸 값":5}
#7 push L3 push(2): 맨 위에 올렸어요. 지금 크기 2
    명령=<push 3 push 5 push 7 peek pop pop push 2* pop pop pop> cur=6 done=6 | stack=[3,2*] | vars{"크기":2}
#8 pop L4 pop(): 맨 위 값 2 꺼내기 — 가장 나중에 넣은 값이 먼저 나와요
    명령=<push 3 push 5 push 7 peek pop pop push 2 pop* pop pop> cur=7 done=7 | stack=[3] | vars{"크기":1,"꺼낸 값":2}
#9 pop L4 pop(): 맨 위 값 3 꺼내기 — 가장 나중에 넣은 값이 먼저 나와요
    명령=<push 3 push 5 push 7 peek pop pop push 2 pop pop* pop> cur=8 done=8 | stack=[] | vars{"크기":0,"꺼낸 값":3}
#10 pop L4 pop(): 스택이 비어 있어서 꺼낼 값이 없어요! 꺼내기 전에 비어 있는지 확인해야 해요.
    명령=<push 3 push 5 push 7 peek pop pop push 2 pop pop pop*> cur=9 done=9 | stack=[] | vars{"크기":0,"오류":"빈 스택에서 pop"}
#11 done L- 명령을 모두 처리했어요. 남은 값 (아래 → 위): []
    명령=<push 3 push 5 push 7 peek pop pop push 2 pop pop pop> cur=- done=10 | stack=[] | vars{"크기":0}"
`;

exports[`프리셋 stack-bracket-bad > 스텝 흐름 스냅샷 1`] = `
"#0 init L1 "([)]"의 괄호를 왼쪽부터 한 글자씩 봐요. 여는 괄호는 스택에 쌓아 둬요.
    s=<( [ ) ]> cur=- done=0 | stack=[] | vars{"i":0}
#1 push L3 '('는 여는 괄호 → push. 짝을 만날 때까지 기다려요.
    s=<(* [ ) ]> cur=0 done=0 | stack=[(*] | vars{"i":0,"ch":"("}
#2 push L3 '['는 여는 괄호 → push. 짝을 만날 때까지 기다려요.
    s=<( [* ) ]> cur=1 done=1 | stack=[(,[*] | vars{"i":1,"ch":"["}
#3 compare L5 ')'의 짝은 '('인데 맨 위는 '[' → 짝이 안 맞아요!
    s=<( [ )*✗ ]> cur=2 done=2 | stack=[(,[✗] | vars{"i":2,"ch":")","결과":false}
#4 done L5 "([)]" → 올바르지 않은 괄호예요 (False)
    s=<( [ )✗ ]> cur=- done=2 | stack=[(,[] | vars{"결과":false}"
`;

exports[`프리셋 stack-bracket-ok > 스텝 흐름 스냅샷 1`] = `
"#0 init L1 "({[]})"의 괄호를 왼쪽부터 한 글자씩 봐요. 여는 괄호는 스택에 쌓아 둬요.
    s=<( { [ ] } )> cur=- done=0 | stack=[] | vars{"i":0}
#1 push L3 '('는 여는 괄호 → push. 짝을 만날 때까지 기다려요.
    s=<(* { [ ] } )> cur=0 done=0 | stack=[(*] | vars{"i":0,"ch":"("}
#2 push L3 '{'는 여는 괄호 → push. 짝을 만날 때까지 기다려요.
    s=<( {* [ ] } )> cur=1 done=1 | stack=[(,{*] | vars{"i":1,"ch":"{"}
#3 push L3 '['는 여는 괄호 → push. 짝을 만날 때까지 기다려요.
    s=<( { [* ] } )> cur=2 done=2 | stack=[(,{,[*] | vars{"i":2,"ch":"["}
#4 compare L5 ']'와 맨 위 '['의 짝이 맞아요
    s=<( { [ ]* } )> cur=3 done=3 | stack=[(,{,[!] | vars{"i":3,"ch":"]"}
#5 pop L6 짝을 찾은 '['를 스택에서 꺼내요
    s=<( { [ ]* } )> cur=3 done=4 | stack=[(,{] | vars{"i":3,"ch":"]"}
#6 compare L5 '}'와 맨 위 '{'의 짝이 맞아요
    s=<( { [ ] }* )> cur=4 done=4 | stack=[(,{!] | vars{"i":4,"ch":"}"}
#7 pop L6 짝을 찾은 '{'를 스택에서 꺼내요
    s=<( { [ ] }* )> cur=4 done=5 | stack=[(] | vars{"i":4,"ch":"}"}
#8 compare L5 ')'와 맨 위 '('의 짝이 맞아요
    s=<( { [ ] } )*> cur=5 done=5 | stack=[(!] | vars{"i":5,"ch":")"}
#9 pop L6 짝을 찾은 '('를 스택에서 꺼내요
    s=<( { [ ] } )*> cur=5 done=6 | stack=[] | vars{"i":5,"ch":")"}
#10 done L7 문자열 끝! 스택이 비었으니 모든 괄호의 짝이 맞아요 → True
    s=<( { [ ] } )> cur=- done=6 | stack=[] | vars{"결과":true}"
`;

exports[`프리셋 station-ex1 > 스텝 흐름 스냅샷 1`] = `
"#0 init L1 노드 5개, 간선 4개. 노드마다 이웃을 적을 빈 리스트를 준비해요.
    graph{0. 1. 2. 3. 4.} | vars{"graph[0]":[],"graph[1]":[],"graph[2]":[],"graph[3]":[],"graph[4]":[]}
#1 discover L3 간선 (0, 1): graph[0]에 1 추가
    graph{0? 1? 2. 3. 4.} edges{0-1~} | vars{"graph[0]":[1],"graph[1]":[],"graph[2]":[],"graph[3]":[],"graph[4]":[]}
#2 discover L4 반대 방향도 이어져 있으니 graph[1]에 0 추가
    graph{0? 1? 2. 3. 4.} edges{0-1~} | vars{"graph[0]":[1],"graph[1]":[0],"graph[2]":[],"graph[3]":[],"graph[4]":[]}
#3 discover L3 간선 (1, 2): graph[1]에 2 추가
    graph{0✓ 1? 2? 3. 4.} edges{0-1= 1-2~} | vars{"graph[0]":[1],"graph[1]":[0,2],"graph[2]":[],"graph[3]":[],"graph[4]":[]}
#4 discover L4 반대 방향도 이어져 있으니 graph[2]에 1 추가
    graph{0✓ 1? 2? 3. 4.} edges{0-1= 1-2~} | vars{"graph[0]":[1],"graph[1]":[0,2],"graph[2]":[1],"graph[3]":[],"graph[4]":[]}
#5 discover L3 간선 (1, 3): graph[1]에 3 추가
