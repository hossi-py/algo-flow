#4 check L5 이웃 0번은 이미 방문했어요 → 건너뛰기
    graph{0?#1 1*#2 2. 3. 4.} edges{0-1~} @1 | calls[dfs(0){"v":0} > dfs(1)*{"v":1}] | vars{"방문 순서":[0,1]}
