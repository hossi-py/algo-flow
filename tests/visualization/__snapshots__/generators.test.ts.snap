"#0 init L1 삽입 정렬 시작: [3, 1, 2]. 앞에서부터 한 장씩 뽑아 알맞은 자리에 끼워 넣어요.
    a=|3 1 2| | vars{"비교 횟수":0,"밀기 횟수":0}
#1 check L2 1번 막대 뽑기 (key = 1). 왼쪽 1개는 이미 서로 정렬돼 있어요.
    a=|3 1* 2| range=0..1 i@1,j@0 | vars{"key":1,"비교 횟수":0,"밀기 횟수":0}
#2 compare L4 3 > 1 → 큰 쪽을 오른쪽으로 밀어요
    a=|3? 1* 2| range=0..1 i@1,j@0 | vars{"key":1,"비교 횟수":1,"밀기 횟수":0}
#3 shift L5 한 칸 오른쪽(1번)으로 밀기: 3
    a=|1* 3? 2| range=0..1 i@1 | vars{"key":1,"비교 횟수":1,"밀기 횟수":1}
#4 place L7 빈자리 0번에 key 넣기 → [1, 3, 2]
    a=|1! 3 2| range=0..1 i@1 | vars{"key":1,"비교 횟수":1,"밀기 횟수":1}
#5 check L2 2번 막대 뽑기 (key = 2). 왼쪽 2개는 이미 서로 정렬돼 있어요.
    a=|1 3 2*| range=0..2 i@2,j@1 | vars{"key":2,"비교 횟수":1,"밀기 횟수":1}
#6 compare L4 3 > 2 → 큰 쪽을 오른쪽으로 밀어요
    a=|1 3? 2*| range=0..2 i@2,j@1 | vars{"key":2,"비교 횟수":2,"밀기 횟수":1}
#7 shift L5 한 칸 오른쪽(2번)으로 밀기: 3
    a=|1 2* 3?| range=0..2 i@2,j@0 | vars{"key":2,"비교 횟수":2,"밀기 횟수":2}
#8 compare L4 1 ≤ 2 → 여기서 멈춰요
    a=|1✓ 2* 3| range=0..2 i@2,j@0 | vars{"key":2,"비교 횟수":3,"밀기 횟수":2}
#9 place L7 빈자리 1번에 key 넣기 → [1, 2, 3]
    a=|1 2! 3| range=0..2 i@2 | vars{"key":2,"비교 횟수":3,"밀기 횟수":2}
#10 done L- 정렬 끝! [1, 2, 3] — 비교 3번, 밀기 2번. 거의 정렬된 배열이면 밀 일이 적어서 빨라요.
    a=|1✓ 2✓ 3✓| | vars{"비교 횟수":3,"밀기 횟수":2}"
`;

