exports[`프리셋 dp-forest-paths-ex2 > 스텝 흐름 스냅샷 1`] = `
"#0 init L1 왼쪽 위에서 오른쪽 아래까지, 오른쪽·아래로만 가는 길의 수를 세요. # 칸은 못 지나가요.
    dp (그 칸까지 오는 길의 수)[. . . . / . . . . / . . . .]
#1 fill L1 출발 칸에 서 있는 방법은 1가지
    dp (그 칸까지 오는 길의 수)[1! . . . / . . . . / . . . .]
#2 fill L5 (0, 1) = 위 0 + 왼쪽 1 = 1
    dp (그 칸까지 오는 길의 수)[1? 1* . . / . . . . / . . . .]
#3 fill L5 (0, 2) = 위 0 + 왼쪽 1 = 1
    dp (그 칸까지 오는 길의 수)[1 1? 1* . / . . . . / . . . .]
#4 fill L5 (0, 3) = 위 0 + 왼쪽 1 = 1
    dp (그 칸까지 오는 길의 수)[1 1 1? 1* / . . . . / . . . .]
#5 fill L5 (1, 0) = 위 1 + 왼쪽 0 = 1
    dp (그 칸까지 오는 길의 수)[1? 1 1 1 / 1* . . . / . . . .]
#6 fill L4 (1, 1)는 막힌 칸 → 여기로 오는 길은 0
    dp (그 칸까지 오는 길의 수)[1 1 1 1 / 1 #✗ . . / . . . .]
#7 fill L5 (1, 2) = 위 1 + 왼쪽 0 = 1
    dp (그 칸까지 오는 길의 수)[1 1 1? 1 / 1 #? 1* . / . . . .]
#8 fill L5 (1, 3) = 위 1 + 왼쪽 1 = 2
    dp (그 칸까지 오는 길의 수)[1 1 1 1? / 1 # 1? 2* / . . . .]
#9 fill L5 (2, 0) = 위 1 + 왼쪽 0 = 1
    dp (그 칸까지 오는 길의 수)[1 1 1 1 / 1? # 1 2 / 1* . . .]
#10 fill L5 (2, 1) = 위 0 + 왼쪽 1 = 1
    dp (그 칸까지 오는 길의 수)[1 1 1 1 / 1 #? 1 2 / 1? 1* . .]
#11 fill L5 (2, 2) = 위 1 + 왼쪽 1 = 2
    dp (그 칸까지 오는 길의 수)[1 1 1 1 / 1 # 1? 2 / 1 1? 2* .]
#12 fill L5 (2, 3) = 위 2 + 왼쪽 2 = 4
    dp (그 칸까지 오는 길의 수)[1 1 1 1 / 1 # 1 2? / 1 1 2? 4*]
#13 done L6 도착 칸까지 4가지 길이 있어요. 길을 하나씩 따라가지 않고, 칸마다 한 번 더하기만 했어요.
    dp (그 칸까지 오는 길의 수)[1 1 1 1 / 1 # 1 2 / 1 1 2 4!]"
`;

