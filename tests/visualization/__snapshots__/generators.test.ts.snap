    queue=[(2, 2)] | grid zone=11000/11000/01100/00000/00000 cur=2,1 chk=2,2:go dist=0,1,-,-,-/1,2,-,-,-/-,3,4,-,-/-,-,-,-,-/-,-,-,-,- | vars{"큐 길이":1}
#22 dequeue L3 큐 맨 앞의 (2, 2) 칸을 꺼내요 (거리 4)
    queue=[] | grid zone=11000/11000/01100/00000/00000 cur=2,2 dist=0,1,-,-,-/1,2,-,-,-/-,3,4,-,-/-,-,-,-,-/-,-,-,-,- | vars{"큐 길이":0}
#23 check L6 위 (1, 2) 칸은 벽 → 건너뛰기
    queue=[] | grid zone=11000/11000/01100/00000/00000 cur=2,2 chk=1,2:blocked dist=0,1,-,-,-/1,2,-,-,-/-,3,4,-,-/-,-,-,-,-/-,-,-,-,- | vars{"큐 길이":0}
