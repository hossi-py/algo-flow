    queue=[] | grid zone=1111/1001/1111 cur=2,3 dist=0,1,2,3/1,-,-,4/2,3,4,5 | vars{"큐 길이":0}
#35 done L4 도착! 최단 거리는 5칸이에요. 가까운 칸부터 퍼졌으니 처음 닿은 순간이 가장 짧은 길이에요.
    queue=[] | grid zone=2111/2001/2222 cur=2,3 dist=0,1,2,3/1,-,-,4/2,3,4,5 | vars{"큐 길이":0}"
`;

exports[`프리셋 news-ex1 > 스텝 흐름 스냅샷 1`] = `
"#0 init L1 시작 0번 노드의 거리는 0. 나머지는 아직 모르니 -1이에요.
    queue=[] | graph{0.d0 1. 2. 3. 4. 5.} | vars{"dist":[0,-1,-1,-1,-1,-1]}
#1 enqueue L2 0번 노드를 큐에 넣고 출발!
    queue=[0] | graph{0?d0 1. 2. 3. 4. 5.} | vars{"dist":[0,-1,-1,-1,-1,-1]}
#2 dequeue L4 큐 맨 앞의 0번 노드를 꺼내요 (거리 0)
    queue=[] | graph{0*#1d0 1. 2. 3. 4. 5.} @0 | vars{"dist":[0,-1,-1,-1,-1,-1]}
#3 discover L7 이웃 1번을 처음 발견! 거리 0 + 1 = 1, 큐 뒤에 넣어요
    queue=[1] | graph{0*#1d0 1?d1 2. 3. 4. 5.} edges{0-1=} @0 | vars{"dist":[0,1,-1,-1,-1,-1]}
#4 discover L7 이웃 2번을 처음 발견! 거리 0 + 1 = 1, 큐 뒤에 넣어요
    queue=[1,2] | graph{0*#1d0 1?d1 2?d1 3. 4. 5.} edges{0-1= 0-2=} @0 | vars{"dist":[0,1,1,-1,-1,-1]}
#5 dequeue L4 큐 맨 앞의 1번 노드를 꺼내요 (거리 1)
    queue=[2] | graph{0✓#1d0 1*#2d1 2?d1 3. 4. 5.} edges{0-1= 0-2=} @1 | vars{"dist":[0,1,1,-1,-1,-1]}
#6 check L6 이웃 0번은 이미 발견했어요 (거리 0) → 건너뛰기
    queue=[2] | graph{0✓#1d0 1*#2d1 2?d1 3. 4. 5.} edges{0-1~ 0-2=} @1 | vars{"dist":[0,1,1,-1,-1,-1]}
#7 discover L7 이웃 3번을 처음 발견! 거리 1 + 1 = 2, 큐 뒤에 넣어요
    queue=[2,3] | graph{0✓#1d0 1*#2d1 2?d1 3?d2 4. 5.} edges{0-1= 0-2= 1-3=} @1 | vars{"dist":[0,1,1,2,-1,-1]}
#8 discover L7 이웃 4번을 처음 발견! 거리 1 + 1 = 2, 큐 뒤에 넣어요
    queue=[2,3,4] | graph{0✓#1d0 1*#2d1 2?d1 3?d2 4?d2 5.} edges{0-1= 0-2= 1-3= 1-4=} @1 | vars{"dist":[0,1,1,2,2,-1]}
#9 dequeue L4 큐 맨 앞의 2번 노드를 꺼내요 (거리 1)
    queue=[3,4] | graph{0✓#1d0 1✓#2d1 2*#3d1 3?d2 4?d2 5.} edges{0-1= 0-2= 1-3= 1-4=} @2 | vars{"dist":[0,1,1,2,2,-1]}
#10 check L6 이웃 0번은 이미 발견했어요 (거리 0) → 건너뛰기
    queue=[3,4] | graph{0✓#1d0 1✓#2d1 2*#3d1 3?d2 4?d2 5.} edges{0-1= 0-2~ 1-3= 1-4=} @2 | vars{"dist":[0,1,1,2,2,-1]}
#11 discover L7 이웃 5번을 처음 발견! 거리 1 + 1 = 2, 큐 뒤에 넣어요
    queue=[3,4,5] | graph{0✓#1d0 1✓#2d1 2*#3d1 3?d2 4?d2 5?d2} edges{0-1= 0-2= 1-3= 1-4= 2-5=} @2 | vars{"dist":[0,1,1,2,2,2]}
#12 dequeue L4 큐 맨 앞의 3번 노드를 꺼내요 (거리 2)
    queue=[4,5] | graph{0✓#1d0 1✓#2d1 2✓#3d1 3*#4d2 4?d2 5?d2} edges{0-1= 0-2= 1-3= 1-4= 2-5=} @3 | vars{"dist":[0,1,1,2,2,2]}
#13 check L6 이웃 1번은 이미 발견했어요 (거리 1) → 건너뛰기
    queue=[4,5] | graph{0✓#1d0 1✓#2d1 2✓#3d1 3*#4d2 4?d2 5?d2} edges{0-1= 0-2= 1-3~ 1-4= 2-5=} @3 | vars{"dist":[0,1,1,2,2,2]}
#14 dequeue L4 큐 맨 앞의 4번 노드를 꺼내요 (거리 2)
    queue=[5] | graph{0✓#1d0 1✓#2d1 2✓#3d1 3✓#4d2 4*#5d2 5?d2} edges{0-1= 0-2= 1-3= 1-4= 2-5=} @4 | vars{"dist":[0,1,1,2,2,2]}
#15 check L6 이웃 1번은 이미 발견했어요 (거리 1) → 건너뛰기
    queue=[5] | graph{0✓#1d0 1✓#2d1 2✓#3d1 3✓#4d2 4*#5d2 5?d2} edges{0-1= 0-2= 1-3= 1-4~ 2-5=} @4 | vars{"dist":[0,1,1,2,2,2]}
#16 dequeue L4 큐 맨 앞의 5번 노드를 꺼내요 (거리 2)
    queue=[] | graph{0✓#1d0 1✓#2d1 2✓#3d1 3✓#4d2 4✓#5d2 5*#6d2} edges{0-1= 0-2= 1-3= 1-4= 2-5=} @5 | vars{"dist":[0,1,1,2,2,2]}
#17 check L6 이웃 2번은 이미 발견했어요 (거리 1) → 건너뛰기
    queue=[] | graph{0✓#1d0 1✓#2d1 2✓#3d1 3✓#4d2 4✓#5d2 5*#6d2} edges{0-1= 0-2= 1-3= 1-4= 2-5~} @5 | vars{"dist":[0,1,1,2,2,2]}
#18 done L8 큐가 비었어요. 시작점에서의 최단 거리: 0번=0, 1번=1, 2번=1, 3번=2, 4번=2, 5번=2
    queue=[] | graph{0✓#1d0 1✓#2d1 2✓#3d1 3✓#4d2 4✓#5d2 5✓#6d2} edges{0-1= 0-2= 1-3= 1-4= 2-5=} | vars{"dist":[0,1,1,2,2,2]}"
`;

