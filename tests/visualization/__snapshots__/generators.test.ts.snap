#13 check L6 위 (1, 0) 칸은 이미 발견했어요 → 건너뛰기
    queue=[(0, 2)] | grid zone=1110/1000/1000 cur=2,0 chk=1,0:visited dist=0,1,2,-/1,-,-,-/2,-,-,- | vars{"큐 길이":1}
