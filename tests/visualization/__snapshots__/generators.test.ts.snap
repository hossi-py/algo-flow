exports[`프리셋 flower-zones-example-1 > 스텝 흐름 스냅샷 1`] = `
"#0 zone-start L3 (0, 0) 칸에서 방문 안 한 꽃 발견! 1번 구역 탐색 시작
    grid zone=00000/00000/00000/00000/00000 cur=0,0 | calls[] | vars{"sizes":[]}
#1 visit L6 (0, 0) 칸에 방문 표시, size = 1로 시작해요.
    grid zone=10000/00000/00000/00000/00000 cur=0,0 | calls[dfs(0, 0)*{"size":1}] | vars{"sizes":[]}
#2 check L9 아래 (1, 0) 칸은 방문하지 않은 꽃! → dfs(1, 0) 호출
    grid zone=10000/00000/00000/00000/00000 cur=0,0 chk=1,0:go | calls[dfs(0, 0)*{"size":1}] | vars{"sizes":[]}
#3 visit L6 (1, 0) 칸에 방문 표시, size = 1로 시작해요.
    grid zone=10000/10000/00000/00000/00000 cur=1,0 | calls[dfs(0, 0){"size":1} > dfs(1, 0)*{"size":1}] | vars{"sizes":[]}
#4 check L8 위 (0, 0) 칸은 이미 방문 → 건너뛰기
    grid zone=10000/10000/00000/00000/00000 cur=1,0 chk=0,0:visited | calls[dfs(0, 0){"size":1} > dfs(1, 0)*{"size":1}] | vars{"sizes":[]}
#5 check L8 아래 (2, 0) 칸은 빈 땅 → 건너뛰기
    grid zone=10000/10000/00000/00000/00000 cur=1,0 chk=2,0:blocked | calls[dfs(0, 0){"size":1} > dfs(1, 0)*{"size":1}] | vars{"sizes":[]}
#6 check L9 오른쪽 (1, 1) 칸은 방문하지 않은 꽃! → dfs(1, 1) 호출
    grid zone=10000/10000/00000/00000/00000 cur=1,0 chk=1,1:go | calls[dfs(0, 0){"size":1} > dfs(1, 0)*{"size":1}] | vars{"sizes":[]}
#7 visit L6 (1, 1) 칸에 방문 표시, size = 1로 시작해요.
    grid zone=10000/11000/00000/00000/00000 cur=1,1 | calls[dfs(0, 0){"size":1} > dfs(1, 0){"size":1} > dfs(1, 1)*{"size":1}] | vars{"sizes":[]}
#8 check L9 위 (0, 1) 칸은 방문하지 않은 꽃! → dfs(0, 1) 호출
