    grid zone=110/010/000 cur=0,1 chk=0,2:blocked | calls[dfs(0, 0){"size":1} > dfs(0, 1)*{"size":2}] | vars{"sizes":[]}
#15 return L10 더 갈 곳이 없어요. dfs(0, 1)의 결과는 2
    grid zone=110/010/000 cur=0,1 | calls[dfs(0, 0){"size":1} > dfs(0, 1)*{"size":2}] | vars{"sizes":[]}
#16 return-to L9 dfs(0, 1)의 결과 2 → size = 3
    grid zone=110/010/000 cur=0,0 | calls[dfs(0, 0)*{"size":3}] | vars{"sizes":[]}
#17 return L10 더 갈 곳이 없어요. dfs(0, 0)의 결과는 3
    grid zone=110/010/000 cur=0,0 | calls[dfs(0, 0)*{"size":3}] | vars{"sizes":[]}
#18 zone-complete L4 1번 구역 완성! 크기 3 → sizes = [3]
    grid zone=110/010/000 cur=0,0 | calls[] | vars{"sizes":[3]}
#19 scan L2 (0, 1) 칸은 이미 1번 구역 → 다음 칸으로
    grid zone=110/010/000 cur=0,1 | calls[] | vars{"sizes":[3]}
#20 scan L2 (0, 2) 칸은 빈 땅 → 다음 칸으로
    grid zone=110/010/000 cur=0,2 | calls[] | vars{"sizes":[3]}
#21 scan L2 (1, 0) 칸은 빈 땅 → 다음 칸으로
    grid zone=110/010/000 cur=1,0 | calls[] | vars{"sizes":[3]}
#22 scan L2 (1, 1) 칸은 이미 1번 구역 → 다음 칸으로
    grid zone=110/010/000 cur=1,1 | calls[] | vars{"sizes":[3]}
#23 scan L2 (1, 2) 칸은 빈 땅 → 다음 칸으로
    grid zone=110/010/000 cur=1,2 | calls[] | vars{"sizes":[3]}
#24 scan L2 (2, 0) 칸은 빈 땅 → 다음 칸으로
    grid zone=110/010/000 cur=2,0 | calls[] | vars{"sizes":[3]}
#25 scan L2 (2, 1) 칸은 빈 땅 → 다음 칸으로
    grid zone=110/010/000 cur=2,1 | calls[] | vars{"sizes":[3]}
#26 zone-start L3 (2, 2) 칸에서 방문 안 한 꽃 발견! 2번 구역 탐색 시작
    grid zone=110/010/000 cur=2,2 | calls[] | vars{"sizes":[3]}
#27 visit L6 (2, 2) 칸에 방문 표시, size = 1로 시작해요.
    grid zone=110/010/002 cur=2,2 | calls[dfs(2, 2)*{"size":1}] | vars{"sizes":[3]}
#28 check L8 위 (1, 2) 칸은 빈 땅 → 건너뛰기
    grid zone=110/010/002 cur=2,2 chk=1,2:blocked | calls[dfs(2, 2)*{"size":1}] | vars{"sizes":[3]}
#29 check L8 왼쪽 (2, 1) 칸은 빈 땅 → 건너뛰기
    grid zone=110/010/002 cur=2,2 chk=2,1:blocked | calls[dfs(2, 2)*{"size":1}] | vars{"sizes":[3]}
#30 return L10 더 갈 곳이 없어요. dfs(2, 2)의 결과는 1
    grid zone=110/010/002 cur=2,2 | calls[dfs(2, 2)*{"size":1}] | vars{"sizes":[3]}
#31 zone-complete L4 2번 구역 완성! 크기 1 → sizes = [3, 1]
    grid zone=110/010/002 cur=2,2 | calls[] | vars{"sizes":[3,1]}
#32 done L11 모든 칸 확인 완료! 정렬한 [1, 3]이 정답이에요.
    grid zone=110/010/002 | calls[] | vars{"sizes":[1,3]}"
`;

exports[`프리셋 friend-dist-ex2 > 스텝 흐름 스냅샷 1`] = `
"#0 init L1 시작 0번 노드의 거리는 0. 나머지는 아직 모르니 -1이에요.
    queue=[] | graph{0.d0 1. 2. 3.} | vars{"dist":[0,-1,-1,-1]}
#1 enqueue L2 0번 노드를 큐에 넣고 출발!
    queue=[0] | graph{0?d0 1. 2. 3.} | vars{"dist":[0,-1,-1,-1]}
#2 dequeue L4 큐 맨 앞의 0번 노드를 꺼내요 (거리 0)
    queue=[] | graph{0*#1d0 1. 2. 3.} @0 | vars{"dist":[0,-1,-1,-1]}
#3 discover L7 이웃 1번을 처음 발견! 거리 0 + 1 = 1, 큐 뒤에 넣어요
    queue=[1] | graph{0*#1d0 1?d1 2. 3.} edges{0-1=} @0 | vars{"dist":[0,1,-1,-1]}
#4 discover L7 이웃 3번을 처음 발견! 거리 0 + 1 = 1, 큐 뒤에 넣어요
    queue=[1,3] | graph{0*#1d0 1?d1 2. 3?d1} edges{0-1= 0-3=} @0 | vars{"dist":[0,1,-1,1]}
#5 dequeue L4 큐 맨 앞의 1번 노드를 꺼내요 (거리 1)
    queue=[3] | graph{0✓#1d0 1*#2d1 2. 3?d1} edges{0-1= 0-3=} @1 | vars{"dist":[0,1,-1,1]}
#6 check L6 이웃 0번은 이미 발견했어요 (거리 0) → 건너뛰기
    queue=[3] | graph{0✓#1d0 1*#2d1 2. 3?d1} edges{0-1~ 0-3=} @1 | vars{"dist":[0,1,-1,1]}
#7 discover L7 이웃 2번을 처음 발견! 거리 1 + 1 = 2, 큐 뒤에 넣어요
    queue=[3,2] | graph{0✓#1d0 1*#2d1 2?d2 3?d1} edges{0-1= 1-2= 0-3=} @1 | vars{"dist":[0,1,2,1]}
#8 dequeue L4 큐 맨 앞의 3번 노드를 꺼내요 (거리 1)
    queue=[2] | graph{0✓#1d0 1✓#2d1 2?d2 3*#3d1} edges{0-1= 1-2= 0-3=} @3 | vars{"dist":[0,1,2,1]}
#9 check L6 이웃 0번은 이미 발견했어요 (거리 0) → 건너뛰기
    queue=[2] | graph{0✓#1d0 1✓#2d1 2?d2 3*#3d1} edges{0-1= 1-2= 0-3~} @3 | vars{"dist":[0,1,2,1]}
#10 check L6 이웃 2번은 이미 발견했어요 (거리 2) → 건너뛰기
    queue=[2] | graph{0✓#1d0 1✓#2d1 2?d2 3*#3d1} edges{0-1= 1-2= 2-3~ 0-3=} @3 | vars{"dist":[0,1,2,1]}
#11 dequeue L4 큐 맨 앞의 2번 노드를 꺼내요 (거리 2)
    queue=[] | graph{0✓#1d0 1✓#2d1 2*#4d2 3✓#3d1} edges{0-1= 1-2= 2-3x 0-3=} @2 | vars{"dist":[0,1,2,1]}
#12 check L6 이웃 1번은 이미 발견했어요 (거리 1) → 건너뛰기
    queue=[] | graph{0✓#1d0 1✓#2d1 2*#4d2 3✓#3d1} edges{0-1= 1-2~ 2-3x 0-3=} @2 | vars{"dist":[0,1,2,1]}
#13 check L6 이웃 3번은 이미 발견했어요 (거리 1) → 건너뛰기
    queue=[] | graph{0✓#1d0 1✓#2d1 2*#4d2 3✓#3d1} edges{0-1= 1-2= 2-3~ 0-3=} @2 | vars{"dist":[0,1,2,1]}
#14 done L8 큐가 비었어요. 시작점에서의 최단 거리: 0번=0, 1번=1, 2번=2, 3번=1
    queue=[] | graph{0✓#1d0 1✓#2d1 2✓#4d2 3✓#3d1} edges{0-1= 1-2= 2-3x 0-3=} | vars{"dist":[0,1,2,1]}"
`;

exports[`프리셋 friend-list-ex1 > 스텝 흐름 스냅샷 1`] = `
"#0 init L1 노드 4개, 간선 4개. 노드마다 이웃을 적을 빈 리스트를 준비해요.
    graph{0. 1. 2. 3.} | vars{"graph[0]":[],"graph[1]":[],"graph[2]":[],"graph[3]":[]}
#1 discover L3 간선 (0, 1): graph[0]에 1 추가
    graph{0? 1? 2. 3.} edges{0-1~} | vars{"graph[0]":[1],"graph[1]":[],"graph[2]":[],"graph[3]":[]}
#2 discover L4 반대 방향도 이어져 있으니 graph[1]에 0 추가
    graph{0? 1? 2. 3.} edges{0-1~} | vars{"graph[0]":[1],"graph[1]":[0],"graph[2]":[],"graph[3]":[]}
#3 discover L3 간선 (2, 0): graph[2]에 0 추가
    graph{0? 1✓ 2? 3.} edges{0-1= 2-0~} | vars{"graph[0]":[1],"graph[1]":[0],"graph[2]":[0],"graph[3]":[]}
#4 discover L4 반대 방향도 이어져 있으니 graph[0]에 2 추가
    graph{0? 1✓ 2? 3.} edges{0-1= 2-0~} | vars{"graph[0]":[1,2],"graph[1]":[0],"graph[2]":[0],"graph[3]":[]}
#5 discover L3 간선 (1, 2): graph[1]에 2 추가
    graph{0✓ 1? 2? 3.} edges{0-1= 2-0= 1-2~} | vars{"graph[0]":[1,2],"graph[1]":[0,2],"graph[2]":[0],"graph[3]":[]}
#6 discover L4 반대 방향도 이어져 있으니 graph[2]에 1 추가
    graph{0✓ 1? 2? 3.} edges{0-1= 2-0= 1-2~} | vars{"graph[0]":[1,2],"graph[1]":[0,2],"graph[2]":[0,1],"graph[3]":[]}
#7 discover L3 간선 (3, 1): graph[3]에 1 추가
    graph{0✓ 1? 2✓ 3?} edges{0-1= 2-0= 1-2= 3-1~} | vars{"graph[0]":[1,2],"graph[1]":[0,2],"graph[2]":[0,1],"graph[3]":[1]}
#8 discover L4 반대 방향도 이어져 있으니 graph[1]에 3 추가
    graph{0✓ 1? 2✓ 3?} edges{0-1= 2-0= 1-2= 3-1~} | vars{"graph[0]":[1,2],"graph[1]":[0,2,3],"graph[2]":[0,1],"graph[3]":[1]}
#9 done L- 인접 리스트 완성! 이제 graph[v]만 보면 v의 이웃을 바로 찾을 수 있어요.
    graph{0✓ 1✓ 2✓ 3✓} edges{0-1= 2-0= 1-2= 3-1=} | vars{"graph[0]":[1,2],"graph[1]":[0,2,3],"graph[2]":[0,1],"graph[3]":[1]}"
`;

exports[`프리셋 front-back-ex1 > 스텝 흐름 스냅샷 1`] = `
"#0 init L1 빈 큐에서 시작해요. 들어가는 곳(rear)과 나가는 곳(front)이 달라요.
    명령=<enqueue 3 enqueue 8 peek dequeue peek> cur=- done=0 | queue=[] | vars{"크기":0}
#1 enqueue L3 enqueue(3): 줄의 맨 뒤에 섰어요. 지금 1명 대기 중
    명령=<enqueue 3* enqueue 8 peek dequeue peek> cur=0 done=0 | queue=[3*] | vars{"크기":1}
#2 enqueue L3 enqueue(8): 줄의 맨 뒤에 섰어요. 지금 2명 대기 중
    명령=<enqueue 3 enqueue 8* peek dequeue peek> cur=1 done=1 | queue=[3,8*] | vars{"크기":2}
#3 peek L5 peek(): 맨 앞 값은 3
    명령=<enqueue 3 enqueue 8 peek* dequeue peek> cur=2 done=2 | queue=[3!,8] | vars{"크기":2,"맨 앞":3}
#4 dequeue L4 dequeue(): 맨 앞 값 3 꺼내기 — 먼저 온 값이 먼저 나가요
    명령=<enqueue 3 enqueue 8 peek dequeue* peek> cur=3 done=3 | queue=[8] | vars{"크기":1,"꺼낸 값":3}
#5 peek L5 peek(): 맨 앞 값은 8
    명령=<enqueue 3 enqueue 8 peek dequeue peek*> cur=4 done=4 | queue=[8!] | vars{"크기":1,"맨 앞":8}
#6 done L- 명령을 모두 처리했어요. 남은 줄 (앞 → 뒤): [8]
    명령=<enqueue 3 enqueue 8 peek dequeue peek> cur=- done=5 | queue=[8] | vars{"크기":1}"
`;

exports[`프리셋 graph-bfs-intro > 스텝 흐름 스냅샷 1`] = `
"#0 init L1 시작 0번 노드의 거리는 0. 나머지는 아직 모르니 -1이에요.
    queue=[] | graph{0.d0 1. 2. 3. 4. 5.} | vars{"dist":[0,-1,-1,-1,-1,-1]}
#1 enqueue L2 0번 노드를 큐에 넣고 출발!
    queue=[0] | graph{0?d0 1. 2. 3. 4. 5.} | vars{"dist":[0,-1,-1,-1,-1,-1]}
#2 dequeue L4 큐 맨 앞의 0번 노드를 꺼내요 (거리 0)
    queue=[] | graph{0*#1d0 1. 2. 3. 4. 5.} @0 | vars{"dist":[0,-1,-1,-1,-1,-1]}
#3 discover L7 이웃 1번을 처음 발견! 거리 0 + 1 = 1, 큐 뒤에 넣어요
    queue=[1] | graph{0*#1d0 1?d1 2. 3. 4. 5.} edges{0-1=} @0 | vars{"dist":[0,1,-1,-1,-1,-1]}
#4 discover L7 이웃 2번을 처음 발견! 거리 0 + 1 = 1, 큐 뒤에 넣어요
    queue=[1,2] | graph{0*#1d0 1?d1 2?d1 3. 4. 5.} edges{0-1= 0-2=} @0 | vars{"dist":[0,1,1,-1,-1,-1]}
#5 dequeue L4 큐 맨 앞의 1번 노드를 꺼내요 (거리 1)
    queue=[2] | graph{0✓#1d0 1*#2d1 2?d1 3. 4. 5.} edges{0-1= 0-2=} @1 | vars{"dist":[0,1,1,-1,-1,-1]}
#6 check L6 이웃 0번은 이미 발견했어요 (거리 0) → 건너뛰기
    queue=[2] | graph{0✓#1d0 1*#2d1 2?d1 3. 4. 5.} edges{0-1~ 0-2=} @1 | vars{"dist":[0,1,1,-1,-1,-1]}
#7 discover L7 이웃 3번을 처음 발견! 거리 1 + 1 = 2, 큐 뒤에 넣어요
    queue=[2,3] | graph{0✓#1d0 1*#2d1 2?d1 3?d2 4. 5.} edges{0-1= 0-2= 1-3=} @1 | vars{"dist":[0,1,1,2,-1,-1]}
#8 dequeue L4 큐 맨 앞의 2번 노드를 꺼내요 (거리 1)
    queue=[3] | graph{0✓#1d0 1✓#2d1 2*#3d1 3?d2 4. 5.} edges{0-1= 0-2= 1-3=} @2 | vars{"dist":[0,1,1,2,-1,-1]}
#9 check L6 이웃 0번은 이미 발견했어요 (거리 0) → 건너뛰기
    queue=[3] | graph{0✓#1d0 1✓#2d1 2*#3d1 3?d2 4. 5.} edges{0-1= 0-2~ 1-3=} @2 | vars{"dist":[0,1,1,2,-1,-1]}
#10 check L6 이웃 3번은 이미 발견했어요 (거리 2) → 건너뛰기
    queue=[3] | graph{0✓#1d0 1✓#2d1 2*#3d1 3?d2 4. 5.} edges{0-1= 0-2= 1-3= 2-3~} @2 | vars{"dist":[0,1,1,2,-1,-1]}
#11 dequeue L4 큐 맨 앞의 3번 노드를 꺼내요 (거리 2)
    queue=[] | graph{0✓#1d0 1✓#2d1 2✓#3d1 3*#4d2 4. 5.} edges{0-1= 0-2= 1-3= 2-3x} @3 | vars{"dist":[0,1,1,2,-1,-1]}
#12 check L6 이웃 1번은 이미 발견했어요 (거리 1) → 건너뛰기
    queue=[] | graph{0✓#1d0 1✓#2d1 2✓#3d1 3*#4d2 4. 5.} edges{0-1= 0-2= 1-3~ 2-3x} @3 | vars{"dist":[0,1,1,2,-1,-1]}
#13 check L6 이웃 2번은 이미 발견했어요 (거리 1) → 건너뛰기
    queue=[] | graph{0✓#1d0 1✓#2d1 2✓#3d1 3*#4d2 4. 5.} edges{0-1= 0-2= 1-3= 2-3~} @3 | vars{"dist":[0,1,1,2,-1,-1]}
#14 discover L7 이웃 4번을 처음 발견! 거리 2 + 1 = 3, 큐 뒤에 넣어요
    queue=[4] | graph{0✓#1d0 1✓#2d1 2✓#3d1 3*#4d2 4?d3 5.} edges{0-1= 0-2= 1-3= 2-3x 3-4=} @3 | vars{"dist":[0,1,1,2,3,-1]}
#15 dequeue L4 큐 맨 앞의 4번 노드를 꺼내요 (거리 3)
    queue=[] | graph{0✓#1d0 1✓#2d1 2✓#3d1 3✓#4d2 4*#5d3 5.} edges{0-1= 0-2= 1-3= 2-3x 3-4=} @4 | vars{"dist":[0,1,1,2,3,-1]}
#16 check L6 이웃 3번은 이미 발견했어요 (거리 2) → 건너뛰기
    queue=[] | graph{0✓#1d0 1✓#2d1 2✓#3d1 3✓#4d2 4*#5d3 5.} edges{0-1= 0-2= 1-3= 2-3x 3-4~} @4 | vars{"dist":[0,1,1,2,3,-1]}
#17 discover L7 이웃 5번을 처음 발견! 거리 3 + 1 = 4, 큐 뒤에 넣어요
    queue=[5] | graph{0✓#1d0 1✓#2d1 2✓#3d1 3✓#4d2 4*#5d3 5?d4} edges{0-1= 0-2= 1-3= 2-3x 3-4= 4-5=} @4 | vars{"dist":[0,1,1,2,3,4]}
#18 dequeue L4 큐 맨 앞의 5번 노드를 꺼내요 (거리 4)
    queue=[] | graph{0✓#1d0 1✓#2d1 2✓#3d1 3✓#4d2 4✓#5d3 5*#6d4} edges{0-1= 0-2= 1-3= 2-3x 3-4= 4-5=} @5 | vars{"dist":[0,1,1,2,3,4]}
#19 check L6 이웃 4번은 이미 발견했어요 (거리 3) → 건너뛰기
    queue=[] | graph{0✓#1d0 1✓#2d1 2✓#3d1 3✓#4d2 4✓#5d3 5*#6d4} edges{0-1= 0-2= 1-3= 2-3x 3-4= 4-5~} @5 | vars{"dist":[0,1,1,2,3,4]}
#20 done L8 큐가 비었어요. 시작점에서의 최단 거리: 0번=0, 1번=1, 2번=1, 3번=2, 4번=3, 5번=4
    queue=[] | graph{0✓#1d0 1✓#2d1 2✓#3d1 3✓#4d2 4✓#5d3 5✓#6d4} edges{0-1= 0-2= 1-3= 2-3x 3-4= 4-5=} | vars{"dist":[0,1,1,2,3,4]}"
`;

exports[`프리셋 graph-dfs-intro > 스텝 흐름 스냅샷 1`] = `
"#0 init L7 0번 노드에서 DFS를 시작해요. 아직 아무 데도 방문하지 않았어요.
    graph{0. 1. 2. 3. 4. 5.} | calls[] | vars{"방문 순서":[]}
#1 visit L3 dfs(0): 0번 노드에 방문 표시 (방문 순서 1)
    graph{0*#1 1. 2. 3. 4. 5.} @0 | calls[dfs(0)*{"v":0}] | vars{"방문 순서":[0]}
#2 check L6 이웃 1번은 아직 방문하지 않았어요 → dfs(1) 호출
    graph{0*#1 1. 2. 3. 4. 5.} edges{0-1~} @0 | calls[dfs(0)*{"v":0}] | vars{"방문 순서":[0]}
#3 visit L3 dfs(1): 1번 노드에 방문 표시 (방문 순서 2)
    graph{0?#1 1*#2 2. 3. 4. 5.} edges{0-1=} @1 | calls[dfs(0){"v":0} > dfs(1)*{"v":1}] | vars{"방문 순서":[0,1]}
#4 check L5 이웃 0번은 이미 방문했어요 → 건너뛰기
    graph{0?#1 1*#2 2. 3. 4. 5.} edges{0-1~} @1 | calls[dfs(0){"v":0} > dfs(1)*{"v":1}] | vars{"방문 순서":[0,1]}
#5 check L6 이웃 3번은 아직 방문하지 않았어요 → dfs(3) 호출
    graph{0?#1 1*#2 2. 3. 4. 5.} edges{0-1= 1-3~} @1 | calls[dfs(0){"v":0} > dfs(1)*{"v":1}] | vars{"방문 순서":[0,1]}
#6 visit L3 dfs(3): 3번 노드에 방문 표시 (방문 순서 3)
    graph{0?#1 1?#2 2. 3*#3 4. 5.} edges{0-1= 1-3=} @3 | calls[dfs(0){"v":0} > dfs(1){"v":1} > dfs(3)*{"v":3}] | vars{"방문 순서":[0,1,3]}
#7 check L5 이웃 1번은 이미 방문했어요 → 건너뛰기
