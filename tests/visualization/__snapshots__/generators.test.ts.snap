exports[`프리셋 grid-bfs-maze > 스텝 흐름 스냅샷 1`] = `
"#0 init L1 출발점 (0, 0)의 거리는 0. 큐에 넣고 출발해요.
    queue=[(0, 0)] | grid zone=10000/00000/00000/00000/00000 cur=0,0 dist=0,-,-,-,-/-,-,-,-,-/-,-,-,-,-/-,-,-,-,-/-,-,-,-,- | vars{"큐 길이":1}
#1 dequeue L3 큐 맨 앞의 (0, 0) 칸을 꺼내요 (거리 0)
    queue=[] | grid zone=10000/00000/00000/00000/00000 cur=0,0 dist=0,-,-,-,-/-,-,-,-,-/-,-,-,-,-/-,-,-,-,-/-,-,-,-,- | vars{"큐 길이":0}
#2 discover L8 아래 (1, 0) 칸을 처음 발견! 거리 1, 큐 뒤에 넣어요
    queue=[(1, 0)] | grid zone=10000/10000/00000/00000/00000 cur=0,0 chk=1,0:go dist=0,-,-,-,-/1,-,-,-,-/-,-,-,-,-/-,-,-,-,-/-,-,-,-,- | vars{"큐 길이":1}
#3 discover L8 오른쪽 (0, 1) 칸을 처음 발견! 거리 1, 큐 뒤에 넣어요
    queue=[(1, 0),(0, 1)] | grid zone=11000/10000/00000/00000/00000 cur=0,0 chk=0,1:go dist=0,1,-,-,-/1,-,-,-,-/-,-,-,-,-/-,-,-,-,-/-,-,-,-,- | vars{"큐 길이":2}
#4 dequeue L3 큐 맨 앞의 (1, 0) 칸을 꺼내요 (거리 1)
    queue=[(0, 1)] | grid zone=11000/10000/00000/00000/00000 cur=1,0 dist=0,1,-,-,-/1,-,-,-,-/-,-,-,-,-/-,-,-,-,-/-,-,-,-,- | vars{"큐 길이":1}
#5 check L6 위 (0, 0) 칸은 이미 발견했어요 → 건너뛰기
    queue=[(0, 1)] | grid zone=11000/10000/00000/00000/00000 cur=1,0 chk=0,0:visited dist=0,1,-,-,-/1,-,-,-,-/-,-,-,-,-/-,-,-,-,-/-,-,-,-,- | vars{"큐 길이":1}
#6 check L6 아래 (2, 0) 칸은 벽 → 건너뛰기
    queue=[(0, 1)] | grid zone=11000/10000/00000/00000/00000 cur=1,0 chk=2,0:blocked dist=0,1,-,-,-/1,-,-,-,-/-,-,-,-,-/-,-,-,-,-/-,-,-,-,- | vars{"큐 길이":1}
#7 discover L8 오른쪽 (1, 1) 칸을 처음 발견! 거리 2, 큐 뒤에 넣어요
    queue=[(0, 1),(1, 1)] | grid zone=11000/11000/00000/00000/00000 cur=1,0 chk=1,1:go dist=0,1,-,-,-/1,2,-,-,-/-,-,-,-,-/-,-,-,-,-/-,-,-,-,- | vars{"큐 길이":2}
#8 dequeue L3 큐 맨 앞의 (0, 1) 칸을 꺼내요 (거리 1)
    queue=[(1, 1)] | grid zone=11000/11000/00000/00000/00000 cur=0,1 dist=0,1,-,-,-/1,2,-,-,-/-,-,-,-,-/-,-,-,-,-/-,-,-,-,- | vars{"큐 길이":1}
#9 check L6 아래 (1, 1) 칸은 이미 발견했어요 → 건너뛰기
    queue=[(1, 1)] | grid zone=11000/11000/00000/00000/00000 cur=0,1 chk=1,1:visited dist=0,1,-,-,-/1,2,-,-,-/-,-,-,-,-/-,-,-,-,-/-,-,-,-,- | vars{"큐 길이":1}
#10 check L6 왼쪽 (0, 0) 칸은 이미 발견했어요 → 건너뛰기
    queue=[(1, 1)] | grid zone=11000/11000/00000/00000/00000 cur=0,1 chk=0,0:visited dist=0,1,-,-,-/1,2,-,-,-/-,-,-,-,-/-,-,-,-,-/-,-,-,-,- | vars{"큐 길이":1}
#11 check L6 오른쪽 (0, 2) 칸은 벽 → 건너뛰기
    queue=[(1, 1)] | grid zone=11000/11000/00000/00000/00000 cur=0,1 chk=0,2:blocked dist=0,1,-,-,-/1,2,-,-,-/-,-,-,-,-/-,-,-,-,-/-,-,-,-,- | vars{"큐 길이":1}
