#20 return L4 5번 노드의 이웃을 모두 확인했어요 → dfs(5) 끝
    graph{0?#1 1?#2 2✓#4 3?#3 4*#5 5✓#6} edges{0-1= 0-2x 1-3= 2-3= 3-4= 4-5=} @4 | calls[dfs(0){"v":0} > dfs(1){"v":1} > dfs(3){"v":3} > dfs(4)*{"v":4}] | vars{"방문 순서":[0,1,3,2,4,5]}
