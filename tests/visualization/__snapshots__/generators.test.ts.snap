exports[`프리셋 fibonacci-4 > 스텝 흐름 스냅샷 1`] = `
"#0 call L1 fib(4) 호출
    graph{4*(fib(4))} @t0 | calls[fib(4)*{"n":4}] | vars{"총 호출":1,"같은 계산 반복":0}
#1 call L3 fib(4)의 첫 번째 재귀 호출: fib(3)
    graph{4*(fib(4))} @t0 | calls[fib(4)*{"n":4}] | vars{"총 호출":1,"같은 계산 반복":0}
#2 call L1 fib(3) 호출
    graph{4?(fib(4)) 3*(fib(3))} edges{t0-t1~} @t1 | calls[fib(4){"n":4} > fib(3)*{"n":3}] | vars{"총 호출":2,"같은 계산 반복":0}
#3 call L3 fib(3)의 첫 번째 재귀 호출: fib(2)
