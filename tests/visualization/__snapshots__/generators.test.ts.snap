#9 move-left L6 더 짧게 만들어 봐요 → 왼쪽의 3 빼기 → 창의 합 7
    a=|2 3 1 2 4 3| range=2..4 L@2,R@4 | vars{"S":7,"창의 합":7,"가장짧은길이":4}
