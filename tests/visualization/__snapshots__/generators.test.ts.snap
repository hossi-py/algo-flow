// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`프리셋 adjacency-intro > 스텝 흐름 스냅샷 1`] = `
"#0 init L1 노드 5개, 간선 5개. 노드마다 이웃을 적을 빈 리스트를 준비해요.
    graph{0. 1. 2. 3. 4.} | vars{"graph[0]":[],"graph[1]":[],"graph[2]":[],"graph[3]":[],"graph[4]":[]}
#1 discover L3 간선 (0, 1): graph[0]에 1 추가
    graph{0? 1? 2. 3. 4.} edges{0-1~} | vars{"graph[0]":[1],"graph[1]":[],"graph[2]":[],"graph[3]":[],"graph[4]":[]}
#2 discover L4 반대 방향도 이어져 있으니 graph[1]에 0 추가
    graph{0? 1? 2. 3. 4.} edges{0-1~} | vars{"graph[0]":[1],"graph[1]":[0],"graph[2]":[],"graph[3]":[],"graph[4]":[]}
#3 discover L3 간선 (0, 2): graph[0]에 2 추가
    graph{0? 1✓ 2? 3. 4.} edges{0-1= 0-2~} | vars{"graph[0]":[1,2],"graph[1]":[0],"graph[2]":[],"graph[3]":[],"graph[4]":[]}
#4 discover L4 반대 방향도 이어져 있으니 graph[2]에 0 추가
    graph{0? 1✓ 2? 3. 4.} edges{0-1= 0-2~} | vars{"graph[0]":[1,2],"graph[1]":[0],"graph[2]":[0],"graph[3]":[],"graph[4]":[]}
#5 discover L3 간선 (1, 3): graph[1]에 3 추가
    graph{0✓ 1? 2✓ 3? 4.} edges{0-1= 0-2= 1-3~} | vars{"graph[0]":[1,2],"graph[1]":[0,3],"graph[2]":[0],"graph[3]":[],"graph[4]":[]}
#6 discover L4 반대 방향도 이어져 있으니 graph[3]에 1 추가
    graph{0✓ 1? 2✓ 3? 4.} edges{0-1= 0-2= 1-3~} | vars{"graph[0]":[1,2],"graph[1]":[0,3],"graph[2]":[0],"graph[3]":[1],"graph[4]":[]}
#7 discover L3 간선 (2, 3): graph[2]에 3 추가
    graph{0✓ 1✓ 2? 3? 4.} edges{0-1= 0-2= 1-3= 2-3~} | vars{"graph[0]":[1,2],"graph[1]":[0,3],"graph[2]":[0,3],"graph[3]":[1],"graph[4]":[]}
#8 discover L4 반대 방향도 이어져 있으니 graph[3]에 2 추가
    graph{0✓ 1✓ 2? 3? 4.} edges{0-1= 0-2= 1-3= 2-3~} | vars{"graph[0]":[1,2],"graph[1]":[0,3],"graph[2]":[0,3],"graph[3]":[1,2],"graph[4]":[]}
#9 discover L3 간선 (3, 4): graph[3]에 4 추가
    graph{0✓ 1✓ 2✓ 3? 4?} edges{0-1= 0-2= 1-3= 2-3= 3-4~} | vars{"graph[0]":[1,2],"graph[1]":[0,3],"graph[2]":[0,3],"graph[3]":[1,2,4],"graph[4]":[]}
#10 discover L4 반대 방향도 이어져 있으니 graph[4]에 3 추가
    graph{0✓ 1✓ 2✓ 3? 4?} edges{0-1= 0-2= 1-3= 2-3= 3-4~} | vars{"graph[0]":[1,2],"graph[1]":[0,3],"graph[2]":[0,3],"graph[3]":[1,2,4],"graph[4]":[3]}
#11 done L- 인접 리스트 완성! 이제 graph[v]만 보면 v의 이웃을 바로 찾을 수 있어요.
    graph{0✓ 1✓ 2✓ 3✓ 4✓} edges{0-1= 0-2= 1-3= 2-3= 3-4=} | vars{"graph[0]":[1,2],"graph[1]":[0,3],"graph[2]":[0,3],"graph[3]":[1,2,4],"graph[4]":[3]}"
`;

exports[`프리셋 bakery-ex1 > 스텝 흐름 스냅샷 1`] = `
"#0 init L1 빈 큐에서 시작해요. 들어가는 곳(rear)과 나가는 곳(front)이 달라요.
    명령=<enqueue 1 enqueue 2 dequeue enqueue 3 dequeue dequeue> cur=- done=0 | queue=[] | vars{"크기":0}
#1 enqueue L3 enqueue(1): 줄의 맨 뒤에 섰어요. 지금 1명 대기 중
    명령=<enqueue 1* enqueue 2 dequeue enqueue 3 dequeue dequeue> cur=0 done=0 | queue=[1*] | vars{"크기":1}
#2 enqueue L3 enqueue(2): 줄의 맨 뒤에 섰어요. 지금 2명 대기 중
    명령=<enqueue 1 enqueue 2* dequeue enqueue 3 dequeue dequeue> cur=1 done=1 | queue=[1,2*] | vars{"크기":2}
#3 dequeue L4 dequeue(): 맨 앞 값 1 꺼내기 — 먼저 온 값이 먼저 나가요
    명령=<enqueue 1 enqueue 2 dequeue* enqueue 3 dequeue dequeue> cur=2 done=2 | queue=[2] | vars{"크기":1,"꺼낸 값":1}
#4 enqueue L3 enqueue(3): 줄의 맨 뒤에 섰어요. 지금 2명 대기 중
    명령=<enqueue 1 enqueue 2 dequeue enqueue 3* dequeue dequeue> cur=3 done=3 | queue=[2,3*] | vars{"크기":2}
#5 dequeue L4 dequeue(): 맨 앞 값 2 꺼내기 — 먼저 온 값이 먼저 나가요
    명령=<enqueue 1 enqueue 2 dequeue enqueue 3 dequeue* dequeue> cur=4 done=4 | queue=[3] | vars{"크기":1,"꺼낸 값":2}
#6 dequeue L4 dequeue(): 맨 앞 값 3 꺼내기 — 먼저 온 값이 먼저 나가요
    명령=<enqueue 1 enqueue 2 dequeue enqueue 3 dequeue dequeue*> cur=5 done=5 | queue=[] | vars{"크기":0,"꺼낸 값":3}
#7 done L- 명령을 모두 처리했어요. 남은 줄 (앞 → 뒤): []
    명령=<enqueue 1 enqueue 2 dequeue enqueue 3 dequeue dequeue> cur=- done=6 | queue=[] | vars{"크기":0}"
`;

exports[`프리셋 bracket-partner-tricky > 스텝 흐름 스냅샷 1`] = `
"#0 init L1 "(()())"의 괄호를 왼쪽부터 한 글자씩 봐요. 여는 괄호는 스택에 쌓아 둬요.
    s=<( ( ) ( ) )> cur=- done=0 | stack=[] | vars{"i":0}
#1 push L3 '('는 여는 괄호 → push. 짝을 만날 때까지 기다려요.
    s=<(* ( ) ( ) )> cur=0 done=0 | stack=[(*] | vars{"i":0,"ch":"("}
#2 push L3 '('는 여는 괄호 → push. 짝을 만날 때까지 기다려요.
    s=<( (* ) ( ) )> cur=1 done=1 | stack=[(,(*] | vars{"i":1,"ch":"("}
#3 compare L5 ')'와 맨 위 '('의 짝이 맞아요
    s=<( ( )* ( ) )> cur=2 done=2 | stack=[(,(!] | vars{"i":2,"ch":")"}
#4 pop L6 짝을 찾은 '('를 스택에서 꺼내요
    s=<( ( )* ( ) )> cur=2 done=3 | stack=[(] | vars{"i":2,"ch":")"}
#5 push L3 '('는 여는 괄호 → push. 짝을 만날 때까지 기다려요.
    s=<( ( ) (* ) )> cur=3 done=3 | stack=[(,(*] | vars{"i":3,"ch":"("}
#6 compare L5 ')'와 맨 위 '('의 짝이 맞아요
    s=<( ( ) ( )* )> cur=4 done=4 | stack=[(,(!] | vars{"i":4,"ch":")"}
#7 pop L6 짝을 찾은 '('를 스택에서 꺼내요
    s=<( ( ) ( )* )> cur=4 done=5 | stack=[(] | vars{"i":4,"ch":")"}
#8 compare L5 ')'와 맨 위 '('의 짝이 맞아요
    s=<( ( ) ( ) )*> cur=5 done=5 | stack=[(!] | vars{"i":5,"ch":")"}
#9 pop L6 짝을 찾은 '('를 스택에서 꺼내요
    s=<( ( ) ( ) )*> cur=5 done=6 | stack=[] | vars{"i":5,"ch":")"}
#10 done L7 문자열 끝! 스택이 비었으니 모든 괄호의 짝이 맞아요 → True
    s=<( ( ) ( ) )> cur=- done=6 | stack=[] | vars{"결과":true}"
`;

exports[`프리셋 carousel-line-flow > 스텝 흐름 스냅샷 1`] = `
"#0 init L1 빈 큐에서 시작해요. 들어가는 곳(rear)과 나가는 곳(front)이 달라요.
    명령=<enqueue 1 enqueue 2 enqueue 3 dequeue dequeue enqueue 4 dequeue dequeue> cur=- done=0 | queue=[] | vars{"크기":0}
#1 enqueue L3 enqueue(1): 줄의 맨 뒤에 섰어요. 지금 1명 대기 중
    명령=<enqueue 1* enqueue 2 enqueue 3 dequeue dequeue enqueue 4 dequeue dequeue> cur=0 done=0 | queue=[1*] | vars{"크기":1}
#2 enqueue L3 enqueue(2): 줄의 맨 뒤에 섰어요. 지금 2명 대기 중
    명령=<enqueue 1 enqueue 2* enqueue 3 dequeue dequeue enqueue 4 dequeue dequeue> cur=1 done=1 | queue=[1,2*] | vars{"크기":2}
#3 enqueue L3 enqueue(3): 줄의 맨 뒤에 섰어요. 지금 3명 대기 중
    명령=<enqueue 1 enqueue 2 enqueue 3* dequeue dequeue enqueue 4 dequeue dequeue> cur=2 done=2 | queue=[1,2,3*] | vars{"크기":3}
#4 dequeue L4 dequeue(): 맨 앞 값 1 꺼내기 — 먼저 온 값이 먼저 나가요
    명령=<enqueue 1 enqueue 2 enqueue 3 dequeue* dequeue enqueue 4 dequeue dequeue> cur=3 done=3 | queue=[2,3] | vars{"크기":2,"꺼낸 값":1}
#5 dequeue L4 dequeue(): 맨 앞 값 2 꺼내기 — 먼저 온 값이 먼저 나가요
    명령=<enqueue 1 enqueue 2 enqueue 3 dequeue dequeue* enqueue 4 dequeue dequeue> cur=4 done=4 | queue=[3] | vars{"크기":1,"꺼낸 값":2}
#6 enqueue L3 enqueue(4): 줄의 맨 뒤에 섰어요. 지금 2명 대기 중
    명령=<enqueue 1 enqueue 2 enqueue 3 dequeue dequeue enqueue 4* dequeue dequeue> cur=5 done=5 | queue=[3,4*] | vars{"크기":2}
#7 dequeue L4 dequeue(): 맨 앞 값 3 꺼내기 — 먼저 온 값이 먼저 나가요
    명령=<enqueue 1 enqueue 2 enqueue 3 dequeue dequeue enqueue 4 dequeue* dequeue> cur=6 done=6 | queue=[4] | vars{"크기":1,"꺼낸 값":3}
#8 dequeue L4 dequeue(): 맨 앞 값 4 꺼내기 — 먼저 온 값이 먼저 나가요
    명령=<enqueue 1 enqueue 2 enqueue 3 dequeue dequeue enqueue 4 dequeue dequeue*> cur=7 done=7 | queue=[] | vars{"크기":0,"꺼낸 값":4}
#9 done L- 명령을 모두 처리했어요. 남은 줄 (앞 → 뒤): []
    명령=<enqueue 1 enqueue 2 enqueue 3 dequeue dequeue enqueue 4 dequeue dequeue> cur=- done=8 | queue=[] | vars{"크기":0}"
`;

exports[`프리셋 cave-ex1 > 스텝 흐름 스냅샷 1`] = `
"#0 init L7 0번 노드에서 DFS를 시작해요. 아직 아무 데도 방문하지 않았어요.
    graph{0. 1. 2. 3. 4.} | calls[] | vars{"방문 순서":[]}
#1 visit L3 dfs(0): 0번 노드에 방문 표시 (방문 순서 1)
    graph{0*#1 1. 2. 3. 4.} @0 | calls[dfs(0)*{"v":0}] | vars{"방문 순서":[0]}
#2 check L6 이웃 1번은 아직 방문하지 않았어요 → dfs(1) 호출
    graph{0*#1 1. 2. 3. 4.} edges{0-1~} @0 | calls[dfs(0)*{"v":0}] | vars{"방문 순서":[0]}
#3 visit L3 dfs(1): 1번 노드에 방문 표시 (방문 순서 2)
    graph{0?#1 1*#2 2. 3. 4.} edges{0-1=} @1 | calls[dfs(0){"v":0} > dfs(1)*{"v":1}] | vars{"방문 순서":[0,1]}
#4 check L5 이웃 0번은 이미 방문했어요 → 건너뛰기
    graph{0?#1 1*#2 2. 3. 4.} edges{0-1~} @1 | calls[dfs(0){"v":0} > dfs(1)*{"v":1}] | vars{"방문 순서":[0,1]}
#5 check L6 이웃 3번은 아직 방문하지 않았어요 → dfs(3) 호출
    graph{0?#1 1*#2 2. 3. 4.} edges{0-1= 1-3~} @1 | calls[dfs(0){"v":0} > dfs(1)*{"v":1}] | vars{"방문 순서":[0,1]}
#6 visit L3 dfs(3): 3번 노드에 방문 표시 (방문 순서 3)
    graph{0?#1 1?#2 2. 3*#3 4.} edges{0-1= 1-3=} @3 | calls[dfs(0){"v":0} > dfs(1){"v":1} > dfs(3)*{"v":3}] | vars{"방문 순서":[0,1,3]}
#7 check L5 이웃 1번은 이미 방문했어요 → 건너뛰기
    graph{0?#1 1?#2 2. 3*#3 4.} edges{0-1= 1-3~} @3 | calls[dfs(0){"v":0} > dfs(1){"v":1} > dfs(3)*{"v":3}] | vars{"방문 순서":[0,1,3]}
#8 return L4 3번 노드의 이웃을 모두 확인했어요 → dfs(3) 끝
    graph{0?#1 1*#2 2. 3✓#3 4.} edges{0-1= 1-3=} @1 | calls[dfs(0){"v":0} > dfs(1)*{"v":1}] | vars{"방문 순서":[0,1,3]}
#9 return-to L4 dfs(3) 탐색이 끝나서 1번 노드로 돌아왔어요. 남은 이웃을 계속 봐요.
    graph{0?#1 1*#2 2. 3✓#3 4.} edges{0-1= 1-3=} @1 | calls[dfs(0){"v":0} > dfs(1)*{"v":1}] | vars{"방문 순서":[0,1,3]}
#10 return L4 1번 노드의 이웃을 모두 확인했어요 → dfs(1) 끝
    graph{0*#1 1✓#2 2. 3✓#3 4.} edges{0-1= 1-3=} @0 | calls[dfs(0)*{"v":0}] | vars{"방문 순서":[0,1,3]}
#11 return-to L4 dfs(1) 탐색이 끝나서 0번 노드로 돌아왔어요. 남은 이웃을 계속 봐요.
    graph{0*#1 1✓#2 2. 3✓#3 4.} edges{0-1= 1-3=} @0 | calls[dfs(0)*{"v":0}] | vars{"방문 순서":[0,1,3]}
#12 check L6 이웃 2번은 아직 방문하지 않았어요 → dfs(2) 호출
    graph{0*#1 1✓#2 2. 3✓#3 4.} edges{0-1= 0-2~ 1-3=} @0 | calls[dfs(0)*{"v":0}] | vars{"방문 순서":[0,1,3]}
#13 visit L3 dfs(2): 2번 노드에 방문 표시 (방문 순서 4)
    graph{0?#1 1✓#2 2*#4 3✓#3 4.} edges{0-1= 0-2= 1-3=} @2 | calls[dfs(0){"v":0} > dfs(2)*{"v":2}] | vars{"방문 순서":[0,1,3,2]}
#14 check L5 이웃 0번은 이미 방문했어요 → 건너뛰기
    graph{0?#1 1✓#2 2*#4 3✓#3 4.} edges{0-1= 0-2~ 1-3=} @2 | calls[dfs(0){"v":0} > dfs(2)*{"v":2}] | vars{"방문 순서":[0,1,3,2]}
#15 check L6 이웃 4번은 아직 방문하지 않았어요 → dfs(4) 호출
    graph{0?#1 1✓#2 2*#4 3✓#3 4.} edges{0-1= 0-2= 1-3= 2-4~} @2 | calls[dfs(0){"v":0} > dfs(2)*{"v":2}] | vars{"방문 순서":[0,1,3,2]}
#16 visit L3 dfs(4): 4번 노드에 방문 표시 (방문 순서 5)
    graph{0?#1 1✓#2 2?#4 3✓#3 4*#5} edges{0-1= 0-2= 1-3= 2-4=} @4 | calls[dfs(0){"v":0} > dfs(2){"v":2} > dfs(4)*{"v":4}] | vars{"방문 순서":[0,1,3,2,4]}
#17 check L5 이웃 2번은 이미 방문했어요 → 건너뛰기
    graph{0?#1 1✓#2 2?#4 3✓#3 4*#5} edges{0-1= 0-2= 1-3= 2-4~} @4 | calls[dfs(0){"v":0} > dfs(2){"v":2} > dfs(4)*{"v":4}] | vars{"방문 순서":[0,1,3,2,4]}
#18 return L4 4번 노드의 이웃을 모두 확인했어요 → dfs(4) 끝
    graph{0?#1 1✓#2 2*#4 3✓#3 4✓#5} edges{0-1= 0-2= 1-3= 2-4=} @2 | calls[dfs(0){"v":0} > dfs(2)*{"v":2}] | vars{"방문 순서":[0,1,3,2,4]}
#19 return-to L4 dfs(4) 탐색이 끝나서 2번 노드로 돌아왔어요. 남은 이웃을 계속 봐요.
    graph{0?#1 1✓#2 2*#4 3✓#3 4✓#5} edges{0-1= 0-2= 1-3= 2-4=} @2 | calls[dfs(0){"v":0} > dfs(2)*{"v":2}] | vars{"방문 순서":[0,1,3,2,4]}
#20 return L4 2번 노드의 이웃을 모두 확인했어요 → dfs(2) 끝
    graph{0*#1 1✓#2 2✓#4 3✓#3 4✓#5} edges{0-1= 0-2= 1-3= 2-4=} @0 | calls[dfs(0)*{"v":0}] | vars{"방문 순서":[0,1,3,2,4]}
#21 return-to L4 dfs(2) 탐색이 끝나서 0번 노드로 돌아왔어요. 남은 이웃을 계속 봐요.
    graph{0*#1 1✓#2 2✓#4 3✓#3 4✓#5} edges{0-1= 0-2= 1-3= 2-4=} @0 | calls[dfs(0)*{"v":0}] | vars{"방문 순서":[0,1,3,2,4]}
#22 return L4 0번 노드의 이웃을 모두 확인했어요 → dfs(0) 끝
    graph{0✓#1 1✓#2 2✓#4 3✓#3 4✓#5} edges{0-1= 0-2= 1-3= 2-4=} | calls[] | vars{"방문 순서":[0,1,3,2,4]}
#23 done L- 방문 순서: 0 → 1 → 3 → 2 → 4
    graph{0✓#1 1✓#2 2✓#4 3✓#3 4✓#5} edges{0-1= 0-2= 1-3= 2-4=} | calls[] | vars{"방문 순서":[0,1,3,2,4]}"
`;

exports[`프리셋 cave-ex2 > 스텝 흐름 스냅샷 1`] = `
"#0 init L7 0번 노드에서 DFS를 시작해요. 아직 아무 데도 방문하지 않았어요.
    graph{0. 1. 2. 3.} | calls[] | vars{"방문 순서":[]}
#1 visit L3 dfs(0): 0번 노드에 방문 표시 (방문 순서 1)
    graph{0*#1 1. 2. 3.} @0 | calls[dfs(0)*{"v":0}] | vars{"방문 순서":[0]}
#2 check L6 이웃 1번은 아직 방문하지 않았어요 → dfs(1) 호출
    graph{0*#1 1. 2. 3.} edges{0-1~} @0 | calls[dfs(0)*{"v":0}] | vars{"방문 순서":[0]}
#3 visit L3 dfs(1): 1번 노드에 방문 표시 (방문 순서 2)
    graph{0?#1 1*#2 2. 3.} edges{0-1=} @1 | calls[dfs(0){"v":0} > dfs(1)*{"v":1}] | vars{"방문 순서":[0,1]}
#4 check L5 이웃 0번은 이미 방문했어요 → 건너뛰기
    graph{0?#1 1*#2 2. 3.} edges{0-1~} @1 | calls[dfs(0){"v":0} > dfs(1)*{"v":1}] | vars{"방문 순서":[0,1]}
#5 check L6 이웃 2번은 아직 방문하지 않았어요 → dfs(2) 호출
    graph{0?#1 1*#2 2. 3.} edges{0-1= 1-2~} @1 | calls[dfs(0){"v":0} > dfs(1)*{"v":1}] | vars{"방문 순서":[0,1]}
#6 visit L3 dfs(2): 2번 노드에 방문 표시 (방문 순서 3)
    graph{0?#1 1?#2 2*#3 3.} edges{0-1= 1-2=} @2 | calls[dfs(0){"v":0} > dfs(1){"v":1} > dfs(2)*{"v":2}] | vars{"방문 순서":[0,1,2]}
#7 check L5 이웃 0번은 이미 방문했어요 → 건너뛰기
    graph{0?#1 1?#2 2*#3 3.} edges{0-1= 1-2= 2-0~} @2 | calls[dfs(0){"v":0} > dfs(1){"v":1} > dfs(2)*{"v":2}] | vars{"방문 순서":[0,1,2]}
#8 check L5 이웃 1번은 이미 방문했어요 → 건너뛰기
    graph{0?#1 1?#2 2*#3 3.} edges{0-1= 1-2~ 2-0x} @2 | calls[dfs(0){"v":0} > dfs(1){"v":1} > dfs(2)*{"v":2}] | vars{"방문 순서":[0,1,2]}
#9 check L6 이웃 3번은 아직 방문하지 않았어요 → dfs(3) 호출
    graph{0?#1 1?#2 2*#3 3.} edges{0-1= 1-2= 2-0x 2-3~} @2 | calls[dfs(0){"v":0} > dfs(1){"v":1} > dfs(2)*{"v":2}] | vars{"방문 순서":[0,1,2]}
#10 visit L3 dfs(3): 3번 노드에 방문 표시 (방문 순서 4)
    graph{0?#1 1?#2 2?#3 3*#4} edges{0-1= 1-2= 2-0x 2-3=} @3 | calls[dfs(0){"v":0} > dfs(1){"v":1} > dfs(2){"v":2} > dfs(3)*{"v":3}] | vars{"방문 순서":[0,1,2,3]}
#11 check L5 이웃 2번은 이미 방문했어요 → 건너뛰기
    graph{0?#1 1?#2 2?#3 3*#4} edges{0-1= 1-2= 2-0x 2-3~} @3 | calls[dfs(0){"v":0} > dfs(1){"v":1} > dfs(2){"v":2} > dfs(3)*{"v":3}] | vars{"방문 순서":[0,1,2,3]}
#12 return L4 3번 노드의 이웃을 모두 확인했어요 → dfs(3) 끝
    graph{0?#1 1?#2 2*#3 3✓#4} edges{0-1= 1-2= 2-0x 2-3=} @2 | calls[dfs(0){"v":0} > dfs(1){"v":1} > dfs(2)*{"v":2}] | vars{"방문 순서":[0,1,2,3]}
#13 return-to L4 dfs(3) 탐색이 끝나서 2번 노드로 돌아왔어요. 남은 이웃을 계속 봐요.
    graph{0?#1 1?#2 2*#3 3✓#4} edges{0-1= 1-2= 2-0x 2-3=} @2 | calls[dfs(0){"v":0} > dfs(1){"v":1} > dfs(2)*{"v":2}] | vars{"방문 순서":[0,1,2,3]}
#14 return L4 2번 노드의 이웃을 모두 확인했어요 → dfs(2) 끝
    graph{0?#1 1*#2 2✓#3 3✓#4} edges{0-1= 1-2= 2-0x 2-3=} @1 | calls[dfs(0){"v":0} > dfs(1)*{"v":1}] | vars{"방문 순서":[0,1,2,3]}
#15 return-to L4 dfs(2) 탐색이 끝나서 1번 노드로 돌아왔어요. 남은 이웃을 계속 봐요.
    graph{0?#1 1*#2 2✓#3 3✓#4} edges{0-1= 1-2= 2-0x 2-3=} @1 | calls[dfs(0){"v":0} > dfs(1)*{"v":1}] | vars{"방문 순서":[0,1,2,3]}
#16 return L4 1번 노드의 이웃을 모두 확인했어요 → dfs(1) 끝
    graph{0*#1 1✓#2 2✓#3 3✓#4} edges{0-1= 1-2= 2-0x 2-3=} @0 | calls[dfs(0)*{"v":0}] | vars{"방문 순서":[0,1,2,3]}
#17 return-to L4 dfs(1) 탐색이 끝나서 0번 노드로 돌아왔어요. 남은 이웃을 계속 봐요.
    graph{0*#1 1✓#2 2✓#3 3✓#4} edges{0-1= 1-2= 2-0x 2-3=} @0 | calls[dfs(0)*{"v":0}] | vars{"방문 순서":[0,1,2,3]}
#18 check L5 이웃 2번은 이미 방문했어요 → 건너뛰기
    graph{0*#1 1✓#2 2✓#3 3✓#4} edges{0-1= 1-2= 2-0~ 2-3=} @0 | calls[dfs(0)*{"v":0}] | vars{"방문 순서":[0,1,2,3]}
#19 return L4 0번 노드의 이웃을 모두 확인했어요 → dfs(0) 끝
    graph{0✓#1 1✓#2 2✓#3 3✓#4} edges{0-1= 1-2= 2-0x 2-3=} | calls[] | vars{"방문 순서":[0,1,2,3]}
#20 done L- 방문 순서: 0 → 1 → 2 → 3
    graph{0✓#1 1✓#2 2✓#3 3✓#4} edges{0-1= 1-2= 2-0x 2-3=} | calls[] | vars{"방문 순서":[0,1,2,3]}"
`;

exports[`프리셋 countdown-calls > 스텝 흐름 스냅샷 1`] = `
"#0 call L1 factorial(4) 호출 — 호출 스택에 새 칸이 쌓여요
    calls[factorial(4)*{"n":4}] | vars{"호출 깊이":1}
#1 call L3 4 × factorial(3) 계산에는 먼저 factorial(3) 값이 필요해요 → 재귀 호출
    calls[factorial(4)*{"n":4}] | vars{"호출 깊이":1}
#2 call L1 factorial(3) 호출 — 호출 스택에 새 칸이 쌓여요
    calls[factorial(4){"n":4} > factorial(3)*{"n":3}] | vars{"호출 깊이":2}
#3 call L3 3 × factorial(2) 계산에는 먼저 factorial(2) 값이 필요해요 → 재귀 호출
    calls[factorial(4){"n":4} > factorial(3)*{"n":3}] | vars{"호출 깊이":2}
#4 call L1 factorial(2) 호출 — 호출 스택에 새 칸이 쌓여요
    calls[factorial(4){"n":4} > factorial(3){"n":3} > factorial(2)*{"n":2}] | vars{"호출 깊이":3}
#5 call L3 2 × factorial(1) 계산에는 먼저 factorial(1) 값이 필요해요 → 재귀 호출
    calls[factorial(4){"n":4} > factorial(3){"n":3} > factorial(2)*{"n":2}] | vars{"호출 깊이":3}
#6 call L1 factorial(1) 호출 — 호출 스택에 새 칸이 쌓여요
    calls[factorial(4){"n":4} > factorial(3){"n":3} > factorial(2){"n":2} > factorial(1)*{"n":1}] | vars{"호출 깊이":4}
#7 return L2 n = 1 → 종료 조건! 더 부르지 않고 1을 돌려줘요
    calls[factorial(4){"n":4} > factorial(3){"n":3} > factorial(2){"n":2} > factorial(1)*{"n":1,"결과":1}] | vars{"호출 깊이":4}
#8 return-to L3 factorial(1) = 1 값이 돌아왔어요 → 2 × 1 = 2
    calls[factorial(4){"n":4} > factorial(3){"n":3} > factorial(2)*{"n":2,"결과":2}] | vars{"호출 깊이":3}
#9 return L3 factorial(2)의 계산이 끝났어요. 결과 2 반환, 칸이 사라져요
    calls[factorial(4){"n":4} > factorial(3){"n":3} > factorial(2)*{"n":2,"결과":2}] | vars{"호출 깊이":3}
#10 return-to L3 factorial(2) = 2 값이 돌아왔어요 → 3 × 2 = 6
    calls[factorial(4){"n":4} > factorial(3)*{"n":3,"결과":6}] | vars{"호출 깊이":2}
#11 return L3 factorial(3)의 계산이 끝났어요. 결과 6 반환, 칸이 사라져요
    calls[factorial(4){"n":4} > factorial(3)*{"n":3,"결과":6}] | vars{"호출 깊이":2}
#12 return-to L3 factorial(3) = 6 값이 돌아왔어요 → 4 × 6 = 24
    calls[factorial(4)*{"n":4,"결과":24}] | vars{"호출 깊이":1}
#13 return L3 factorial(4)의 계산이 끝났어요. 결과 24 반환, 칸이 사라져요
    calls[factorial(4)*{"n":4,"결과":24}] | vars{"호출 깊이":1}
#14 done L- factorial(4) = 24. 호출은 4칸까지 쌓였다가 거꾸로 풀렸어요.
    calls[] | vars{"결과":24}"
`;

exports[`프리셋 dead-end-parking-ex1 > 스텝 흐름 스냅샷 1`] = `
"#0 init L1 빈 스택에서 시작해요. 넣고 빼는 곳은 맨 위(top) 한 곳뿐이에요.
    명령=<push 3 push 7 pop push 5 pop pop> cur=- done=0 | stack=[] | vars{"크기":0}
#1 push L3 push(3): 맨 위에 올렸어요. 지금 크기 1
    명령=<push 3* push 7 pop push 5 pop pop> cur=0 done=0 | stack=[3*] | vars{"크기":1}
#2 push L3 push(7): 맨 위에 올렸어요. 지금 크기 2
    명령=<push 3 push 7* pop push 5 pop pop> cur=1 done=1 | stack=[3,7*] | vars{"크기":2}
#3 pop L4 pop(): 맨 위 값 7 꺼내기 — 가장 나중에 넣은 값이 먼저 나와요
    명령=<push 3 push 7 pop* push 5 pop pop> cur=2 done=2 | stack=[3] | vars{"크기":1,"꺼낸 값":7}
#4 push L3 push(5): 맨 위에 올렸어요. 지금 크기 2
    명령=<push 3 push 7 pop push 5* pop pop> cur=3 done=3 | stack=[3,5*] | vars{"크기":2}
#5 pop L4 pop(): 맨 위 값 5 꺼내기 — 가장 나중에 넣은 값이 먼저 나와요
    명령=<push 3 push 7 pop push 5 pop* pop> cur=4 done=4 | stack=[3] | vars{"크기":1,"꺼낸 값":5}
#6 pop L4 pop(): 맨 위 값 3 꺼내기 — 가장 나중에 넣은 값이 먼저 나와요
    명령=<push 3 push 7 pop push 5 pop pop*> cur=5 done=5 | stack=[] | vars{"크기":0,"꺼낸 값":3}
#7 done L- 명령을 모두 처리했어요. 남은 값 (아래 → 위): []
    명령=<push 3 push 7 pop push 5 pop pop> cur=- done=6 | stack=[] | vars{"크기":0}"
`;

exports[`프리셋 deque-basic-intro > 스텝 흐름 스냅샷 1`] = `
"#0 init L1 빈 덱에서 시작해요. 앞과 뒤 양쪽에서 모두 넣고 뺄 수 있어요.
    명령=<push_back 1 push_back 2 push_front 0 pop_back push_front 9 pop_front pop_front> cur=- done=0 | deque=[] | vars{"크기":0}
#1 push-back L3 push_back(1): 맨 뒤에 넣었어요
    명령=<push_back 1* push_back 2 push_front 0 pop_back push_front 9 pop_front pop_front> cur=0 done=0 | deque=[1*] | vars{"크기":1}
#2 push-back L3 push_back(2): 맨 뒤에 넣었어요
    명령=<push_back 1 push_back 2* push_front 0 pop_back push_front 9 pop_front pop_front> cur=1 done=1 | deque=[1,2*] | vars{"크기":2}
#3 push-front L3 push_front(0): 맨 앞에 넣었어요
    명령=<push_back 1 push_back 2 push_front 0* pop_back push_front 9 pop_front pop_front> cur=2 done=2 | deque=[0*,1,2] | vars{"크기":3}
#4 pop-back L4 pop_back(): 맨 뒤 값 2 꺼내기
    명령=<push_back 1 push_back 2 push_front 0 pop_back* push_front 9 pop_front pop_front> cur=3 done=3 | deque=[0,1] | vars{"크기":2,"꺼낸 값":2}
#5 push-front L3 push_front(9): 맨 앞에 넣었어요
    명령=<push_back 1 push_back 2 push_front 0 pop_back push_front 9* pop_front pop_front> cur=4 done=4 | deque=[9*,0,1] | vars{"크기":3}
#6 pop-front L4 pop_front(): 맨 앞 값 9 꺼내기
    명령=<push_back 1 push_back 2 push_front 0 pop_back push_front 9 pop_front* pop_front> cur=5 done=5 | deque=[0,1] | vars{"크기":2,"꺼낸 값":9}
#7 pop-front L4 pop_front(): 맨 앞 값 0 꺼내기
    명령=<push_back 1 push_back 2 push_front 0 pop_back push_front 9 pop_front pop_front*> cur=6 done=6 | deque=[1] | vars{"크기":1,"꺼낸 값":0}
#8 done L- 명령을 모두 처리했어요. 남은 값 (앞 → 뒤): [1]
    명령=<push_back 1 push_back 2 push_front 0 pop_back push_front 9 pop_front pop_front> cur=- done=7 | deque=[1] | vars{"크기":1}"
`;

exports[`프리셋 echo-valley-stack > 스텝 흐름 스냅샷 1`] = `
"#0 call L1 factorial(4) 호출 — 호출 스택에 새 칸이 쌓여요
    calls[factorial(4)*{"n":4}] | vars{"호출 깊이":1}
#1 call L3 4 × factorial(3) 계산에는 먼저 factorial(3) 값이 필요해요 → 재귀 호출
    calls[factorial(4)*{"n":4}] | vars{"호출 깊이":1}
#2 call L1 factorial(3) 호출 — 호출 스택에 새 칸이 쌓여요
    calls[factorial(4){"n":4} > factorial(3)*{"n":3}] | vars{"호출 깊이":2}
#3 call L3 3 × factorial(2) 계산에는 먼저 factorial(2) 값이 필요해요 → 재귀 호출
    calls[factorial(4){"n":4} > factorial(3)*{"n":3}] | vars{"호출 깊이":2}
#4 call L1 factorial(2) 호출 — 호출 스택에 새 칸이 쌓여요
    calls[factorial(4){"n":4} > factorial(3){"n":3} > factorial(2)*{"n":2}] | vars{"호출 깊이":3}
#5 call L3 2 × factorial(1) 계산에는 먼저 factorial(1) 값이 필요해요 → 재귀 호출
    calls[factorial(4){"n":4} > factorial(3){"n":3} > factorial(2)*{"n":2}] | vars{"호출 깊이":3}
#6 call L1 factorial(1) 호출 — 호출 스택에 새 칸이 쌓여요
    calls[factorial(4){"n":4} > factorial(3){"n":3} > factorial(2){"n":2} > factorial(1)*{"n":1}] | vars{"호출 깊이":4}
#7 return L2 n = 1 → 종료 조건! 더 부르지 않고 1을 돌려줘요
    calls[factorial(4){"n":4} > factorial(3){"n":3} > factorial(2){"n":2} > factorial(1)*{"n":1,"결과":1}] | vars{"호출 깊이":4}
#8 return-to L3 factorial(1) = 1 값이 돌아왔어요 → 2 × 1 = 2
    calls[factorial(4){"n":4} > factorial(3){"n":3} > factorial(2)*{"n":2,"결과":2}] | vars{"호출 깊이":3}
#9 return L3 factorial(2)의 계산이 끝났어요. 결과 2 반환, 칸이 사라져요
    calls[factorial(4){"n":4} > factorial(3){"n":3} > factorial(2)*{"n":2,"결과":2}] | vars{"호출 깊이":3}
#10 return-to L3 factorial(2) = 2 값이 돌아왔어요 → 3 × 2 = 6
    calls[factorial(4){"n":4} > factorial(3)*{"n":3,"결과":6}] | vars{"호출 깊이":2}
#11 return L3 factorial(3)의 계산이 끝났어요. 결과 6 반환, 칸이 사라져요
    calls[factorial(4){"n":4} > factorial(3)*{"n":3,"결과":6}] | vars{"호출 깊이":2}
#12 return-to L3 factorial(3) = 6 값이 돌아왔어요 → 4 × 6 = 24
    calls[factorial(4)*{"n":4,"결과":24}] | vars{"호출 깊이":1}
#13 return L3 factorial(4)의 계산이 끝났어요. 결과 24 반환, 칸이 사라져요
    calls[factorial(4)*{"n":4,"결과":24}] | vars{"호출 깊이":1}
#14 done L- factorial(4) = 24. 호출은 4칸까지 쌓였다가 거꾸로 풀렸어요.
    calls[] | vars{"결과":24}"
`;

