    들어오는 수=<5 1* 9 3 7 2 8> cur=1 done=1 | graph{1*(맨 위) 5?} edges{h0-h1~} | vars{"K":3,"지금 3번째로 큰 수":"(아직 모자라요)"}
#4 push L3 9 넣기: 맨 끝 칸(2번)에 둬요
    들어오는 수=<5 1 9* 3 7 2 8> cur=2 done=2 | graph{1.(맨 위) 5. 9*} | vars{"K":3,"지금 3번째로 큰 수":1}
#5 compare L3 부모 1 ≤ 9 → 제자리예요
    들어오는 수=<5 1 9* 3 7 2 8> cur=2 done=2 | graph{1✓(맨 위) 5. 9*} edges{h0-h2~} | vars{"K":3,"지금 3번째로 큰 수":1}
#6 compare L4 3 > 맨 위 1 → 큰 수 3개 안에 들어와요
    들어오는 수=<5 1 9 3* 7 2 8> cur=3 done=3 | graph{1?(맨 위) 5. 9.} | vars{"K":3,"지금 3번째로 큰 수":1}
#7 pop L5 맨 위(가장 작은 값) 1 꺼내기
    들어오는 수=<5 1 9 3* 7 2 8> cur=3 done=3 | graph{1*(맨 위) 5. 9.} | vars{"K":3,"지금 3번째로 큰 수":1}
#8 swap L5 맨 끝 값(9)을 맨 위로 올려요
    들어오는 수=<5 1 9 3* 7 2 8> cur=3 done=3 | graph{9*(맨 위) 5.} | vars{"K":3,"지금 3번째로 큰 수":"(아직 모자라요)"}
#9 swap L5 더 작은 자식과 자리 바꾸기 (0번 ↔ 1번)
    들어오는 수=<5 1 9 3* 7 2 8> cur=3 done=3 | graph{5?(맨 위) 9*} edges{h0-h1~} | vars{"K":3,"지금 3번째로 큰 수":"(아직 모자라요)"}
#10 compare L5 자식들보다 작거나 같아요 → 제자리
    들어오는 수=<5 1 9 3* 7 2 8> cur=3 done=3 | graph{5.(맨 위) 9✓} | vars{"K":3,"지금 3번째로 큰 수":"(아직 모자라요)"}
#11 push L5 3 넣기: 맨 끝 칸(2번)에 둬요
    들어오는 수=<5 1 9 3* 7 2 8> cur=3 done=3 | graph{5.(맨 위) 9. 3*} | vars{"K":3,"지금 3번째로 큰 수":5}
#12 swap L5 부모보다 작아요 → 위로 한 칸 (2번 ↔ 0번)
    들어오는 수=<5 1 9 3* 7 2 8> cur=3 done=3 | graph{3*(맨 위) 9. 5?} edges{h0-h2~} | vars{"K":3,"지금 3번째로 큰 수":3}
#13 compare L4 7 > 맨 위 3 → 큰 수 3개 안에 들어와요
    들어오는 수=<5 1 9 3 7* 2 8> cur=4 done=4 | graph{3?(맨 위) 9. 5.} | vars{"K":3,"지금 3번째로 큰 수":3}
#14 pop L5 맨 위(가장 작은 값) 3 꺼내기
    들어오는 수=<5 1 9 3 7* 2 8> cur=4 done=4 | graph{3*(맨 위) 9. 5.} | vars{"K":3,"지금 3번째로 큰 수":3}
#15 swap L5 맨 끝 값(5)을 맨 위로 올려요
    들어오는 수=<5 1 9 3 7* 2 8> cur=4 done=4 | graph{5*(맨 위) 9.} | vars{"K":3,"지금 3번째로 큰 수":"(아직 모자라요)"}
#16 compare L5 자식들보다 작거나 같아요 → 제자리
    들어오는 수=<5 1 9 3 7* 2 8> cur=4 done=4 | graph{5✓(맨 위) 9.} | vars{"K":3,"지금 3번째로 큰 수":"(아직 모자라요)"}
#17 push L5 7 넣기: 맨 끝 칸(2번)에 둬요
    들어오는 수=<5 1 9 3 7* 2 8> cur=4 done=4 | graph{5.(맨 위) 9. 7*} | vars{"K":3,"지금 3번째로 큰 수":5}
#18 compare L5 부모 5 ≤ 7 → 제자리예요
    들어오는 수=<5 1 9 3 7* 2 8> cur=4 done=4 | graph{5✓(맨 위) 9. 7*} edges{h0-h2~} | vars{"K":3,"지금 3번째로 큰 수":5}
#19 skip L4 2 ≤ 맨 위 5 → 큰 수 3개에 못 들어가요
    들어오는 수=<5 1 9 3 7 2* 8> cur=5 done=5 | graph{5✓(맨 위) 9. 7.} | vars{"K":3,"지금 3번째로 큰 수":5}
#20 compare L4 8 > 맨 위 5 → 큰 수 3개 안에 들어와요
    들어오는 수=<5 1 9 3 7 2 8*> cur=6 done=6 | graph{5?(맨 위) 9. 7.} | vars{"K":3,"지금 3번째로 큰 수":5}
#21 pop L5 맨 위(가장 작은 값) 5 꺼내기
    들어오는 수=<5 1 9 3 7 2 8*> cur=6 done=6 | graph{5*(맨 위) 9. 7.} | vars{"K":3,"지금 3번째로 큰 수":5}
#22 swap L5 맨 끝 값(7)을 맨 위로 올려요
    들어오는 수=<5 1 9 3 7 2 8*> cur=6 done=6 | graph{7*(맨 위) 9.} | vars{"K":3,"지금 3번째로 큰 수":"(아직 모자라요)"}
#23 compare L5 자식들보다 작거나 같아요 → 제자리
    들어오는 수=<5 1 9 3 7 2 8*> cur=6 done=6 | graph{7✓(맨 위) 9.} | vars{"K":3,"지금 3번째로 큰 수":"(아직 모자라요)"}
#24 push L5 8 넣기: 맨 끝 칸(2번)에 둬요
    들어오는 수=<5 1 9 3 7 2 8*> cur=6 done=6 | graph{7.(맨 위) 9. 8*} | vars{"K":3,"지금 3번째로 큰 수":7}
#25 compare L5 부모 7 ≤ 8 → 제자리예요
    들어오는 수=<5 1 9 3 7 2 8*> cur=6 done=6 | graph{7✓(맨 위) 9. 8*} edges{h0-h2~} | vars{"K":3,"지금 3번째로 큰 수":7}
#26 done L6 맨 위 값(7)이 3번째로 큰 수예요. 힙에는 늘 3개만 있어서 빨라요.
    들어오는 수=<5 1 9 3 7 2 8> cur=- done=0 | graph{7✓(맨 위) 9. 8.} | vars{"K":3,"지금 3번째로 큰 수":7}"
`;

exports[`프리셋 island-bridges-ex1 > 스텝 흐름 스냅샷 1`] = `
"#0 init L1 노드 3개, 간선 2개. 노드마다 이웃을 적을 빈 리스트를 준비해요.
    graph{0. 1. 2.} | vars{"graph[0]":[],"graph[1]":[],"graph[2]":[]}
#1 discover L3 간선 (0, 1): graph[0]에 1 추가
    graph{0? 1? 2.} edges{0-1~} | vars{"graph[0]":[1],"graph[1]":[],"graph[2]":[]}
#2 discover L4 반대 방향도 이어져 있으니 graph[1]에 0 추가
    graph{0? 1? 2.} edges{0-1~} | vars{"graph[0]":[1],"graph[1]":[0],"graph[2]":[]}
#3 discover L3 간선 (0, 2): graph[0]에 2 추가
    graph{0? 1✓ 2?} edges{0-1= 0-2~} | vars{"graph[0]":[1,2],"graph[1]":[0],"graph[2]":[]}
#4 discover L4 반대 방향도 이어져 있으니 graph[2]에 0 추가
    graph{0? 1✓ 2?} edges{0-1= 0-2~} | vars{"graph[0]":[1,2],"graph[1]":[0],"graph[2]":[0]}
#5 done L- 인접 리스트 완성! 이제 graph[v]만 보면 v의 이웃을 바로 찾을 수 있어요.
    graph{0✓ 1✓ 2✓} edges{0-1= 0-2=} | vars{"graph[0]":[1,2],"graph[1]":[0],"graph[2]":[0]}"
`;

exports[`프리셋 maze-ex1 > 스텝 흐름 스냅샷 1`] = `
"#0 init L1 출발점 (0, 0)의 거리는 0. 큐에 넣고 출발해요.
    queue=[(0, 0)] | grid zone=100/000/000 cur=0,0 dist=0,-,-/-,-,-/-,-,- | vars{"큐 길이":1}
#1 dequeue L3 큐 맨 앞의 (0, 0) 칸을 꺼내요 (거리 0)
    queue=[] | grid zone=100/000/000 cur=0,0 dist=0,-,-/-,-,-/-,-,- | vars{"큐 길이":0}
#2 discover L8 아래 (1, 0) 칸을 처음 발견! 거리 1, 큐 뒤에 넣어요
    queue=[(1, 0)] | grid zone=100/100/000 cur=0,0 chk=1,0:go dist=0,-,-/1,-,-/-,-,- | vars{"큐 길이":1}
#3 discover L8 오른쪽 (0, 1) 칸을 처음 발견! 거리 1, 큐 뒤에 넣어요
    queue=[(1, 0),(0, 1)] | grid zone=110/100/000 cur=0,0 chk=0,1:go dist=0,1,-/1,-,-/-,-,- | vars{"큐 길이":2}
#4 dequeue L3 큐 맨 앞의 (1, 0) 칸을 꺼내요 (거리 1)
    queue=[(0, 1)] | grid zone=110/100/000 cur=1,0 dist=0,1,-/1,-,-/-,-,- | vars{"큐 길이":1}
#5 check L6 위 (0, 0) 칸은 이미 발견했어요 → 건너뛰기
    queue=[(0, 1)] | grid zone=110/100/000 cur=1,0 chk=0,0:visited dist=0,1,-/1,-,-/-,-,- | vars{"큐 길이":1}
#6 check L6 아래 (2, 0) 칸은 벽 → 건너뛰기
    queue=[(0, 1)] | grid zone=110/100/000 cur=1,0 chk=2,0:blocked dist=0,1,-/1,-,-/-,-,- | vars{"큐 길이":1}
#7 discover L8 오른쪽 (1, 1) 칸을 처음 발견! 거리 2, 큐 뒤에 넣어요
    queue=[(0, 1),(1, 1)] | grid zone=110/110/000 cur=1,0 chk=1,1:go dist=0,1,-/1,2,-/-,-,- | vars{"큐 길이":2}
#8 dequeue L3 큐 맨 앞의 (0, 1) 칸을 꺼내요 (거리 1)
    queue=[(1, 1)] | grid zone=110/110/000 cur=0,1 dist=0,1,-/1,2,-/-,-,- | vars{"큐 길이":1}
#9 check L6 아래 (1, 1) 칸은 이미 발견했어요 → 건너뛰기
    queue=[(1, 1)] | grid zone=110/110/000 cur=0,1 chk=1,1:visited dist=0,1,-/1,2,-/-,-,- | vars{"큐 길이":1}
#10 check L6 왼쪽 (0, 0) 칸은 이미 발견했어요 → 건너뛰기
    queue=[(1, 1)] | grid zone=110/110/000 cur=0,1 chk=0,0:visited dist=0,1,-/1,2,-/-,-,- | vars{"큐 길이":1}
#11 check L6 오른쪽 (0, 2) 칸은 벽 → 건너뛰기
    queue=[(1, 1)] | grid zone=110/110/000 cur=0,1 chk=0,2:blocked dist=0,1,-/1,2,-/-,-,- | vars{"큐 길이":1}
#12 dequeue L3 큐 맨 앞의 (1, 1) 칸을 꺼내요 (거리 2)
    queue=[] | grid zone=110/110/000 cur=1,1 dist=0,1,-/1,2,-/-,-,- | vars{"큐 길이":0}
#13 check L6 위 (0, 1) 칸은 이미 발견했어요 → 건너뛰기
    queue=[] | grid zone=110/110/000 cur=1,1 chk=0,1:visited dist=0,1,-/1,2,-/-,-,- | vars{"큐 길이":0}
#14 discover L8 아래 (2, 1) 칸을 처음 발견! 거리 3, 큐 뒤에 넣어요
    queue=[(2, 1)] | grid zone=110/110/010 cur=1,1 chk=2,1:go dist=0,1,-/1,2,-/-,3,- | vars{"큐 길이":1}
#15 check L6 왼쪽 (1, 0) 칸은 이미 발견했어요 → 건너뛰기
    queue=[(2, 1)] | grid zone=110/110/010 cur=1,1 chk=1,0:visited dist=0,1,-/1,2,-/-,3,- | vars{"큐 길이":1}
#16 check L6 오른쪽 (1, 2) 칸은 벽 → 건너뛰기
    queue=[(2, 1)] | grid zone=110/110/010 cur=1,1 chk=1,2:blocked dist=0,1,-/1,2,-/-,3,- | vars{"큐 길이":1}
#17 dequeue L3 큐 맨 앞의 (2, 1) 칸을 꺼내요 (거리 3)
    queue=[] | grid zone=110/110/010 cur=2,1 dist=0,1,-/1,2,-/-,3,- | vars{"큐 길이":0}
#18 check L6 위 (1, 1) 칸은 이미 발견했어요 → 건너뛰기
    queue=[] | grid zone=110/110/010 cur=2,1 chk=1,1:visited dist=0,1,-/1,2,-/-,3,- | vars{"큐 길이":0}
#19 check L6 왼쪽 (2, 0) 칸은 벽 → 건너뛰기
    queue=[] | grid zone=110/110/010 cur=2,1 chk=2,0:blocked dist=0,1,-/1,2,-/-,3,- | vars{"큐 길이":0}
#20 discover L8 오른쪽 (2, 2) 칸을 처음 발견! 거리 4, 큐 뒤에 넣어요
    queue=[(2, 2)] | grid zone=110/110/011 cur=2,1 chk=2,2:go dist=0,1,-/1,2,-/-,3,4 | vars{"큐 길이":1}
#21 dequeue L3 큐 맨 앞의 (2, 2) 칸을 꺼내요 (거리 4)
    queue=[] | grid zone=110/110/011 cur=2,2 dist=0,1,-/1,2,-/-,3,4 | vars{"큐 길이":0}
#22 done L4 도착! 최단 거리는 4칸이에요. 가까운 칸부터 퍼졌으니 처음 닿은 순간이 가장 짧은 길이에요.
    queue=[] | grid zone=210/220/022 cur=2,2 dist=0,1,-/1,2,-/-,3,4 | vars{"큐 길이":0}"
`;

